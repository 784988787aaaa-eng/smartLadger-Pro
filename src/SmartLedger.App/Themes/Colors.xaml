<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="BrushBackground" Color="#070B19"/>
    <SolidColorBrush x:Key="BrushPanel" Color="#0B132B"/>
    <SolidColorBrush x:Key="BrushSurface" Color="#0F172A"/>
    <SolidColorBrush x:Key="BrushSurface2" Color="#131E3D"/>
    <SolidColorBrush x:Key="BrushLine" Color="#263A5A"/>
    <SolidColorBrush x:Key="BrushText" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="BrushMuted" Color="#93A4C3"/>
    <SolidColorBrush x:Key="BrushAccent" Color="#00B4D8"/>
    <SolidColorBrush x:Key="BrushAccent2" Color="#00D2D3"/>
    <SolidColorBrush x:Key="BrushPositive" Color="#10B981"/>
    <SolidColorBrush x:Key="BrushNegative" Color="#EF4444"/>
    <SolidColorBrush x:Key="BrushWarning" Color="#FFD166"/>
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#087BFF" Offset="0"/><GradientStop Color="#00D2D3" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFFFFF" Offset="0"/><GradientStop Color="#00B4D8" Offset="1"/>
    </LinearGradientBrush>
</ResourceDictionary>

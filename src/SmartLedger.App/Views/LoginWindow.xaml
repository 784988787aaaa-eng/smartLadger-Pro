<Window x:Class="SmartLedger.App.Views.LoginWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SmartLedger — Sign In" Width="1120" Height="700" MinWidth="980" MinHeight="620" WindowStyle="None" WindowStartupLocation="CenterScreen" Background="#070B19" FlowDirection="RightToLeft" Language="ar-SA" UseLayoutRounding="True" SnapsToDevicePixels="True" ResizeMode="CanResize">
  <Window.Resources>
    <Geometry x:Key="UserIcon">M12,13 A5,5 0 1 0 12,3 A5,5 0 0 0 12,13 M3,23 C3,16 21,16 21,23</Geometry>
    <Geometry x:Key="EyeIcon">M2,12 C6,5 18,5 22,12 C18,19 6,19 2,12 Z M12,15 A3,3 0 1 0 12,9 A3,3 0 0 0 12,15</Geometry>
    <Geometry x:Key="ShieldIcon">M12,2 L21,6 L21,12 C21,18 17,21 12,23 C7,21 3,18 3,12 L3,6 Z M8,12 L11,15 L17,9</Geometry>

    <Geometry x:Key="CloseIcon">M6,6 L18,18 M18,6 L6,18</Geometry>
    <Geometry x:Key="ChartIcon">M3,19 L8,14 L12,17 L20,7 M16,7 L20,7 L20,11</Geometry>
    <Geometry x:Key="BoxIcon">M4,7 L12,3 L20,7 L12,11 Z M4,7 L4,17 L12,21 L12,11 M20,7 L20,17 L12,21</Geometry>
    <Geometry x:Key="ReportIcon">M4,3 L20,3 L20,21 L4,21 Z M8,8 L16,8 M8,12 L16,12 M8,16 L13,16</Geometry>
    <Style x:Key="RememberMeCheckBox" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
      <Setter Property="FontFamily" Value="{StaticResource ArabicFont}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Height="32" MinWidth="112">
              <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft" VerticalAlignment="Center">
                <Border x:Name="Box" Width="20" Height="20" CornerRadius="6" BorderBrush="#466385" BorderThickness="1.2" Background="#0B1427" VerticalAlignment="Center">
                  <Path x:Name="Check" Data="M4,10 L8,14 L16,6" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                </Border>
                <ContentPresenter ContentSource="Content" VerticalAlignment="Center" Margin="9,0,0,0"/>
              </StackPanel>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{StaticResource BrushAccent}"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BrushAccent2}"/>
                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BrushAccent2}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BrushAccent2}"/>
                <Setter TargetName="Box" Property="BorderThickness" Value="1.8"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Border Margin="14" CornerRadius="18" Background="#070B19" BorderBrush="#315B8D" BorderThickness="1" Padding="1">
    <Grid FlowDirection="LeftToRight">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="480"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" CornerRadius="16,0,0,16" Padding="48" FlowDirection="RightToLeft">
        <Border.Background><RadialGradientBrush Center="0.5,0.42" RadiusX="0.85" RadiusY="0.95"><GradientStop Color="#12315A" Offset="0"/><GradientStop Color="#0B132B" Offset="0.55"/><GradientStop Color="#070B19" Offset="1"/></RadialGradientBrush></Border.Background>
        <Grid><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="520">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Border Width="70" Height="70" CornerRadius="20" Background="#102C52" BorderBrush="#287AC1" BorderThickness="1"><Viewbox Margin="12"><Path Stroke="{StaticResource BrushAccent2}" StrokeThickness="2" Data="{StaticResource BrandMarkIcon}"/></Viewbox></Border><TextBlock Text="SmartLedger" FontSize="46" FontWeight="Bold" VerticalAlignment="Center" Margin="17,0,0,0" Foreground="{StaticResource BrandGradient}"/></StackPanel>
          <TextBlock Text="دفتر أعمالك، في مكان واحد" FontSize="24" HorizontalAlignment="Center" Margin="0,15,0,34" Foreground="#E4EEFC"/>
          <StackPanel Width="410">
            <StackPanel Orientation="Horizontal" Margin="0,9"><Border Width="38" Height="38" CornerRadius="11" Background="#0F315A"><Viewbox Margin="8"><Path Stroke="#55B7FF" StrokeThickness="1.9" Data="M3,18 L8,13 L12,17 L21,7 M17,7 L21,7 L21,11"/></Viewbox></Border><TextBlock Text="إدارة الحسابات والدفاتر" FontSize="16" VerticalAlignment="Center" Margin="15,0,0,0"/></StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,9"><Border Width="38" Height="38" CornerRadius="11" Background="#0F315A"><Viewbox Margin="8"><Path Stroke="#55B7FF" StrokeThickness="1.8" Data="M3,4 L21,4 L21,18 L3,18 Z M7,22 L17,22"/></Viewbox></Border><TextBlock Text="المبيعات والمشتريات والفواتير" FontSize="16" VerticalAlignment="Center" Margin="15,0,0,0"/></StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,9"><Border Width="38" Height="38" CornerRadius="11" Background="#0F315A"><Viewbox Margin="8"><Path Stroke="#55B7FF" StrokeThickness="1.8" Data="{StaticResource BoxIcon}"/></Viewbox></Border><TextBlock Text="المخزون والوحدات" FontSize="16" VerticalAlignment="Center" Margin="15,0,0,0"/></StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,9"><Border Width="38" Height="38" CornerRadius="11" Background="#0F315A"><Viewbox Margin="8"><Path Stroke="#55B7FF" StrokeThickness="1.8" Data="{StaticResource ReportIcon}"/></Viewbox></Border><TextBlock Text="التقارير والنسخ الاحتياطي" FontSize="16" VerticalAlignment="Center" Margin="15,0,0,0"/></StackPanel>
          </StackPanel>
          <TextBlock Text="إدارة واضحة، وقرارات أسرع" Foreground="#7E95B9" FontSize="12" Margin="0,48,0,0" HorizontalAlignment="Center"/><Border Height="2" Width="58" Background="{StaticResource AccentGradient}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
        </StackPanel></Grid>
      </Border>
      <Border Grid.Column="1" Margin="14,0,0,0" CornerRadius="0,16,16,0" Background="#0F172A" Padding="48" FlowDirection="RightToLeft">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid Grid.Row="0" FlowDirection="LeftToRight" Margin="0,0,0,4">
            <TextBlock Text="" Foreground="{StaticResource BrushMuted}" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="6,0,0,0"/>
            <Button Click="Close_Click" IsCancel="True" HorizontalAlignment="Right" VerticalAlignment="Top" Width="42" Height="36" Margin="0,0,0,0" Style="{StaticResource IconButton}" ToolTip="إغلاق البرنامج" AutomationProperties.Name="إغلاق البرنامج"><Path Width="14" Height="14" Stretch="Uniform" Stroke="#9DB7D4" StrokeThickness="1.6" Data="{StaticResource CloseIcon}"/></Button>
          </Grid>
          <StackPanel Grid.Row="1" VerticalAlignment="Center" MaxWidth="400">
            <Border Width="62" Height="62" CornerRadius="18" Background="#102B50" BorderBrush="#2A72B7" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,15"><Viewbox Margin="13"><Path Stroke="{StaticResource BrushAccent2}" StrokeThickness="2" Data="{StaticResource BrandMarkIcon}"/></Viewbox></Border>
            <TextBlock Text="تسجيل الدخول" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="أدخل بياناتك للمتابعة" Foreground="{StaticResource BrushMuted}" HorizontalAlignment="Center" Margin="0,5,0,28"/>
            <TextBlock Text="اسم المستخدم" Style="{StaticResource SectionLabel}"/><Grid Margin="0,0,0,15"><TextBox x:Name="UserNameBox" Style="{StaticResource Field}" Text="{Binding UserName,UpdateSourceTrigger=PropertyChanged}" Padding="14,7,46,7" AutomationProperties.Name="اسم المستخدم"/><Viewbox Width="18" Height="18" Margin="0,0,14,0" HorizontalAlignment="Right"><Path Stroke="#7D96BA" StrokeThickness="1.7" Data="{StaticResource UserIcon}"/></Viewbox></Grid>
            <TextBlock Text="كلمة المرور" Style="{StaticResource SectionLabel}"/><Grid Margin="0,0,0,5"><PasswordBox x:Name="PasswordBox" Style="{StaticResource PasswordField}" PasswordChanged="PasswordChanged" Padding="14,7,44,7"/><TextBox x:Name="VisiblePasswordBox" Style="{StaticResource Field}" Text="{Binding Password,UpdateSourceTrigger=PropertyChanged}" Visibility="Collapsed" Padding="14,7,44,7"/><Button x:Name="EyeButton" Click="TogglePassword_Click" Background="Transparent" BorderThickness="0" Width="40" Height="40" HorizontalAlignment="Left" Padding="0" ToolTip="إظهار أو إخفاء كلمة المرور" AutomationProperties.Name="إظهار أو إخفاء كلمة المرور"><Viewbox Width="18" Height="18"><Path Stroke="#7D96BA" StrokeThickness="1.6" Data="{StaticResource EyeIcon}"/></Viewbox></Button><Viewbox Width="18" Height="18" Margin="0,0,14,0" HorizontalAlignment="Right"><Path Stroke="#7D96BA" StrokeThickness="1.5" Data="{StaticResource ShieldIcon}"/></Viewbox></Grid>
            <Grid Margin="0,0,0,8" Height="32" FlowDirection="RightToLeft">
              <CheckBox x:Name="RememberMeCheckBox" Content="تذكرني على هذا الجهاز" Style="{StaticResource RememberMeCheckBox}" IsChecked="{Binding RememberMe,Mode=TwoWay}" HorizontalAlignment="Right" Click="RememberMe_Click" ToolTip="حفظ بيانات الدخول بشكل مشفّر على هذا الجهاز" AutomationProperties.Name="تذكرني على هذا الجهاز"/>
              <Button Content="نسيت كلمة المرور؟" Click="ForgotPassword_Click" Background="Transparent" BorderThickness="0" Foreground="{StaticResource BrushAccent}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Left" Padding="4,3" ToolTip="استعادة كلمة المرور باستخدام عبارة الاسترداد" AutomationProperties.Name="نسيت كلمة المرور"/>
            </Grid>
            <TextBlock Text="{Binding Error}" Foreground="{StaticResource BrushNegative}" TextWrapping="Wrap" Margin="0,4,0,10"/>
            <Button Content="دخول" Command="{Binding LoginCommand}" IsDefault="True" Style="{StaticResource PrimaryButton}" Height="50" FontSize="17" Margin="0,0,0,22" AutomationProperties.Name="تسجيل الدخول" AutomationProperties.AutomationId="LoginSubmitButton"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Viewbox Width="14" Height="14" Margin="0,0,7,0"><Path Stroke="#7185A8" StrokeThickness="1.5" Data="{StaticResource ShieldIcon}"/></Viewbox><TextBlock Text="محمي بتشفير آمن • بياناتك محلية" Foreground="#7185A8" FontSize="11"/></StackPanel>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>

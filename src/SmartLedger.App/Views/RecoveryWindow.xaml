<Window x:Class="SmartLedger.App.Views.RecoveryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SmartLedger — Account Recovery" Width="520" Height="620" MinWidth="480" MinHeight="560" WindowStyle="None" WindowStartupLocation="CenterScreen" Background="#070B19" FlowDirection="RightToLeft" Language="ar-SA" UseLayoutRounding="True" SnapsToDevicePixels="True" ResizeMode="CanResize">
  <Window.Resources><BooleanToVisibilityConverter x:Key="BoolToVisibility"/><Geometry x:Key="ShieldIcon">M12,2 L21,6 L21,12 C21,18 17,21 12,23 C7,21 3,18 3,12 L3,6 Z M8,12 L11,15 L17,9</Geometry></Window.Resources>
  <Border Margin="14" CornerRadius="20" Background="#0F172A" BorderBrush="#315B8D" BorderThickness="1" Padding="32">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Grid.Row="0" FlowDirection="LeftToRight" Margin="0,0,0,18"><TextBlock Text="" Foreground="{StaticResource BrushMuted}" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Left"/><Button Click="Close_Click" IsCancel="True" HorizontalAlignment="Right" Width="42" Height="36" Style="{StaticResource IconButton}" ToolTip="إغلاق" AutomationProperties.Name="إغلاق"><Path Width="14" Height="14" Stretch="Uniform" Stroke="#9DB7D4" StrokeThickness="1.6" Data="{StaticResource CloseIcon}"/></Button></Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,0,6,0">
        <Border Width="58" Height="58" CornerRadius="17" Background="#102B50" BorderBrush="#2A72B7" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,14"><Viewbox Margin="12"><Path Stroke="{StaticResource BrushAccent2}" StrokeThickness="2" Data="{StaticResource BrandMarkIcon}"/></Viewbox></Border>
        <TextBlock Text="استعادة كلمة المرور" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
        <TextBlock Text="استخدم عبارة الاسترداد التي أنشأتها عند تهيئة الحساب." Foreground="{StaticResource BrushMuted}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,22"/>
        <TextBlock Text="اسم المستخدم" Style="{StaticResource SectionLabel}"/><TextBox AutomationProperties.Name="اسم المستخدم" Style="{StaticResource Field}" Text="{Binding UserName,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
        <Button Content="متابعة الاسترداد" Command="{Binding BeginRecoveryCommand}" Style="{StaticResource GhostButton}" Height="44" Margin="0,0,0,16" IsDefault="True"/>
        <StackPanel Visibility="{Binding RecoveryVerified,Converter={StaticResource BoolToVisibility}}">
          <Border Background="#0A1428" BorderBrush="#1F3452" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,14"><StackPanel><TextBlock Text="تلميح الاسترداد" Style="{StaticResource SectionLabel}"/><TextBlock Text="{Binding RecoveryHint}" Foreground="{StaticResource BrushText}" TextWrapping="Wrap"/></StackPanel></Border>
          <TextBlock Text="عبارة الاسترداد" Style="{StaticResource SectionLabel}"/><PasswordBox x:Name="RecoveryPhraseBox" AutomationProperties.Name="عبارة الاسترداد" Style="{StaticResource PasswordField}" PasswordChanged="RecoveryPhraseChanged" Margin="0,0,0,12"/>
          <TextBlock Text="كلمة المرور الجديدة" Style="{StaticResource SectionLabel}"/><PasswordBox x:Name="NewPasswordBox" AutomationProperties.Name="كلمة المرور الجديدة" Style="{StaticResource PasswordField}" PasswordChanged="NewPasswordChanged" Margin="0,0,0,12"/>
          <TextBlock Text="تأكيد كلمة المرور" Style="{StaticResource SectionLabel}"/><PasswordBox x:Name="ConfirmationBox" AutomationProperties.Name="تأكيد كلمة المرور" Style="{StaticResource PasswordField}" PasswordChanged="ConfirmationChanged" Margin="0,0,0,14"/>
          <Button Content="حفظ كلمة المرور الجديدة" Command="{Binding ResetPasswordCommand}" Style="{StaticResource PrimaryButton}" Height="44"/>
        </StackPanel>
        <TextBlock Text="{Binding Error}" Foreground="{StaticResource BrushNegative}" TextWrapping="Wrap" Margin="0,12,0,0"/>
        <TextBlock Text="{Binding Success}" Foreground="{StaticResource BrushPositive}" TextWrapping="Wrap" Margin="0,8,0,0"/>
      </StackPanel>
      </ScrollViewer>
      <Button Grid.Row="2" Content="العودة إلى تسجيل الدخول" Command="{Binding BackToLoginCommand}" Style="{StaticResource GhostButton}" Height="42" Margin="0,16,0,0"/>
    </Grid>
  </Border>
</Window>

            <Button Content="حذف" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}" Width="76" Margin="8,0,0,0" IsEnabled="{Binding CanManage}"/>
          </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8" ClipToBounds="True">
        <DataGrid FlowDirection="RightToLeft" ItemsSource="{Binding Users}" SelectedItem="{Binding Selected}" IsReadOnly="True"
                  AutoGenerateColumns="False" RowHeight="54" MinRowHeight="54"
                  HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                  HeadersVisibility="Column" CanUserAddRows="False" CanUserResizeRows="False"
                  SelectionUnit="FullRow" ScrollViewer.VerticalScrollBarVisibility="Auto">
          <DataGrid.Columns>
            <DataGridTextColumn Header="المستخدم" Binding="{Binding UserName}" Width="1.15*" MinWidth="150" ElementStyle="{StaticResource TableTextCell}"/>
            <DataGridTextColumn Header="الاسم" Binding="{Binding DisplayName}" Width="1.45*" MinWidth="180" ElementStyle="{StaticResource TableTextCell}"/>
            <DataGridTemplateColumn Header="الدور" Width="105" MinWidth="90">
              <DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="#172B46" BorderBrush="#2A4568" BorderThickness="1" CornerRadius="10" Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="مستخدم" TextAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="#C8D9EE"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="مستخدم"/><Style.Triggers><DataTrigger Binding="{Binding IsAdministrator}" Value="True"><Setter Property="Text" Value="مدير"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border></DataTemplate></DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="الحالة" Width="100" MinWidth="90">
              <DataGridTemplateColumn.CellTemplate><DataTemplate><Border CornerRadius="10" Padding="9,4" HorizontalAlignment="Center" VerticalAlignment="Center"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#332F3948"/><Setter Property="BorderBrush" Value="#526477"/><Setter Property="BorderThickness" Value="1"/><Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Background" Value="#2030A878"/><Setter Property="BorderBrush" Value="#5060C99A"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="متوقف" FontSize="12" Foreground="#FCA5A5" HorizontalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="متوقف"/><Setter Property="Foreground" Value="#FCA5A5"/><Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Text" Value="نشط"/><Setter Property="Foreground" Value="#6EE7B7"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border></DataTemplate></DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="الإجراءات" Width="250" MinWidth="250" MaxWidth="250" IsReadOnly="True">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="RightToLeft">
                    <Button Content="تعديل" Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" CommandParameter="{Binding}" ToolTip="تعديل بيانات المستخدم" Style="{StaticResource GhostButton}" Height="32" MinWidth="62" Padding="8,0" Margin="0,0,0,0" VerticalAlignment="Center"/>
                    <Button Content="تعطيل" ToolTip="تعطيل هذا المستخدم" Height="32" MinWidth="68" Padding="7,0" Margin="6,0,0,0" VerticalAlignment="Center">
                      <Button.Style><Style TargetType="Button" BasedOn="{StaticResource GhostButton}"><Setter Property="Content" Value="تعطيل"/><Setter Property="Height" Value="32"/><Setter Property="MinWidth" Value="68"/><Setter Property="Padding" Value="7,0"/><Setter Property="Margin" Value="6,0,0,0"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Command" Value="{Binding DataContext.ToggleActiveCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"/><Setter Property="CommandParameter" Value="{Binding}"/><Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="False"><Setter Property="Content" Value="تفعيل"/></DataTrigger></Style.Triggers></Style></Button.Style>
                    </Button>
                    <Button Content="حذف" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" CommandParameter="{Binding}" ToolTip="حذف المستخدم" Style="{StaticResource DangerButton}" Height="32" MinWidth="54" Padding="8,0" Margin="6,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Border>
      <TextBlock Grid.Row="2" Text="{Binding StatusText}" Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center" Margin="4,10,4,0" TextAlignment="Right"/>
      <Grid Style="{StaticResource DialogOverlay}" Visibility="{Binding IsDialogOpen,Converter={StaticResource BoolToVisibility}}">
        <Border Width="720" MaxWidth="900" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource DialogShell}" Padding="22">
          <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="720">
          <Grid behaviors:InputDialogBehavior.IsEnabled="True" FlowDirection="RightToLeft">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,16" FlowDirection="RightToLeft"><StackPanel><TextBlock Text="بيانات المستخدم" FontSize="22" FontWeight="SemiBold" TextAlignment="Right"/><TextBlock Text="بيانات الحساب والدور وصلاحيات الوصول." Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextAlignment="Right"/></StackPanel><Button Command="{Binding CancelCommand}" Style="{StaticResource IconButton}" DockPanel.Dock="Left" ToolTip="إغلاق" AutomationProperties.Name="إغلاق"><Path Width="14" Height="14" Stretch="Uniform" Stroke="#9DB7D4" StrokeThickness="1.6" Data="{StaticResource CloseIcon}"/></Button></DockPanel>
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Margin="5"><TextBlock Text="اسم المستخدم" Style="{StaticResource SectionLabel}" TextAlignment="Right"/><TextBox Style="{StaticResource Field}" FlowDirection="LeftToRight" TextAlignment="Left" Text="{Binding UserName,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
              <StackPanel Grid.Column="1" Margin="5"><TextBlock Text="الاسم الكامل" Style="{StaticResource SectionLabel}" TextAlignment="Right"/><TextBox Style="{StaticResource Field}" TextAlignment="Right" FlowDirection="RightToLeft" Text="{Binding DisplayName,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
              <CheckBox Grid.Column="2" Content="مدير النظام" IsChecked="{Binding IsAdministrator}" VerticalAlignment="Center" Margin="14,18,8,0" IsEnabled="{Binding CanManage}"/>
            </Grid></Border>
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel Margin="5"><TextBlock Text="كلمة المرور الجديدة (اختيارية عند التعديل)" Style="{StaticResource SectionLabel}" TextAlignment="Right"/><PasswordBox Style="{StaticResource PasswordField}" behaviors:PasswordBoxBehavior.Password="{Binding Password,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
              <StackPanel Grid.Column="1" Margin="5"><TextBlock Text="تأكيد كلمة المرور" Style="{StaticResource SectionLabel}" TextAlignment="Right"/><PasswordBox Style="{StaticResource PasswordField}" behaviors:PasswordBoxBehavior.Password="{Binding ConfirmPassword,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
            </Grid></Border>
            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12"><StackPanel><TextBlock Text="صلاحيات العمل" FontSize="15" FontWeight="SemiBold" TextAlignment="Right" Margin="0,0,0,10"/><UniformGrid Columns="4" FlowDirection="RightToLeft">
              <CheckBox Content="عرض البيانات" IsChecked="{Binding AllowView}" Margin="6"/>
              <CheckBox Content="إنشاء السجلات" IsChecked="{Binding AllowCreate}" Margin="6"/>
              <CheckBox Content="تعديل السجلات" IsChecked="{Binding AllowEdit}" Margin="6"/>
              <CheckBox Content="حذف السجلات" IsChecked="{Binding AllowDelete}" Margin="6"/>
              <CheckBox Content="التقارير" IsChecked="{Binding AllowReports}" Margin="6"/>
            </UniformGrid></StackPanel></Border>
            <Border Grid.Row="4" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12"><StackPanel><TextBlock Text="إدارة النظام (للمدير فقط)" FontSize="15" FontWeight="SemiBold" TextAlignment="Right" Margin="0,0,0,10"/><UniformGrid Columns="3" FlowDirection="RightToLeft">
              <CheckBox Content="إدارة المستخدمين" IsChecked="{Binding AllowUsers}" Margin="6" IsEnabled="{Binding CanManage}"/>
              <CheckBox Content="الإعدادات" IsChecked="{Binding AllowSettings}" Margin="6" IsEnabled="{Binding CanManage}"/>
              <CheckBox Content="النسخ الاحتياطي" IsChecked="{Binding AllowBackup}" Margin="6" IsEnabled="{Binding CanManage}"/>
            </UniformGrid></StackPanel></Border>
            <TextBlock Grid.Row="5" Text="{Binding StatusText}" Foreground="#FCA5A5" TextAlignment="Right" TextWrapping="Wrap" Margin="4,0,4,8"/>
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Left" Margin="4,4,4,0"><Button Content="حفظ المستخدم" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Width="140"/><Button Content="إلغاء" Command="{Binding CancelCommand}" Style="{StaticResource GhostButton}" Width="100" Margin="8,0,0,0"/></StackPanel>
          </Grid>
          </ScrollViewer>
        </Border>
      </Grid>
    </Grid>
  </DataTemplate>
  <DataTemplate DataType="{x:Type vm:AuditLogViewModel}">
    <Grid FlowDirection="RightToLeft"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Style="{StaticResource ElevatedCard}" Padding="16" Margin="0,0,0,14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Margin="2,0,2,12"><TextBlock Text="سجل التدقيق" FontSize="23" FontWeight="Bold" Foreground="{StaticResource BrushText}" TextAlignment="Right"/><TextBlock Text="مراجعة أنشطة المستخدمين والتغييرات المسجلة في النظام" Style="{StaticResource CaptionText}" TextAlignment="Right" Margin="0,4,0,0"/></StackPanel><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><StackPanel Margin="4"><TextBlock Text="من تاريخ" Style="{StaticResource SectionLabel}"/><DatePicker SelectedDate="{Binding FromDate}" Height="40"/></StackPanel><StackPanel Grid.Column="1" Margin="4"><TextBlock Text="إلى تاريخ" Style="{StaticResource SectionLabel}"/><DatePicker SelectedDate="{Binding ToDate}" Height="40"/></StackPanel><StackPanel Grid.Column="2" Margin="4"><TextBlock Text="بحث في المستخدم أو العملية أو التفاصيل" Style="{StaticResource SectionLabel}"/><TextBox Style="{StaticResource Field}" Text="{Binding TextFilter,UpdateSourceTrigger=PropertyChanged}" ToolTip="يمكن البحث بالقيمة العربية أو الأصلية المسجلة"/></StackPanel><Button Grid.Column="3" Content="بحث" Command="{Binding SearchCommand}" Style="{StaticResource PrimaryButton}" Margin="8,23,4,0" Height="40"/></Grid></Grid></Border>
      <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6"><DataGrid FlowDirection="RightToLeft" ItemsSource="{Binding Entries}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" RowHeight="44" MinRowHeight="44" GridLinesVisibility="Horizontal" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><DataGrid.Columns><DataGridTextColumn Header="التاريخ والوقت" Binding="{Binding OccurredAt,Converter={StaticResource AuditDisplayConverter},ConverterParameter=Date}" Width="190" MinWidth="185" ElementStyle="{StaticResource TableTextCell}"/><DataGridTextColumn Header="المستخدم" Binding="{Binding UserName}" Width="1.1*" MinWidth="120" ElementStyle="{StaticResource TableTextCell}"/><DataGridTextColumn Header="العملية" Binding="{Binding Action,Converter={StaticResource AuditDisplayConverter},ConverterParameter=Action}" Width="1.15*" MinWidth="125" ElementStyle="{StaticResource TableTextCell}"/><DataGridTextColumn Header="الكيان" Binding="{Binding EntityType,Converter={StaticResource AuditDisplayConverter},ConverterParameter=Entity}" Width="0.9*" MinWidth="95" ElementStyle="{StaticResource TableTextCell}"/><DataGridTextColumn Header="المعرّف" Binding="{Binding EntityId}" Width="155" MinWidth="110" ElementStyle="{StaticResource TableTextCell}"/><DataGridTextColumn Header="التفاصيل" Binding="{Binding Details,Converter={StaticResource AuditDisplayConverter},ConverterParameter=Details}" Width="2.2*" MinWidth="200" ElementStyle="{StaticResource TableTextCell}"/></DataGrid.Columns></DataGrid></Border><TextBlock Grid.Row="2" Text="{Binding StatusText}" Foreground="{StaticResource BrushMuted}" TextWrapping="Wrap" Margin="4,10,4,0" TextAlignment="Right"/>
    </Grid>
  </DataTemplate>
  <DataTemplate DataType="{x:Type vm:RecycleBinViewModel}">
    <Grid FlowDirection="RightToLeft">
<Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Style="{StaticResource Card}" Padding="8"><DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="النوع" Binding="{Binding EntityTypeLabel}" Width="160"/><DataGridTextColumn Header="العنصر" Binding="{Binding EntityId}" Width="1.2*" ElementStyle="{StaticResource TableTextCell}"/><DataGridTextColumn Header="تاريخ الحذف" Binding="{Binding DeletedAt,Converter={StaticResource ArabicDateTimeConverter}}" Width="180" ElementStyle="{StaticResource TableTextCell}"/><DataGridTextColumn Header="بواسطة" Binding="{Binding DeletedBy}" Width="180" ElementStyle="{StaticResource TableTextCell}"/></DataGrid.Columns></DataGrid></Border>
      <Grid Grid.Row="1" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding StatusText}" Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,14,0"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="استعادة العنصر" Command="{Binding RestoreCommand}" Style="{StaticResource PrimaryButton}" Width="135" Margin="0,0,8,0"/><Button Content="حذف نهائي" Command="{Binding HardDeleteCommand}" Style="{StaticResource DangerButton}" Width="120"/></StackPanel></Grid>
    </Grid>
  </DataTemplate>
  <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FlowDirection="RightToLeft">
      <StackPanel Margin="2,0,2,18">
        <Grid Margin="0,0,0,14">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel HorizontalAlignment="Left" FlowDirection="RightToLeft">
            <TextBlock Text="مركز الإعدادات" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushText}" TextAlignment="Left" HorizontalAlignment="Stretch"/>
            <TextBlock Text="إدارة هوية المنشأة والنسخ الاحتياطي من مكان واحد" Style="{StaticResource CaptionText}" Margin="0,5,0,0" TextAlignment="Left" HorizontalAlignment="Stretch"/>
          </StackPanel>
          <Button Grid.Column="1" Content="حفظ الإعدادات" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Padding="22,0" MinWidth="150" Height="42" VerticalAlignment="Center"/>
        </Grid>
        <Border Style="{StaticResource ElevatedCard}" Padding="20" Margin="0,0,0,14">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Grid.ColumnSpan="3" Margin="2,0,0,16" HorizontalAlignment="Stretch" FlowDirection="RightToLeft">
              <TextBlock Text="هوية المنشأة" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource BrushText}" TextAlignment="Left" HorizontalAlignment="Stretch"/>
              <TextBlock Text="تُحفظ هذه البيانات في قاعدة التطبيق وتُستخدم في مخرجات التقارير عند إنشائها." Style="{StaticResource CaptionText}" Margin="0,5,0,0" TextWrapping="Wrap" TextAlignment="Left" HorizontalAlignment="Stretch"/>
            </StackPanel>
            <Grid Grid.Row="1">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
              <StackPanel Margin="3,0,8,12">
                <TextBlock Text="اسم المنشأة *" Style="{StaticResource SectionLabel}" Margin="0,0,0,5" TextAlignment="Left" HorizontalAlignment="Left"/>
                <TextBox Style="{StaticResource Field}" Text="{Binding BusinessName,UpdateSourceTrigger=PropertyChanged}" TextAlignment="Left" FlowDirection="RightToLeft" MaxLength="120" AutomationProperties.Name="اسم المنشأة"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="8,0,8,12">
                <TextBlock Text="رقم الهاتف" Style="{StaticResource SectionLabel}" Margin="0,0,0,5" TextAlignment="Left" HorizontalAlignment="Left"/>
                <TextBox Style="{StaticResource Field}" Text="{Binding Phone,UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" MaxLength="40" AutomationProperties.Name="رقم الهاتف"/>
              </StackPanel>
              <StackPanel Grid.Column="2" Margin="8,0,3,12">
                <TextBlock Text="العملة الافتراضية *" Style="{StaticResource SectionLabel}" Margin="0,0,0,5" TextAlignment="Left" HorizontalAlignment="Left"/>
                <TextBox Style="{StaticResource Field}" Text="{Binding Currency,UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" MaxLength="12" AutomationProperties.Name="العملة الافتراضية"/>
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="3,2,8,0">
                <TextBlock Text="العنوان" Style="{StaticResource SectionLabel}" Margin="0,0,0,5" TextAlignment="Left" HorizontalAlignment="Left"/>
                <TextBox Style="{StaticResource Field}" Text="{Binding Address,UpdateSourceTrigger=PropertyChanged}" TextAlignment="Left" FlowDirection="RightToLeft" MaxLength="250" AutomationProperties.Name="عنوان المنشأة"/>
              </StackPanel>
            </Grid>
            <Border Grid.Row="2" Margin="3,14,3,0" Padding="12" Background="#0A1428" BorderBrush="{StaticResource BrushLine}" BorderThickness="1" CornerRadius="9">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="64" Height="64" Background="#13243B" CornerRadius="8" Margin="0,0,12,0">
                  <Image Source="{Binding LogoPreview}" Stretch="Uniform" Margin="4" Visibility="{Binding ShowLogo,Converter={StaticResource BoolToVisibility}}"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="شعار المنشأة (اختياري)" FontWeight="SemiBold" Foreground="{StaticResource BrushText}" TextAlignment="Left" HorizontalAlignment="Stretch"/>
                  <TextBlock Text="PNG أو JPG أو BMP — حتى 5 ميغابايت. يلزم حفظ الإعدادات لاعتماد التغيير." Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,8,0" TextAlignment="Left" HorizontalAlignment="Stretch"/>
                </StackPanel>
                <Button Grid.Column="2" Content="اختيار شعار" Command="{Binding ChooseLogoCommand}" Style="{StaticResource GhostButton}" MinWidth="105" Margin="5,0"/>
                <Button Grid.Column="3" Content="إزالة" Command="{Binding RemoveLogoCommand}" Style="{StaticResource GhostButton}" MinWidth="70" Margin="5,0"/>
              </Grid>
            </Border>
          </Grid>
        </Border>
        <Border Style="{StaticResource ElevatedCard}" Padding="20" Margin="0,0,0,14">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Margin="2,0,12,0" HorizontalAlignment="Left" FlowDirection="RightToLeft">
              <TextBlock Text="النسخ الاحتياطي والاستعادة" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource BrushText}" TextAlignment="Left" HorizontalAlignment="Stretch"/>
              <TextBlock Text="تخضع العمليات لصلاحية النسخ الاحتياطي. الاستعادة تتطلب تأكيدًا قبل استبدال بيانات العمل." Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,5,0,0" TextAlignment="Left" HorizontalAlignment="Stretch"/>
              <TextBlock Text="{Binding LastBackupText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,8,0,0" TextAlignment="Left" HorizontalAlignment="Stretch"/>
            </StackPanel>
            <Button Grid.Column="1" Content="إنشاء نسخة احتياطية" Command="{Binding CreateBackupCommand}" Style="{StaticResource PrimaryButton}" MinWidth="155" Margin="5,0" VerticalAlignment="Center"/>
            <Button Grid.Column="2" Content="استعادة نسخة" Command="{Binding RestoreBackupCommand}" Style="{StaticResource GhostButton}" MinWidth="125" Margin="5,0" VerticalAlignment="Center"/>
          </Grid>
        </Border>
        <Border Style="{StaticResource ElevatedCard}" Padding="20" Margin="0,0,0,14" BorderBrush="#7F1D1D" BorderThickness="1">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Margin="2,0,18,0" HorizontalAlignment="Left" FlowDirection="RightToLeft">
              <TextBlock Text="تهيئة بيانات التطبيق" FontSize="18" FontWeight="Bold" Foreground="#FCA5A5" TextAlignment="Left" HorizontalAlignment="Stretch"/>
              <TextBlock Text="تحذف هذه العملية جميع بيانات العمل والمستخدمين والجلسات وسجلات التدقيق والعناصر المحذوفة، وتعيد التطبيق إلى حالة الإعداد الأولي. لا يمكن التراجع عن العملية بعد تنفيذها." Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,7,0,0" TextAlignment="Left" HorizontalAlignment="Stretch"/>
              <TextBlock Text="تتطلب كلمة مرور المسؤول، وكتابة عبارة التأكيد، وإنشاء نسخة احتياطية كاملة والتحقق منها قبل أي حذف." Style="{StaticResource CaptionText}" TextWrapping="Wrap" Foreground="#FCA5A5" Margin="0,7,0,0" TextAlignment="Left" HorizontalAlignment="Stretch"/>
            </StackPanel>
            <Button Grid.Column="1" Content="تهيئة جميع البيانات" Command="{Binding ResetDataCommand}" Visibility="{Binding CanResetData,Converter={StaticResource BoolToVisibility}}" Height="46" MinWidth="180" Padding="18,0" Background="#991B1B" BorderBrush="#EF4444" BorderThickness="1" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
          </Grid>
        </Border>        <Border Background="#0A1428" BorderBrush="{StaticResource BrushLine}" BorderThickness="1" CornerRadius="9" Padding="13">
          <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource BrushText}" TextWrapping="Wrap" TextAlignment="Left" HorizontalAlignment="Stretch" AutomationProperties.LiveSetting="Polite"/>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>
</ResourceDictionary>
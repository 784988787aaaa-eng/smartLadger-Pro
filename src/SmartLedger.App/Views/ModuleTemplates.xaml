                      </StackPanel>
                      <Border Grid.Column="1" Background="#102D2B" BorderBrush="#24665D" BorderThickness="1" CornerRadius="9" Padding="14,8" Margin="12,0,0,0">
                        <StackPanel>
                          <TextBlock Text="هامش الربح التقديري" Foreground="#8DDAC8" FontSize="12"/>
                          <TextBlock Text="{Binding ProfitMargin,StringFormat={}{0:0.0}%}" FontSize="20" FontWeight="Bold" Foreground="#65D6B8"/>
                          <TextBlock Text="{Binding ProfitPerUnit,StringFormat={}الربح للوحدة: {0:0.##}}" Foreground="#A8CFC7" FontSize="12"/>
                        </StackPanel>
                      </Border>
                    </Grid>
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="17" Margin="0,0,0,12">
                  <StackPanel>
                    <TextBlock Text="المخزون والتنبيهات" FontSize="16" FontWeight="SemiBold" Margin="2,0,2,12"/>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="1.25*"/></Grid.ColumnDefinitions>
                      <StackPanel Margin="4">
                        <TextBlock Text="الرصيد الافتتاحي" Style="{StaticResource SectionLabel}"/>
                        <TextBox Text="{Binding NewOpeningQuantity,UpdateSourceTrigger=PropertyChanged}">
                          <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource NumericField}"><Setter Property="Visibility" Value="Visible"/><Setter Property="IsEnabled" Value="True"/><Style.Triggers><DataTrigger Binding="{Binding EnableMajorUnit}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></TextBox.Style>
                        </TextBox>
                        <TextBox Text="{Binding NewOpeningLargeQuantity,UpdateSourceTrigger=PropertyChanged}">
                          <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource NumericField}"><Setter Property="Visibility" Value="Collapsed"/><Setter Property="IsEnabled" Value="True"/><Style.Triggers><DataTrigger Binding="{Binding EnableMajorUnit}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></TextBox.Style>
                        </TextBox>
                        <TextBlock Text="{Binding NetOpeningSmallUnits,StringFormat={}الرصيد المكافئ: {0:0.##} وحدة أساسية}" Foreground="{StaticResource BrushAccent2}" Margin="2,5,0,0">
                          <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="الرصيد الحالي محفوظ؛ استخدم حركة مخزون لتعديله." Foreground="{StaticResource BrushMuted}" FontSize="12" TextWrapping="Wrap" Margin="2,5,0,0">
                          <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Margin="4">
                        <TextBlock Text="حد تنبيه انخفاض المخزون" Style="{StaticResource SectionLabel}"/>
                        <TextBox Style="{StaticResource NumericField}" Text="{Binding NewAlert,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="حد تنبيه انخفاض المخزون"/>
                        <TextBlock Text="ينبهك النظام عند انخفاض الكمية إلى هذا الحد." Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="2,4,0,0"/>
                      </StackPanel>
                      <StackPanel Grid.Column="2" Margin="4">
                        <TextBlock Text="ملاحظات إضافية" Style="{StaticResource SectionLabel}"/>
                        <TextBox Style="{StaticResource Field}" Height="70" VerticalContentAlignment="Top" TextWrapping="Wrap" AcceptsReturn="True" Text="{Binding NewNote,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="ملاحظات إضافية"/>
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>

            <!-- Persistent action footer with save state and a fast-entry option. -->
            <Border Grid.Row="2" Background="#0B1326" BorderBrush="#263A5A" BorderThickness="1,1,1,0" CornerRadius="10,10,0,0" Padding="12,12,4,0" Margin="0,12,0,0">
              <Grid FlowDirection="RightToLeft">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="4,0,12,8">
                  <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" MaxWidth="390">
                    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}"><Setter Property="Foreground" Value="{StaticResource BrushMuted}"/><Style.Triggers><DataTrigger Binding="{Binding IsSaving}" Value="True"><Setter Property="Foreground" Value="{StaticResource BrushAccent2}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                  </TextBlock>
                </StackPanel>
                <Button Grid.Column="1" Content="إلغاء" Command="{Binding CloseDialogCommand}" Style="{StaticResource GhostButton}" MinWidth="92" Margin="0,0,8,8">
                  <Button.Style><Style TargetType="Button" BasedOn="{StaticResource GhostButton}"><Style.Triggers><DataTrigger Binding="{Binding IsSaving}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Button.Style>
                </Button>
                <Button Grid.Column="2" Command="{Binding SaveAndAddAnotherCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,8" MinWidth="155">
                  <Button.Content><TextBlock Text="حفظ وإضافة صنف آخر" TextWrapping="NoWrap"/></Button.Content>
                  <Button.Style><Style TargetType="Button" BasedOn="{StaticResource GhostButton}"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding IsSaving}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Button.Style>
                </Button>
                <Button Grid.Column="3" Command="{Binding SaveNewCommand}" Style="{StaticResource PrimaryButton}" MinWidth="145" Margin="0,0,0,8">
                  <Button.Content><TextBlock Text="حفظ الصنف"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="حفظ الصنف"/><Style.Triggers><DataTrigger Binding="{Binding IsSaving}" Value="True"><Setter Property="Text" Value="جارٍ الحفظ…"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Button.Content>
                  <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Style.Triggers><DataTrigger Binding="{Binding IsSaving}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Button.Style>
                </Button>
              </Grid>
            </Border>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </DataTemplate><DataTemplate DataType="{x:Type vm:SalesViewModel}">
    <Grid FlowDirection="RightToLeft">
      <Grid.RowDefinitions><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Grid.Row="0" Style="{StaticResource ElevatedCard}" Padding="24" Margin="0,0,0,4">
        <Grid FlowDirection="RightToLeft">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="لا توجد فواتير بيع بعد" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Text="ابدأ فاتورة جديدة، وسيتم تحديث المخزون ورصيد العميل تلقائيًا عند الحفظ." Style="{StaticResource CaptionText}" TextWrapping="Wrap" MaxWidth="620" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,7,0,16"/>
            <Button Content="إنشاء فاتورة بيع" Command="{Binding OpenNewCommand}" Style="{StaticResource PrimaryButton}" Width="160" Height="44" HorizontalAlignment="Center"/>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Style="{StaticResource DialogOverlay}" Visibility="{Binding IsDialogOpen,Converter={StaticResource BoolToVisibility}}">
        <Border Width="680" MaxHeight="880" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource DialogShell}" Padding="22"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Grid FlowDirection="RightToLeft" KeyboardNavigation.TabNavigation="Local" behaviors:InputDialogBehavior.IsEnabled="True">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,16">
              <Button DockPanel.Dock="Left" Command="{Binding CloseDialogCommand}" Style="{StaticResource IconButton}" ToolTip="إغلاق" AutomationProperties.Name="إغلاق"><Path Width="14" Height="14" Stretch="Uniform" Stroke="#9DB7D4" StrokeThickness="1.6" Data="{StaticResource CloseIcon}"/></Button>
              <StackPanel><TextBlock Text="فاتورة بيع جديدة" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="أدخل بيانات الفاتورة بالترتيب ثم احفظ." Style="{StaticResource CaptionText}"/></StackPanel>
            </DockPanel>
            <Grid Grid.Row="1" Margin="0,0,0,12">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel Margin="4"><TextBlock Text="العميل" Style="{StaticResource SectionLabel}"/><Grid><TextBox x:Name="SaleCustomerSearch" behaviors:InputDialogBehavior.SuggestionKeysEnabled="True" behaviors:InputDialogBehavior.SuggestionPopupName="SaleCustomerSuggestions" behaviors:InputDialogBehavior.SuggestionPopup="{Binding ElementName=SaleCustomerSuggestions}" TabIndex="1" Style="{StaticResource Field}" Text="{Binding CustomerSearch,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="العميل" Height="44"/><Popup x:Name="SaleCustomerSuggestions" behaviors:InputDialogBehavior.RegisterSuggestionPopup="True" Placement="Bottom" PlacementTarget="{Binding ElementName=SaleCustomerSearch}" IsOpen="{Binding IsCustomerSuggestionsOpen,Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True"><Border Width="520" MaxHeight="240" Style="{StaticResource DialogShell}" Padding="5"><ListBox ItemsSource="{Binding People}" SelectedValuePath="PersonId" SelectedValue="{Binding PersonId,Mode=TwoWay}" FlowDirection="RightToLeft"><ListBox.ItemTemplate><DataTemplate><Grid Margin="4,3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding PersonName}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding Person.Phone, StringFormat={}الهاتف: {0}}" Foreground="{StaticResource BrushMuted}" Margin="12,0,0,0"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Border></Popup></Grid><Button Content="+ حساب جديد" Command="{Binding OpenQuickPersonCommand}" Style="{StaticResource GhostButton}" Height="32" Padding="8,2" MinWidth="130" Margin="0,4,0,0" HorizontalAlignment="Right"/></StackPanel>
              <StackPanel Grid.Column="1" Margin="4"><TextBlock Text="الصنف" Style="{StaticResource SectionLabel}"/><Grid><TextBox x:Name="SaleProductSearch" behaviors:InputDialogBehavior.SuggestionKeysEnabled="True" behaviors:InputDialogBehavior.SuggestionPopupName="SaleProductSuggestions" behaviors:InputDialogBehavior.SuggestionPopup="{Binding ElementName=SaleProductSuggestions}" TabIndex="2" Style="{StaticResource Field}" Text="{Binding ProductSearch,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="الصنف" Height="44"/><Popup x:Name="SaleProductSuggestions" behaviors:InputDialogBehavior.RegisterSuggestionPopup="True" Placement="Bottom" PlacementTarget="{Binding ElementName=SaleProductSearch}" IsOpen="{Binding IsProductSuggestionsOpen,Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True"><Border Width="520" MaxHeight="240" Style="{StaticResource DialogShell}" Padding="5"><ListBox ItemsSource="{Binding Products}" SelectedValuePath="Id" SelectedValue="{Binding ProductId,Mode=TwoWay}" FlowDirection="RightToLeft"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,3"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Foreground="{StaticResource BrushMuted}" FontSize="11" Text="{Binding SmallUnit, StringFormat={}الوحدة: {0}}"/><TextBlock Foreground="{StaticResource BrushMuted}" FontSize="11" Text="{Binding StockSmallUnits, StringFormat={}الرصيد: {0}}"/><TextBlock Foreground="{StaticResource BrushMuted}" FontSize="11" Text="{Binding SalePrice, StringFormat={}سعر البيع: {0}}"/><TextBlock Foreground="{StaticResource BrushMuted}" FontSize="11" Text="{Binding PurchasePrice, StringFormat={}شراء مرجعي: {0}}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Border></Popup></Grid><Button Content="+ صنف جديد" Command="{Binding OpenQuickProductCommand}" Style="{StaticResource GhostButton}" Height="32" Padding="8,2" MinWidth="130" Margin="0,4,0,0" HorizontalAlignment="Right"/></StackPanel>
              <StackPanel Grid.Column="2" Margin="4"><TextBlock Text="الكمية *" Style="{StaticResource SectionLabel}"/><TextBox TabIndex="3" Style="{StaticResource NumericField}" Text="{Binding QuantityText,UpdateSourceTrigger=PropertyChanged}" Height="44"/></StackPanel>
              <StackPanel Grid.Column="3" Margin="4"><TextBlock Text="الوحدة" Style="{StaticResource SectionLabel}"/><ComboBox ItemsSource="{Binding QuantityUnits}" SelectedItem="{Binding SelectedQuantityUnit,Mode=TwoWay}" Height="44" TabIndex="4" AutomationProperties.Name="وحدة الكمية"/></StackPanel>
            </Grid>
            <Grid Grid.Row="2" Margin="0,0,0,12">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel Margin="4"><TextBlock Text="السعر *" Style="{StaticResource SectionLabel}"/><TextBox TabIndex="5" Style="{StaticResource NumericField}" Text="{Binding PriceText,UpdateSourceTrigger=PropertyChanged}" Height="44"/></StackPanel>
              <StackPanel Grid.Column="1" Margin="4"><TextBlock Text="المدفوع" Style="{StaticResource SectionLabel}"/><TextBox TabIndex="6" Style="{StaticResource NumericField}" Text="{Binding PaidText,UpdateSourceTrigger=PropertyChanged}" Height="44"/></StackPanel>
              <StackPanel Grid.Column="2" Margin="4"><TextBlock Text="البيان" Style="{StaticResource SectionLabel}"/><TextBox TabIndex="7" Style="{StaticResource Field}" Text="{Binding Note,UpdateSourceTrigger=PropertyChanged}" Height="44"/></StackPanel>
            </Grid>
            <StackPanel Grid.Row="3" Margin="4,0,4,8"><Button Content="إضافة الصنف إلى الفاتورة" Command="{Binding AddLineCommand}" Style="{StaticResource PrimaryButton}" Height="36" HorizontalAlignment="Right"/><DataGrid ItemsSource="{Binding Lines}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Height="118" Margin="0,6,0,0" FlowDirection="RightToLeft" HeadersVisibility="Column"><DataGrid.Columns><DataGridTextColumn Header="الصنف" Binding="{Binding ProductName}" Width="2*"/><DataGridTextColumn Header="الكمية" Binding="{Binding Quantity}" Width="*"/><DataGridTextColumn Header="الوحدة" Binding="{Binding Unit}" Width="*"/><DataGridTextColumn Header="السعر" Binding="{Binding UnitPrice}" Width="*"/><DataGridTextColumn Header="الإجمالي" Binding="{Binding LineTotal}" Width="*"/><DataGridTemplateColumn Header="حذف" Width="60"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="×" Command="{Binding DataContext.RemoveLineCommand,RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource GhostButton}" Padding="5,0"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></StackPanel>

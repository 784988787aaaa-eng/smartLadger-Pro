<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:SmartLedger.App.ViewModels" xmlns:behaviors="clr-namespace:SmartLedger.App.Behaviors" xmlns:local="clr-namespace:SmartLedger.App.Converters" xmlns:core="clr-namespace:SmartLedger.Core.Models;assembly=SmartLedger.Core">
  <local:PrivacyMoneyConverter x:Key="PrivacyMoneyConverter" />
  <local:NetBalanceAmountConverter x:Key="NetBalanceAmountConverter" />
  <local:NetBalanceStatusConverter x:Key="NetBalanceStatusConverter" />
  <local:NetBalanceDirectionConverter x:Key="NetBalanceDirectionConverter" />
  <local:StringEmptyToVisibilityConverter x:Key="StringEmptyToVisibilityConverter" />
  <local:BookSelectionConverter x:Key="BookSelectionConverter" />
  <local:NetBalanceBrushConverter x:Key="NetBalanceBrushConverter" />
  <local:RecentOperationLabelConverter x:Key="RecentOperationLabelConverter" />
  <local:RecentOperationBrushConverter x:Key="RecentOperationBrushConverter" />
  <local:RecentOperationAmountConverter x:Key="RecentOperationAmountConverter" />
  <local:NegativeAmountBrushConverter x:Key="NegativeAmountBrushConverter" />
  <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  <Style x:Key="DarkContextMenu" TargetType="ContextMenu">
    <Setter Property="Background" Value="#0B162C" />
    <Setter Property="BorderBrush" Value="#2A4B72" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>
  <Style x:Key="DarkMenuItem" TargetType="MenuItem">
    <Setter Property="Foreground" Value="#EAF4FF" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="HorizontalContentAlignment" Value="Right" />
    <Style.Triggers>
      <Trigger Property="IsHighlighted" Value="True">
        <Setter Property="Background" Value="#163457" />
        <Setter Property="Foreground" Value="#FFFFFF" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="SegmentedChoice" TargetType="RadioButton">
    <Setter Property="Foreground" Value="#AFC4DE" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Background" Value="#0B162C" />
    <Setter Property="BorderBrush" Value="#263E61" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Height" Value="42" />
    <Setter Property="Margin" Value="2,0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="12,0">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="#3A6088" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsChecked" Value="True">
        <Setter Property="Background" Value="#153457" />
        <Setter Property="BorderBrush" Value="#4D86B5" />
        <Setter Property="Foreground" Value="#EAF4FF" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="OpeningForUsChoice" TargetType="RadioButton" BasedOn="{StaticResource SegmentedChoice}"><Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="#12352C" /><Setter Property="BorderBrush" Value="#10B981" /><Setter Property="Foreground" Value="#D1FAE5" /></Trigger></Style.Triggers></Style>
  <Style x:Key="OpeningAgainstUsChoice" TargetType="RadioButton" BasedOn="{StaticResource SegmentedChoice}"><Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="#3A1B20" /><Setter Property="BorderBrush" Value="#EF4444" /><Setter Property="Foreground" Value="#FEE2E2" /></Trigger></Style.Triggers></Style>
  <Style x:Key="MovementReceiveChoice" TargetType="RadioButton" BasedOn="{StaticResource SegmentedChoice}"><Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="#12352C" /><Setter Property="BorderBrush" Value="#10B981" /><Setter Property="Foreground" Value="#D1FAE5" /></Trigger></Style.Triggers></Style>
  <Style x:Key="MovementSaleChoice" TargetType="RadioButton" BasedOn="{StaticResource SegmentedChoice}"><Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="#103343" /><Setter Property="BorderBrush" Value="#06B6D4" /><Setter Property="Foreground" Value="#CFFAFE" /></Trigger></Style.Triggers></Style>
  <Style x:Key="MovementPaymentChoice" TargetType="RadioButton" BasedOn="{StaticResource SegmentedChoice}"><Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="#3A2818" /><Setter Property="BorderBrush" Value="#F59E0B" /><Setter Property="Foreground" Value="#FEF3C7" /></Trigger></Style.Triggers></Style>
  <Style x:Key="MovementPurchaseChoice" TargetType="RadioButton" BasedOn="{StaticResource SegmentedChoice}"><Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="#122D4A" /><Setter Property="BorderBrush" Value="#3B82F6" /><Setter Property="Foreground" Value="#DBEAFE" /></Trigger></Style.Triggers></Style>
  <local:LatinNumberConverter x:Key="LatinNumberConverter" />
  <local:SerialNumberConverter x:Key="SerialNumberConverter" />
  <local:ArabicDateTimeConverter x:Key="ArabicDateTimeConverter" />
  <local:LedgerDateTimeConverter x:Key="LedgerDateTimeConverter" />
  <local:AuditDisplayConverter x:Key="AuditDisplayConverter" />
  <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
    
  
  
      
  
  
  
  
  
  
</ResourceDictionary>
                      <Border Grid.Row="0" Grid.Column="2" Background="#0B1326" Padding="11,9" CornerRadius="8,0,0,0"><TextBlock Text="سعر البيع" Foreground="{StaticResource BrushMuted}" FontWeight="SemiBold"/></Border>
                      <Border Grid.Row="1" Grid.Column="0" Background="#101D34" Padding="11,10" Margin="0,2,0,0"><TextBlock Text="{Binding NewSmallUnit}" FontWeight="SemiBold" VerticalAlignment="Center"/></Border>
                      <Border Grid.Row="1" Grid.Column="1" Background="#101D34" Padding="7,4" Margin="0,2,0,0"><TextBox Style="{StaticResource NumericField}" Text="{Binding NewPurchasePrice,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="سعر شراء الوحدة الأساسية"/></Border>
                      <Border Grid.Row="1" Grid.Column="2" Background="#101D34" Padding="7,4" Margin="0,2,0,0"><TextBox Style="{StaticResource NumericField}" Text="{Binding NewSalePrice,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="سعر بيع الوحدة الأساسية"/></Border>
                      <Border Grid.Row="2" Grid.Column="0" Background="#101D34" Padding="11,10" Margin="0,2,0,0">
                        <TextBlock Text="{Binding NewLargeUnit}" FontWeight="SemiBold" VerticalAlignment="Center">
                          <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding EnableMajorUnit}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                      </Border>
                      <Border Grid.Row="2" Grid.Column="1" Background="#101D34" Padding="7,4" Margin="0,2,0,0">
                        <TextBox Style="{StaticResource NumericField}" Text="{Binding NewMajorPurchasePrice,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="سعر شراء الوحدة الكبرى">
                          <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource NumericField}"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding EnableMajorUnit}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBox.Style>
                        </TextBox>
                      </Border>
                      <Border Grid.Row="2" Grid.Column="2" Background="#101D34" Padding="7,4" Margin="0,2,0,0">

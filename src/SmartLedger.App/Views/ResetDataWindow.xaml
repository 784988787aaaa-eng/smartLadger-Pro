<Window x:Class="SmartLedger.App.Views.ResetDataWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="تهيئة بيانات التطبيق" Width="760" Height="680" MinWidth="680" MinHeight="620" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" UseLayoutRounding="True" SnapsToDevicePixels="True" Background="#070B19" FlowDirection="RightToLeft" Language="ar-SA" ShowInTaskbar="False">
  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="TextAlignment" Value="Left"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
  </Window.Resources>
  <Border Margin="14" Padding="24" CornerRadius="16" Background="#0F172A" BorderBrush="#EF4444" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Margin="0,0,0,16" HorizontalAlignment="Stretch" FlowDirection="RightToLeft">
        <TextBlock Text="تهيئة بيانات التطبيق" FontSize="24" FontWeight="Bold" Foreground="#F8FAFC" TextAlignment="Left" HorizontalAlignment="Stretch"/>
        <TextBlock Text="إجراء إداري حساس — لا يمكن التراجع عنه بعد التنفيذ." FontSize="13" Foreground="#FCA5A5" Margin="0,6,0,0" TextAlignment="Left" HorizontalAlignment="Stretch"/>
      </StackPanel>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Background="#351820" BorderBrush="#7F1D1D" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="سيتم حذف جميع بيانات العمل والمستخدمين والجلسات وسجلات التدقيق والعناصر المحذوفة، وإعادة إعدادات المنشأة والتفضيلات إلى القيم الافتراضية. ستبقى بنية قاعدة البيانات وملفات البرنامج وآليات الأمان كما هي." Foreground="#FEE2E2" TextWrapping="Wrap" FontSize="13" TextAlignment="Left" HorizontalAlignment="Stretch"/>
              <TextBlock Text="لا يمكن التراجع عن العملية بعد تنفيذها. ستُنشأ نسخة احتياطية كاملة ويُتحقق منها أولًا، ولن يبدأ الحذف إذا فشل التحقق." Foreground="#FCA5A5" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,10,0,0" TextAlignment="Left" HorizontalAlignment="Stretch"/>
            </StackPanel>
          </Border>
          <TextBlock Text="كلمة مرور المسؤول الحالي" Foreground="#E2E8F0" FontWeight="SemiBold" Margin="0,0,0,6" TextAlignment="Left" HorizontalAlignment="Stretch"/>
          <PasswordBox x:Name="AdminPassword" Height="44" Padding="10,6" FontSize="15" Background="#0A1428" Foreground="#F8FAFC" BorderBrush="#64748B" BorderThickness="1" HorizontalContentAlignment="Left" FlowDirection="RightToLeft" AutomationProperties.Name="كلمة مرور المسؤول الحالي"/>
          <Border Background="#102D36" BorderBrush="#22D3EE" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,14,0,0">
            <StackPanel FlowDirection="RightToLeft" HorizontalAlignment="Stretch">
              <TextBlock Text="عبارة التأكيد المطلوبة — اكتبها كما هي تمامًا" Foreground="#CFFAFE" FontWeight="SemiBold" TextAlignment="Left" HorizontalAlignment="Stretch"/>
              <Border Background="#071F2A" BorderBrush="#67E8F9" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,8,0,0">
                <TextBlock Text="تهيئة البيانات" Foreground="#FFFFFF" FontSize="20" FontWeight="Bold" TextAlignment="Center" HorizontalAlignment="Stretch" AutomationProperties.Name="عبارة التأكيد: تهيئة البيانات"/>
              </Border>
            </StackPanel>
          </Border>
          <TextBox x:Name="ConfirmationInput" Height="44" Padding="10,8" FontSize="16" Background="#07131F" Foreground="#FFFFFF" CaretBrush="#FFFFFF" BorderBrush="#22D3EE" BorderThickness="1.5" TextAlignment="Left" FlowDirection="RightToLeft" Margin="0,8,0,0" AutomationProperties.Name="اكتب عبارة التأكيد حرفيًا: تهيئة البيانات"/>
          <Button x:Name="PrepareButton" Content="التحقق من العبارة وإنشاء نسخة احتياطية" Click="Prepare_Click" Height="48" Margin="0,14,0,0" Background="#9A3412" BorderBrush="#FDBA74" BorderThickness="1.5" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" Padding="12,6" HorizontalContentAlignment="Center">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="ButtonChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                  <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonChrome" Property="Background" Value="#C2410C"/></Trigger>
                  <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonChrome" Property="Background" Value="#7C2D12"/></Trigger>
                  <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonChrome" Property="Background" Value="#334155"/><Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#475569"/><Setter Property="Foreground" Value="#CBD5E1"/></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>
          <Border Background="#0A1428" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,0">
            <StackPanel>
              <TextBlock Text="حالة النسخة الاحتياطية" Foreground="#CBD5E1" FontWeight="SemiBold" TextAlignment="Left" HorizontalAlignment="Stretch"/>
              <TextBlock x:Name="BackupStatus" Text="لم تُنشأ نسخة احتياطية بعد." Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,5,0,0" TextAlignment="Left" HorizontalAlignment="Stretch"/>
              <TextBlock x:Name="BackupPathText" Foreground="#7DD3FC" TextWrapping="Wrap" Text="" Margin="0,5,0,0" FlowDirection="LeftToRight" TextAlignment="Left" HorizontalAlignment="Stretch"/>
            </StackPanel>
          </Border>
          <TextBlock x:Name="StatusText" Foreground="#FCA5A5" TextWrapping="Wrap" Margin="0,12,0,0"/>
        </StackPanel>
      </ScrollViewer>
      <Grid Grid.Row="2" Margin="0,16,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Button Content="إلغاء" Click="Cancel_Click" IsCancel="True" Height="44" MinWidth="110" Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#64748B" BorderThickness="1" HorizontalAlignment="Left" Padding="14,6" FontWeight="SemiBold">
          <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="CancelChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CancelChrome" Property="Background" Value="#334155"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
        </Button>
        <Button x:Name="ExecuteButton" Grid.Column="1" Content="تنفيذ التهيئة نهائيًا" Click="Execute_Click" IsDefault="False" Height="48" MinWidth="200" IsEnabled="False" Background="#B91C1C" Foreground="#FFFFFF" BorderBrush="#FCA5A5" BorderThickness="1.5" FontWeight="Bold" FontSize="14" Padding="16,6">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="ExecuteChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ExecuteChrome" Property="Background" Value="#DC2626"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="ExecuteChrome" Property="Background" Value="#7F1D1D"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ExecuteChrome" Property="Background" Value="#263449"/><Setter TargetName="ExecuteChrome" Property="BorderBrush" Value="#475569"/><Setter Property="Foreground" Value="#CBD5E1"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
        </Button>
      </Grid>
    </Grid>
  </Border>
</Window>
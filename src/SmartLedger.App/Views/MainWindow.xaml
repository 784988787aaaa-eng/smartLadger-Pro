                  <Path Width="18" Height="18" Stretch="Uniform" Stroke="#8FB3D8" StrokeThickness="1.5" Data="{StaticResource BellIcon}"/>
                </Button>
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0" MinWidth="18" Height="18" CornerRadius="9" Background="{StaticResource BrushNegative}" BorderBrush="#080F21" BorderThickness="2">
                  <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding NotificationCount}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
                  <TextBlock Text="{Binding NotificationCount,Converter={StaticResource LatinNumberConverter}}" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
                </Border>
              </Grid>
              <Popup Placement="Bottom" PlacementTarget="{Binding ElementName=NotificationButton}" HorizontalOffset="0" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" IsOpen="{Binding IsNotificationsOpen}" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">

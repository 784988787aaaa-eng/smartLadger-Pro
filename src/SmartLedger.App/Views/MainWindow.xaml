                  <Grid FlowDirection="RightToLeft">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="1"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,13" FlowDirection="RightToLeft">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <Border Grid.Column="0" Background="#172B4B" BorderBrush="{StaticResource BrushLine}" BorderThickness="1" CornerRadius="8" Padding="9,5" VerticalAlignment="Top">
                        <TextBlock Text="{Binding NotificationCount,Converter={StaticResource LatinNumberConverter}}" Foreground="{StaticResource BrushAccent2}" FontSize="11" FontWeight="Bold" FlowDirection="LeftToRight" HorizontalAlignment="Center"/>
                      </Border>
                      <StackPanel Grid.Column="1" HorizontalAlignment="Right" FlowDirection="RightToLeft">
                        <TextBlock Text="مركز الإشعارات" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource BrushText}" TextAlignment="Right"/>
                        <TextBlock Text="كل التنبيهات والإشعارات" Foreground="{StaticResource BrushMuted}" FontSize="12" Margin="0,4,0,0" TextAlignment="Right"/>
                      </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Background="{StaticResource BrushLine}" Height="1"/>
                    <ScrollViewer Grid.Row="2" Margin="0,13,0,4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FlowDirection="RightToLeft">
                      <ItemsControl ItemsSource="{Binding Notifications}" HorizontalContentAlignment="Stretch">
                        <ItemsControl.ItemTemplate><DataTemplate>
                          <Border Background="{StaticResource BrushPanel}" BorderBrush="{StaticResource BrushLine}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,8" FlowDirection="RightToLeft">
                            <Grid FlowDirection="RightToLeft">
                              <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                              <Border Grid.Column="0" Background="{StaticResource BrushAccent2}" CornerRadius="2" Margin="0,2,10,2"/>
                              <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource BrushText}" FontSize="13" LineHeight="22" TextAlignment="Right" HorizontalAlignment="Stretch" FlowDirection="RightToLeft"/>
                            </Grid>
                          </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                    <Border Grid.Row="3" Background="#0B162C" CornerRadius="8" Padding="10,8" Margin="0,4,0,0">
                      <TextBlock Text="لا توجد تنبيهات جديدة." Foreground="{StaticResource BrushMuted}" FontSize="12" HorizontalAlignment="Center" Margin="0,8,0,0">
                      <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding NotificationCount}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    </Border>
                  </Grid>
                </Border> </Popup> </StackPanel> <Border x:Name="GlobalSearchSurface" Grid.Column="2" Width="660" MaxWidth="720" Height="50" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#0B162C" BorderBrush="#253D63" BorderThickness="1" CornerRadius="11" Padding="14,0">
              <Grid FlowDirection="RightToLeft">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Path Grid.Column="0" Width="16" Height="16" Stretch="Uniform" Stroke="#5D7699" StrokeThickness="1.8" Data="{StaticResource SearchIcon}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Grid.Column="1" x:Name="GlobalSearchBox" BorderThickness="0" Background="Transparent" Foreground="{StaticResource BrushText}" FontSize="14" VerticalContentAlignment="Center" Text="{Binding GlobalSearch,UpdateSourceTrigger=PropertyChanged}" TextChanged="GlobalSearchBox_TextChanged" KeyDown="GlobalSearchBox_KeyDown"/>
                <TextBlock Grid.Column="1" Text="{Binding PageTitle, StringFormat={}بحث في {0}...}" Foreground="#5D7699" FontSize="13" VerticalAlignment="Center" IsHitTestVisible="False" Margin="2,0,0,0">
                  <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding GlobalSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                <Border Grid.Column="2" Background="#13233F" CornerRadius="5" Padding="6,2" VerticalAlignment="Center">
                  <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding GlobalSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                  <TextBlock Text="Ctrl + K" Foreground="#7E9BC2" FontSize="10" FlowDirection="LeftToRight"/>
                </Border>
              </Grid>
            </Border>
            <Popup Placement="Bottom" PlacementTarget="{Binding ElementName=GlobalSearchSurface}" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" IsOpen="{Binding IsGlobalSearchOpen}" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
              <Border Width="620" MaxHeight="420" Margin="0,8,0,0" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushLine}" BorderThickness="1" CornerRadius="10" Padding="8" FlowDirection="RightToLeft">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl ItemsSource="{Binding GlobalSearchResults}">
                    <ItemsControl.ItemTemplate><DataTemplate>
                      <Button Click="GlobalSearchResult_Click" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" Padding="10" Margin="0,1">
                        <Grid FlowDirection="RightToLeft"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                          <TextBlock Grid.Column="0" Text="{Binding Category}" Foreground="{StaticResource BrushAccent2}" FontSize="11" FontWeight="SemiBold" Margin="0,0,12,0" VerticalAlignment="Top"/>
                          <StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" Foreground="{StaticResource BrushText}" FontSize="13" FontWeight="SemiBold" TextAlignment="Right"/><TextBlock Text="{Binding Detail}" Foreground="{StaticResource BrushMuted}" FontSize="11" Margin="0,3,0,0" TextAlignment="Right" TextTrimming="CharacterEllipsis"/></StackPanel>
                        </Grid>
                      </Button>
                    </DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </Border>
        <Border Grid.Row="1" Background="#070B19" Padding="26">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ContentControl x:Name="CurrentContent" HorizontalContentAlignment="Stretch" Content="{Binding CurrentViewModel}"/></ScrollViewer>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>





            <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppPage.Users}" Background="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ActivePageBackgroundConverter}, ConverterParameter={x:Static vm:AppPage.Users}}"><StackPanel Orientation="Horizontal" FlowDirection="RightToLeft"><Path Style="{StaticResource SideIcon}" Data="{StaticResource UsersPermissionIcon}"/><TextBlock Text="المستخدمون والصلاحيات" Margin="13,0,0,0" VerticalAlignment="Center" Visibility="{Binding SidebarTextVisibility}"/></StackPanel></Button>

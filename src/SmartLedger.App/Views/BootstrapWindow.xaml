<Window x:Class="SmartLedger.App.Views.BootstrapWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="560" Height="690" MinWidth="520" MinHeight="620" WindowStyle="None" WindowStartupLocation="CenterScreen" Background="#070B19" FlowDirection="RightToLeft" Language="ar-SA" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="TextAlignment" Value="Right"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="Foreground" Value="{StaticResource BrushText}"/><Setter Property="FontFamily" Value="{StaticResource ArabicFont}"/></Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource Field}"><Setter Property="TextAlignment" Value="Right"/><Setter Property="HorizontalContentAlignment" Value="Right"/></Style>
    <Style TargetType="PasswordBox" BasedOn="{StaticResource PasswordField}"><Setter Property="HorizontalContentAlignment" Value="Right"/></Style>
    <Geometry x:Key="ShieldIcon">M12,2 L21,6 L21,12 C21,18 17,21 12,23 C7,21 3,18 3,12 L3,6 Z M8,12 L11,15 L17,9</Geometry>

  </Window.Resources>
  <Border Margin="14" CornerRadius="20" Background="#0F172A" BorderBrush="#315B8D" BorderThickness="1" Padding="32">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Grid.Row="0" Margin="0,0,0,24">
        <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft"><Border Width="46" Height="46" CornerRadius="14" Background="#102B50" BorderBrush="#287AC1" BorderThickness="1"><Viewbox Margin="10"><Path Stroke="{StaticResource BrushAccent2}" StrokeThickness="1.7" Data="{StaticResource BrandMarkIcon}"/></Viewbox></Border><StackPanel Margin="12,0,0,0" VerticalAlignment="Center" FlowDirection="RightToLeft"><TextBlock Text="SmartLedger" Foreground="{StaticResource BrushText}" TextAlignment="Right" HorizontalAlignment="Stretch" FontSize="19" FontWeight="Bold"/><TextBlock Text="الإعداد الأول" Style="{StaticResource CaptionText}" TextAlignment="Right" HorizontalAlignment="Stretch"/></StackPanel></StackPanel>
        <TextBlock Text="إعداد حساب المدير" Foreground="{StaticResource BrushText}" FlowDirection="RightToLeft" TextAlignment="Right" HorizontalAlignment="Stretch" Width="380" FontSize="27" FontWeight="SemiBold" Margin="0,22,0,4"/><TextBlock Text="هذه الخطوة تُنفذ مرة واحدة على هذا الجهاز." Style="{StaticResource SubtitleText}" FlowDirection="RightToLeft" TextAlignment="Right" HorizontalAlignment="Stretch" Width="380"/>
      </StackPanel>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel FlowDirection="RightToLeft" HorizontalAlignment="Stretch">
        <TextBlock Text="اسم المستخدم" Style="{StaticResource SectionLabel}" FlowDirection="RightToLeft" TextAlignment="Right" HorizontalAlignment="Stretch" Width="380"/><TextBox Style="{StaticResource Field}" FlowDirection="LeftToRight" TextAlignment="Right" HorizontalContentAlignment="Right" HorizontalAlignment="Stretch" Text="{Binding UserName,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>
        <TextBlock Text="كلمة المرور" Style="{StaticResource SectionLabel}" FlowDirection="RightToLeft" TextAlignment="Right" HorizontalAlignment="Stretch" Width="380"/><PasswordBox x:Name="Pass" Style="{StaticResource PasswordField}" FlowDirection="LeftToRight" HorizontalContentAlignment="Right" HorizontalAlignment="Stretch" PasswordChanged="PassChanged" Margin="0,0,0,14"/>
        <TextBlock Text="تأكيد كلمة المرور" Style="{StaticResource SectionLabel}" FlowDirection="RightToLeft" TextAlignment="Right" HorizontalAlignment="Stretch"/><PasswordBox x:Name="Confirm" Style="{StaticResource PasswordField}" FlowDirection="LeftToRight" HorizontalContentAlignment="Right" HorizontalAlignment="Stretch" PasswordChanged="ConfirmChanged" Margin="0,0,0,14"/>
        <TextBlock Text="عبارة الاسترداد" Style="{StaticResource SectionLabel}" FlowDirection="RightToLeft" TextAlignment="Right" HorizontalAlignment="Stretch"/><TextBox Style="{StaticResource Field}" FlowDirection="LeftToRight" TextAlignment="Right" HorizontalContentAlignment="Right" HorizontalAlignment="Stretch" Text="{Binding RecoveryPhrase,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>
        <TextBlock Text="تلميح الاسترداد" Style="{StaticResource SectionLabel}" FlowDirection="RightToLeft" TextAlignment="Right" HorizontalAlignment="Stretch"/><TextBox Style="{StaticResource Field}" FlowDirection="LeftToRight" TextAlignment="Right" HorizontalContentAlignment="Right" HorizontalAlignment="Stretch" Text="{Binding RecoveryHint,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>
        <Border Background="#0A1428" BorderBrush="#1F3452" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,14"><StackPanel Orientation="Horizontal" FlowDirection="RightToLeft"><Viewbox Width="16" Height="16" Margin="0,0,8,0"><Path Stroke="#6D89AD" StrokeThickness="1.5" Data="{StaticResource ShieldIcon}"/></Viewbox><TextBlock Text="بياناتك محلية ومحمية." Foreground="{StaticResource BrushMuted}" FontSize="11" FlowDirection="RightToLeft" TextAlignment="Right" TextWrapping="Wrap"/></StackPanel></Border>
        <TextBlock Text="{Binding Error}" Foreground="{StaticResource BrushNegative}" TextAlignment="Right" HorizontalAlignment="Stretch" TextWrapping="Wrap" Margin="0,0,0,10"/>
      </StackPanel></ScrollViewer>
      <Button Grid.Row="2" Content="إنشاء الحساب وبدء الاستخدام" Command="{Binding CreateCommand}" Style="{StaticResource PrimaryButton}" Height="50" FontSize="15" Margin="0,14,0,0"/>
    </Grid>
  </Border>
</Window>

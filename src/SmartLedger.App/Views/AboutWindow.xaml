<Window x:Class="SmartLedger.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="عن التطبيق والهوية | About SmartLedger" Width="760" Height="800"
        MinWidth="650" MinHeight="580" WindowStartupLocation="CenterOwner" MaxHeight="900"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize" Background="Transparent" Foreground="#E8F0FC"
        FlowDirection="RightToLeft" FontFamily="Segoe UI">
  <Border Margin="12" BorderBrush="#24456D" BorderThickness="1" CornerRadius="18" Background="#0B1428">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="24">
        <DockPanel Margin="0,0,0,14" LastChildFill="True" FlowDirection="RightToLeft"><Button DockPanel.Dock="Left" Content="✕" Width="38" Height="34" Click="Close_Click" Background="#18283E" Foreground="#E8F0FC" BorderBrush="#314B68" AutomationProperties.Name="إغلاق نافذة عن النظام"/><StackPanel VerticalAlignment="Center"><TextBlock Text="عن النظام" FontSize="20" FontWeight="Bold"/><TextBlock Text="SmartLedger Pro · Enterprise ERP Suite" FontSize="11" Foreground="#93C5FD" FlowDirection="LeftToRight"/></StackPanel></DockPanel>
        <Border Background="#102B50" BorderBrush="#2A72B7" BorderThickness="1" CornerRadius="14" Padding="18">
          <StackPanel>
            <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Left">
              <Viewbox Width="44" Height="44" Margin="0,0,14,0">
                <Grid Width="48" Height="48">
                  <Path Data="M24,3 L44,14 L44,34 L24,45 L4,34 L4,14 Z" Fill="#173D68" Stroke="#60A5FA" StrokeThickness="2"/>
                  <Path Data="M14,17 L34,17 L34,22 L14,22 Z M14,26 L29,26 L29,31 L14,31 Z" Fill="#EAF4FF"/>
                </Grid>
              </Viewbox>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="SmartLedger Pro" FontSize="26" FontWeight="Bold" FlowDirection="LeftToRight"/>
                <TextBlock Text="Enterprise ERP Suite" FontSize="15" Foreground="#93C5FD" FlowDirection="LeftToRight"/>
              </StackPanel>
            </StackPanel>
            <TextBlock Text="Giant Enterprise Software Studio" FontSize="17" FontWeight="SemiBold" Margin="0,18,0,4" FlowDirection="LeftToRight"/>
            <TextBlock Text="Commercial Enterprise Edition (Release 2026) | .NET 10.0 Windows Desktop | SQLite High-Performance Engine | QuestPDF Vector Reporting" TextWrapping="Wrap" Foreground="#B6C7DF" FlowDirection="LeftToRight"/>
            <Border Background="#10B981" CornerRadius="8" Padding="12,8" Margin="0,16,0,0" HorizontalAlignment="Right">
              <TextBlock Text="مرخص تجارياً — نسخة المؤسسات (Enterprise Active License)" Foreground="#03291D" FontWeight="Bold" TextWrapping="Wrap"/>
            </Border>
          </StackPanel>
        </Border>
        <TextBlock Text="تشخيصات النظام ومعلومات النسخة | System Information" FontSize="18" FontWeight="Bold" Margin="0,24,0,12"/>
        <UniformGrid Columns="2">
          <Border Background="#111F36" CornerRadius="10" Padding="14" Margin="0,0,8,8">
            <StackPanel><TextBlock Text="حجم قاعدة البيانات" Foreground="#91A8C6"/><TextBlock x:Name="DatabaseSizeText" Text="جارٍ الفحص..." FontSize="20" FontWeight="Bold" Margin="0,6,0,0"/></StackPanel>
          </Border>
          <Border Background="#111F36" CornerRadius="10" Padding="14" Margin="8,0,0,8">
            <StackPanel><TextBlock Text="إجمالي السجلات" Foreground="#91A8C6"/><TextBlock x:Name="RecordsCountText" Text="جارٍ الفحص..." FontSize="20" FontWeight="Bold" Margin="0,6,0,0"/></StackPanel>
          </Border>
          <Border Background="#111F36" CornerRadius="10" Padding="14" Margin="0,8,8,0">
            <StackPanel><TextBlock Text=".NET Runtime" Foreground="#91A8C6"/><TextBlock x:Name="RuntimeText" Text=".NET" FontSize="20" FontWeight="Bold" Margin="0,6,0,0" FlowDirection="LeftToRight"/></StackPanel>
          </Border>
          <Border Background="#111F36" CornerRadius="10" Padding="14" Margin="8,8,0,0">
            <StackPanel><TextBlock Text="الذاكرة المخصصة" Foreground="#91A8C6"/><TextBlock x:Name="MemoryText" Text="جارٍ الفحص..." FontSize="20" FontWeight="Bold" Margin="0,6,0,0"/></StackPanel>
          </Border>
        </UniformGrid>
        <Border Background="#111F36" CornerRadius="10" Padding="16" Margin="0,18,0,0">
          <StackPanel>
            <TextBlock Text="الدعم والاستفسارات" FontSize="17" FontWeight="Bold"/>
            <TextBlock Text="رقم التواصل والدعم الفني: 774004399" FontSize="16" Margin="0,8,0,0"/>
            <TextBlock Text="للاستفسارات الفنية وخدمات المنتج، يرجى التواصل عبر الرقم أعلاه." TextWrapping="Wrap" Foreground="#B6C7DF" Margin="0,4,0,0"/>
          </StackPanel>
        </Border>
        <Button Content="نسخ معلومات النظام | Copy System Info" Width="310" Height="42" FlowDirection="LeftToRight" HorizontalAlignment="Center" Margin="0,14,0,0" Click="CopySystemInfo_Click" Background="#163457" Foreground="#E8F0FC" BorderBrush="#315B8D"/><TextBlock Text="© 2026 Giant Enterprise Software Studio. All rights reserved." TextAlignment="Center" FlowDirection="LeftToRight" Foreground="#7F96B6" Margin="0,22,0,8" TextWrapping="Wrap"/>
        <Button Content="إغلاق | Close" IsCancel="True" Width="140" Height="40" HorizontalAlignment="Center" Click="Close_Click" Background="#1B4B7C" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
      </StackPanel>
    </ScrollViewer>
  </Border>
</Window>
<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:behaviors="clr-namespace:SmartLedger.App.Behaviors">
  <DataTemplate x:Key="ProductDialogControlTemplate">
    <Grid Style="{StaticResource DialogOverlay}"
          Visibility="{Binding IsDialogOpen, Converter={StaticResource BoolToVisibility}}">
      <Border x:Name="DialogHostContainer"
              Width="1120" MinWidth="620" MaxWidth="1400" MaxHeight="1000"
              Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center"
              Style="{StaticResource ResponsiveDialogHost}" Padding="18">
        <Grid FlowDirection="RightToLeft"
              KeyboardNavigation.TabNavigation="Local"
              behaviors:InputDialogBehavior.IsEnabled="True">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="0,0,0,14" Cursor="SizeAll"
                behaviors:DialogInteractionBehavior.IsDraggable="True">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock FontSize="21" FontWeight="SemiBold">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="بطاقة صنف مخزني جديد"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsEditing}" Value="True">
                        <Setter Property="Text" Value="تعديل بطاقة الصنف"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <TextBlock Text="الهوية والموقع، التسعير والربحية، ثم الأرصدة وحدود إعادة الطلب"
                         Style="{StaticResource CaptionText}" Margin="0,3,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Command="{Binding CloseDialogCommand}"
                    Style="{StaticResource IconButton}" ToolTip="إغلاق البطاقة"
                    AutomationProperties.Name="إغلاق بطاقة الصنف"
                    AutomationProperties.AutomationId="Btn_CloseProductDialog"
                    Width="38" Height="38">
              <Path Width="14" Height="14" Stretch="Uniform" Stroke="#9DB7D4"
                    StrokeThickness="1.6" Data="{StaticResource CloseIcon}"/>
            </Button>
          </Grid>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        CanContentScroll="False" Padding="2">
            <StackPanel>
              <!-- 1. Identity and storage location -->
              <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                  <TextBlock Text="١. الهوية والموقع التخزيني" FontSize="16"
                             FontWeight="SemiBold" Foreground="{StaticResource BrushAccent}"
                             Margin="0,0,0,12"/>
                  <TextBlock Text="{DynamicResource Str_Product_Name}"
                             Style="{StaticResource SectionLabel}"/>
                  <TextBox Style="{StaticResource Field}" FontSize="16" Height="42"
                           Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                           AutomationProperties.AutomationId="ProductNameInput"
                           FlowDirection="RightToLeft" TextAlignment="Right"
                           Margin="0,0,0,10" ToolTip="اسم واضح ومميز للصنف"/>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,6,8">
                      <TextBlock Text="{DynamicResource ColBarcode}" Style="{StaticResource SectionLabel}"/>
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource Field}" Height="38" Margin="0,0,6,0"
                                 Text="{Binding NewBarcode, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.AutomationId="ProductBarcodeInput"
                                 FlowDirection="LeftToRight" TextAlignment="Left"/>
                        <Button Grid.Column="1" Content="توليد" Command="{Binding GenerateBarcodeCommand}"
                                Style="{StaticResource GhostButton}" Padding="12,0" Height="38"
                                ToolTip="توليد باركود داخلي عند عدم توفر باركود مصنع"/>
                      </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="6,0,0,8">
                      <TextBlock Text="{DynamicResource ColCategory}" Style="{StaticResource SectionLabel}"/>
                      <ComboBox IsEditable="True" IsTextSearchEnabled="True"
                                ItemsSource="{Binding Categories}"
                                Text="{Binding NewCategory, UpdateSourceTrigger=PropertyChanged}"
                                FlowDirection="RightToLeft" Height="38"
                                ToolTip="اختر تصنيفًا موجودًا أو اكتب تصنيفًا جديدًا"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,6,0">
                      <TextBlock Text="{DynamicResource Str_Product_Warehouse}" Style="{StaticResource SectionLabel}"/>
                      <ComboBox IsEditable="True" IsTextSearchEnabled="True"
                                ItemsSource="{Binding ProductWarehouses}"
                                Text="{Binding NewWarehouse, UpdateSourceTrigger=PropertyChanged}"
                                Height="38" ToolTip="المخزن الافتراضي لهذا الصنف"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="6,0,0,0">
                      <TextBlock Text="{DynamicResource Str_Product_ShelfLocation}" Style="{StaticResource SectionLabel}"/>
                      <TextBox Style="{StaticResource Field}" Height="38"
                               Text="{Binding NewShelfLocation, UpdateSourceTrigger=PropertyChanged}"
                               ToolTip="رقم الرف أو الممر؛ حقل اختياري"/>
                    </StackPanel>
                  </Grid>
                  <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="{DynamicResource Str_Product_DefaultSupplier}" Style="{StaticResource SectionLabel}"/>
                    <ComboBox ItemsSource="{Binding Suppliers}" DisplayMemberPath="PersonName"
                              SelectedValuePath="PersonId" SelectedValue="{Binding NewSupplierId, Mode=TwoWay}"
                              FlowDirection="RightToLeft" Height="38"/>
                  </StackPanel>
                </StackPanel>
              </Border>

              <!-- 2. Units, pricing, and live financial KPI -->
              <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                  <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="٢. الوحدات والتسعير والربحية" FontSize="16"
                                 FontWeight="SemiBold" Foreground="{StaticResource BrushAccent}"/>
                      <TextBlock Text="تُحدّث مؤشرات الربح تلقائيًا عند تعديل التكلفة أو سعر البيع."
                                 Style="{StaticResource CaptionText}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" Content="{DynamicResource Str_Product_UnitMajorToggle}"
                              IsChecked="{Binding EnableMajorUnit}" VerticalAlignment="Center"
                              FontWeight="SemiBold" ToolTip="تفعيل وحدة كبرى مثل الكرتون أو الصندوق"/>
                  </Grid>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,6,8">
                      <TextBlock Text="{DynamicResource Str_Product_UnitMinor}" Style="{StaticResource SectionLabel}"/>
                      <TextBox Style="{StaticResource Field}" Height="38"
                               Text="{Binding NewSmallUnit, UpdateSourceTrigger=PropertyChanged}"
                               ToolTip="الوحدة الأساسية مثل حبة أو قارورة"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="6,0,6,8">
                      <TextBlock Text="{DynamicResource Str_Product_UnitMajor}" Style="{StaticResource SectionLabel}"/>
                      <TextBox Style="{StaticResource Field}" Height="38"
                               Text="{Binding NewLargeUnit, UpdateSourceTrigger=PropertyChanged}"
                               ToolTip="الوحدة الكبرى مثل كرتون أو صندوق">
                        <TextBox.Style>
                          <Style TargetType="TextBox" BasedOn="{StaticResource Field}">
                            <Setter Property="IsEnabled" Value="False"/>
                            <Style.Triggers><DataTrigger Binding="{Binding EnableMajorUnit}" Value="True"><Setter Property="IsEnabled" Value="True"/></DataTrigger></Style.Triggers>
                          </Style>
                        </TextBox.Style>
                      </TextBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="6,0,0,8">
                      <TextBlock Text="معامل التحويل" Style="{StaticResource SectionLabel}"/>
                      <TextBox Style="{StaticResource NumericField}" Height="38"
                               Text="{Binding NewConversion, UpdateSourceTrigger=PropertyChanged}"
                               ToolTip="عدد الوحدات الأساسية داخل الوحدة الكبرى">
                        <TextBox.Style>
                          <Style TargetType="TextBox" BasedOn="{StaticResource NumericField}">
                            <Setter Property="IsEnabled" Value="False"/>
                            <Style.Triggers><DataTrigger Binding="{Binding EnableMajorUnit}" Value="True"><Setter Property="IsEnabled" Value="True"/></DataTrigger></Style.Triggers>
                          </Style>
                        </TextBox.Style>
                      </TextBox>
                    </StackPanel>
                  </Grid>
                  <Border Background="#0B162C" BorderBrush="{StaticResource BrushLine}" BorderThickness="1"
                          CornerRadius="8" Padding="10" Margin="0,0,0,10">
                    <TextBlock Text="{Binding PackagingSummary}" Foreground="{StaticResource BrushAccent2}"
                               FontWeight="SemiBold" TextAlignment="Center" FlowDirection="RightToLeft"/>
                  </Border>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                      <TextBlock Text="{Binding NewSmallUnit, StringFormat={}{0}: تكلفة الشراء}" Style="{StaticResource SectionLabel}"/>
                      <TextBox Style="{StaticResource NumericField}" Height="40"
                               Text="{Binding NewPurchasePrice, UpdateSourceTrigger=PropertyChanged}"
                               FlowDirection="LeftToRight" TextAlignment="Right"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                      <TextBlock Text="{Binding NewSmallUnit, StringFormat={}سعر البيع / {0}}" Style="{StaticResource SectionLabel}"/>
                      <TextBox Style="{StaticResource NumericField}" Height="40"
                               Text="{Binding NewSalePrice, UpdateSourceTrigger=PropertyChanged}"
                               FlowDirection="LeftToRight" TextAlignment="Right"/>
                    </StackPanel>
                  </Grid>
                  <Grid IsEnabled="{Binding EnableMajorUnit}" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                      <TextBlock Text="{Binding NewLargeUnit, StringFormat={}تكلفة شراء / {0}}" Style="{StaticResource SectionLabel}"/>
                      <TextBox Style="{StaticResource NumericField}" Height="38"
                               Text="{Binding NewMajorPurchasePrice, UpdateSourceTrigger=PropertyChanged}"
                               FlowDirection="LeftToRight" TextAlignment="Right"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                      <TextBlock Text="{Binding NewLargeUnit, StringFormat={}سعر البيع / {0}}" Style="{StaticResource SectionLabel}"/>
                      <TextBox Style="{StaticResource NumericField}" Height="38"
                               Text="{Binding NewMajorSalePrice, UpdateSourceTrigger=PropertyChanged}"
                               FlowDirection="LeftToRight" TextAlignment="Right"/>
                    </StackPanel>
                  </Grid>
                  <Border Background="#131E3D" BorderBrush="#23866B" BorderThickness="1.2"
                          CornerRadius="10" Padding="16" Margin="0,14,0,0">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="هامش الربح" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="{Binding ProfitMargin, StringFormat={}{0:0.0}%}"
                                   FontSize="25" FontWeight="Bold" Foreground="{StaticResource BrushAccent2}"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                        <TextBlock Text="صافي الربح للوحدة" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="{Binding ProfitPerUnit, StringFormat={}{0:N2}}"
                                   FontSize="21" FontWeight="SemiBold" Foreground="#6EE7B7"/>
                      </StackPanel>
                      <StackPanel Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="صافي الربح للعبوة الكبرى" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="{Binding ProfitPerMajor, StringFormat={}{0:N2}}"
                                   FontSize="21" FontWeight="SemiBold" Foreground="#6EE7B7"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <TextBlock Text="تنبيه: سعر البيع أقل من تكلفة الوحدة."
                             Foreground="#F87171" FontWeight="SemiBold" Margin="2,8,0,0"
                             Visibility="{Binding IsSellingBelowCost, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
              </Border>

              <!-- 3. Stock balances and reorder threshold -->
              <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,4">
                <StackPanel>
                  <TextBlock Text="٣. الأرصدة وحدود إعادة الطلب" FontSize="16"
                             FontWeight="SemiBold" Foreground="{StaticResource BrushAccent}"
                             Margin="0,0,0,12"/>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                      <TextBlock Text="الكمية الافتتاحية" Style="{StaticResource SectionLabel}"/>
                      <TextBox Height="40" FlowDirection="LeftToRight" TextAlignment="Right"
                               Text="{Binding NewOpeningQuantity, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.Style>
                          <Style TargetType="TextBox" BasedOn="{StaticResource NumericField}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers><DataTrigger Binding="{Binding EnableMajorUnit}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                          </Style>
                        </TextBox.Style>
                      </TextBox>
                      <TextBox Height="40" FlowDirection="LeftToRight" TextAlignment="Right"
                               Text="{Binding NewOpeningLargeQuantity, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.Style>
                          <Style TargetType="TextBox" BasedOn="{StaticResource NumericField}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers><DataTrigger Binding="{Binding EnableMajorUnit}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                          </Style>
                        </TextBox.Style>
                      </TextBox>
                      <TextBlock Text="{Binding NetOpeningSmallUnits, StringFormat={}الرصيد المعادل: {0:0.##} وحدة أساسية}"
                                 Foreground="{StaticResource BrushAccent2}" Margin="2,6,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                      <TextBlock Text="حد التنبيه وإعادة الطلب" Style="{StaticResource SectionLabel}"/>
                      <TextBox Style="{StaticResource NumericField}" Height="40"
                               Text="{Binding NewAlert, UpdateSourceTrigger=PropertyChanged}"
                               FlowDirection="LeftToRight" TextAlignment="Right"
                               ToolTip="أظهر تنبيه انخفاض المخزون عند بلوغ هذا الحد"/>
                    </StackPanel>
                  </Grid>
                  <TextBlock Text="{DynamicResource Str_Product_Notes}" Style="{StaticResource SectionLabel}" Margin="0,10,0,0"/>
                  <TextBox Style="{StaticResource Field}" Height="64" MinHeight="64"
                           Text="{Binding NewNote, UpdateSourceTrigger=PropertyChanged}"
                           FlowDirection="RightToLeft" TextAlignment="Right"
                           AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                           ToolTip="ملاحظات داخلية اختيارية عن الصنف"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <Grid Grid.Row="2" Margin="0,14,0,0" MinHeight="46">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}"
                       VerticalAlignment="Center" TextWrapping="Wrap" Margin="2,0,12,0"/>
            <Button Grid.Column="1" Content="{DynamicResource Str_Cancel}"
                    Command="{Binding CloseDialogCommand}" Style="{StaticResource GhostButton}"
                    Width="96" Height="42" Margin="0,0,8,0"
                    ToolTip="إلغاء التغييرات وإغلاق البطاقة (Esc)"/>
            <Button Grid.Column="2" Content="حفظ ومتابعة"
                    Command="{Binding SaveAndNewProductCommand}" Style="{StaticResource GhostButton}"
                    Width="142" Height="42" Margin="0,0,8,0"
                    ToolTip="حفظ الصنف وتصفير النموذج للبدء بصنف جديد (Ctrl+Enter)"/>
            <Button Grid.Column="3" Content="حفظ وإغلاق"
                    Command="{Binding SaveAndCloseProductCommand}" Style="{StaticResource PrimaryButton}"
                    Width="140" Height="42"
                    ToolTip="حفظ بطاقة الصنف وإغلاق النافذة (F5)"/>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </DataTemplate>
</ResourceDictionary>
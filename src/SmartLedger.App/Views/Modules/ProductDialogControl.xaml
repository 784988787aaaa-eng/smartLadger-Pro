<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:SmartLedger.App.ViewModels" xmlns:behaviors="clr-namespace:SmartLedger.App.Behaviors" xmlns:local="clr-namespace:SmartLedger.App.Converters" xmlns:core="clr-namespace:SmartLedger.Core.Models;assembly=SmartLedger.Core">
  <DataTemplate x:Key="ProductDialogControlTemplate">
    <Grid Style="{StaticResource DialogOverlay}" Visibility="{Binding IsDialogOpen,Converter={StaticResource BoolToVisibility}}">
      <Border x:Name="DialogHostContainer" Width="880" MinWidth="680" MaxWidth="1400" MinHeight="500" MaxHeight="1000" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource ResponsiveDialogHost}" Padding="16">
        <Grid FlowDirection="RightToLeft" KeyboardNavigation.TabNavigation="Local" behaviors:InputDialogBehavior.IsEnabled="True">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <DockPanel Grid.Row="0" Margin="0,0,0,8" Cursor="SizeAll" behaviors:DialogInteractionBehavior.IsDraggable="True">
            <Button DockPanel.Dock="Left" Command="{Binding CloseDialogCommand}" Style="{StaticResource IconButton}" ToolTip="إغلاق" AutomationProperties.Name="إغلاق" AutomationProperties.AutomationId="Btn_CloseProductDialog" Width="36" Height="36">
              <Path Width="14" Height="14" Stretch="Uniform" Stroke="#9DB7D4" StrokeThickness="1.6" Data="{StaticResource CloseIcon}" />
            </Button>
            <StackPanel Margin="0,0,12,0">
              <TextBlock FontSize="20" FontWeight="SemiBold">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="إضافة صنف جديد" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsEditing}" Value="True">
                        <Setter Property="Text" Value="تعديل بيانات الصنف" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <TextBlock Text="إدخال سريع، وحدات مرنة، ورصيد واضح" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
            </StackPanel>
          </DockPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,4,0" Grid.Column="0">
              <StackPanel>
                <TextBlock Text="{DynamicResource Str_Product_SectionIdentity}" FontSize="15" FontWeight="SemiBold" Margin="2,0,2,10" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="1.2*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="4">
                    <TextBlock Text="{DynamicResource Str_Product_Name}" Style="{StaticResource SectionLabel}" />
                    <TextBox Style="{StaticResource Field}" FontSize="15" Text="{Binding NewName,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="ProductNameInput" FlowDirection="RightToLeft" TextAlignment="Right" Height="36" Margin="0,0,0,6" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="4">
                    <TextBlock Text="{DynamicResource ColBarcode}" Style="{StaticResource SectionLabel}" />
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBox Style="{StaticResource Field}" Text="{Binding NewBarcode,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="ProductBarcodeInput" FlowDirection="LeftToRight" Margin="0,0,4,0" TextAlignment="Left" Height="36" />
                      <Button Grid.Column="1" Content="توليد" Command="{Binding GenerateBarcodeCommand}" Style="{StaticResource GhostButton}" Padding="8,0" Height="36" ToolTip="توليد باركود داخلي عند عدم توفر باركود مصنع" />
                    </Grid>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Margin="4">
                    <TextBlock Text="{DynamicResource ColCategory}" Style="{StaticResource SectionLabel}" />
                    <ComboBox IsEditable="True" IsTextSearchEnabled="True" ItemsSource="{Binding Categories}" Text="{Binding NewCategory,UpdateSourceTrigger=PropertyChanged}" ToolTip="اختر تصنيفًا أو اكتب تصنيفًا جديدًا" FlowDirection="RightToLeft" Height="36" Margin="0,0,0,6" />
                  </StackPanel>
                </Grid>
                <Grid Margin="0,2,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="1.2*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="4">
                    <TextBlock Text="{DynamicResource Str_Product_Warehouse}" Style="{StaticResource SectionLabel}" />
                    <ComboBox IsEditable="True" IsTextSearchEnabled="True" ItemsSource="{Binding ProductWarehouses}" Text="{Binding NewWarehouse,UpdateSourceTrigger=PropertyChanged}" ToolTip="اختر مخزنًا أو اكتب اسمًا جديدًا" Height="36" Margin="0,0,0,6" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="4">
                    <TextBlock Text="{DynamicResource Str_Product_ShelfLocation}" Style="{StaticResource SectionLabel}" />
                    <TextBox Style="{StaticResource Field}" Text="{Binding NewShelfLocation,UpdateSourceTrigger=PropertyChanged}" ToolTip="رف أو ممر (اختياري)" Height="36" Margin="0,0,0,6" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Margin="4">
                    <TextBlock Text="{DynamicResource Str_Product_DefaultSupplier}" Style="{StaticResource SectionLabel}" />
                    <ComboBox ItemsSource="{Binding Suppliers}" DisplayMemberPath="PersonName" SelectedValuePath="PersonId" SelectedValue="{Binding NewSupplierId,Mode=TwoWay}" FlowDirection="RightToLeft" Height="36" Margin="0,0,0,6" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="10" Margin="4,0,4,0" Grid.Column="1">
              <StackPanel>
                <Grid Margin="2,0,2,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{DynamicResource Str_Product_SectionUnits}" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="وحدة واحدة للصنف البسيط، أو وحدتان عند البيع والشراء بالتجزئة والجملة" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                  </StackPanel>
                  <CheckBox Grid.Column="1" Content="{DynamicResource Str_Product_UnitMajorToggle}" IsChecked="{Binding EnableMajorUnit}" VerticalAlignment="Center" Margin="12,0,0,0" FontWeight="SemiBold" />
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="4">
                    <TextBlock Text="{DynamicResource Str_Product_UnitMinor}" Style="{StaticResource SectionLabel}" />
                    <TextBox Style="{StaticResource Field}" Text="{Binding NewSmallUnit,UpdateSourceTrigger=PropertyChanged}" ToolTip="مثل حبة أو قارورة أو علبة" Height="36" Margin="0,0,0,6" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="4">
                    <StackPanel.Style>
                      <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding EnableMajorUnit}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{DynamicResource Str_Product_UnitMajor}" Style="{StaticResource SectionLabel}" />
                    <TextBox Style="{StaticResource Field}" Text="{Binding NewLargeUnit,UpdateSourceTrigger=PropertyChanged}" ToolTip="مثل كرتون أو صندوق" Height="36" Margin="0,0,0,6" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Margin="4">
                    <StackPanel.Style>
                      <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding EnableMajorUnit}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </StackPanel.Style>
                    <TextBlock Text="عدد الوحدات الأساسية في الكبرى" Style="{StaticResource SectionLabel}" />
                    <TextBox Style="{StaticResource NumericField}" Text="{Binding NewConversion,UpdateSourceTrigger=PropertyChanged}" ToolTip="مثال: 24 قارورة في الكرتون" Height="36" Margin="0,0,0,6" />
                  </StackPanel>
                </Grid>
                <Border Background="#0B162C" BorderBrush="{StaticResource BrushLine}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="4,8,4,0">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="معاينة: " Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding NewLargeUnit}" FontWeight="SemiBold" VerticalAlignment="Center">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding EnableMajorUnit}" Value="True">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text=" = " Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding EnableMajorUnit}" Value="True">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding NewConversion}" FontWeight="SemiBold" Foreground="{StaticResource BrushAccent2}" VerticalAlignment="Center">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding EnableMajorUnit}" Value="True">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding NewSmallUnit}" FontWeight="SemiBold" Margin="5,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="منتج بوحدة واحدة؛ لا يلزم تحويل" Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Visibility" Value="Visible" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding EnableMajorUnit}" Value="True">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
            <StackPanel Grid.Column="2">
              <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,0,4">
                <StackPanel>
                  <TextBlock Text="٣. الرصيد الافتتاحي والتنبيه" FontSize="15" FontWeight="SemiBold" Margin="2,0,2,10" />
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition />
                      <ColumnDefinition />
                      <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="4">
                      <TextBlock Text="الكمية الافتتاحية" Style="{StaticResource SectionLabel}" />
                      <Grid>
                        <TextBox Text="{Binding NewOpeningQuantity,UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" TextAlignment="Right" Height="36" Margin="0,0,0,6">
                          <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource NumericField}">
                              <Setter Property="Visibility" Value="Visible" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding EnableMajorUnit}" Value="True">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBox.Style>
                        </TextBox>
                        <TextBox Text="{Binding NewOpeningLargeQuantity,UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" TextAlignment="Right" Height="36" Margin="0,0,0,6">
                          <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource NumericField}">
                              <Setter Property="Visibility" Value="Collapsed" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding EnableMajorUnit}" Value="True">
                                  <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBox.Style>
                        </TextBox>
                      </Grid>
                      <TextBlock Text="{Binding NetOpeningSmallUnits,StringFormat={}الرصيد المعادل: {0:0.##} وحدة أساسية}" Foreground="{StaticResource BrushAccent2}" Margin="2,5,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="4">
                      <TextBlock Text="حد تنبيه انخفاض المخزون" Style="{StaticResource SectionLabel}" />
                      <TextBox Style="{StaticResource NumericField}" Text="{Binding NewAlert,UpdateSourceTrigger=PropertyChanged}" Height="36" Margin="0,0,0,6" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="4">
                      <TextBlock Text="{DynamicResource Str_Product_Notes}" Style="{StaticResource SectionLabel}" />
                      <TextBox Style="{StaticResource Field}" Text="{Binding NewNote,UpdateSourceTrigger=PropertyChanged}" FlowDirection="RightToLeft" TextAlignment="Right" Height="36" Margin="0,0,0,6" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}" Padding="16" Margin="0,4,0,0">
                <StackPanel>
                  <TextBlock Text="{DynamicResource Str_Product_SectionPricing}" FontSize="15" FontWeight="SemiBold" Margin="2,0,2,10" />
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition />
                      <ColumnDefinition />
                      <ColumnDefinition Width="1.1*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="4">
                      <TextBlock Text="{Binding NewSmallUnit,StringFormat={}سعر الشراء / {0}}" Style="{StaticResource SectionLabel}" />
                      <TextBox Style="{StaticResource NumericField}" Text="{Binding NewPurchasePrice,UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" TextAlignment="Right" Height="36" Margin="0,0,0,6" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="4">
                      <TextBlock Text="{Binding NewSmallUnit,StringFormat={}سعر البيع / {0}}" Style="{StaticResource SectionLabel}" />
                      <TextBox Style="{StaticResource NumericField}" Text="{Binding NewSalePrice,UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" TextAlignment="Right" Height="36" Margin="0,0,0,6" />
                    </StackPanel>
                    <Border Grid.Column="2" Background="#0B162C" BorderBrush="{StaticResource BrushLine}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="4">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Str_Product_ProfitMargin}" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="{Binding ProfitMargin,StringFormat={}{0:0.0}%}" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource BrushAccent2}" />
                        <TextBlock Text="{Binding ProfitPerUnit,StringFormat={}الربح للوحدة: {0:0.##}}" Style="{StaticResource CaptionText}" />
                      </StackPanel>
                    </Border>
                  </Grid>
                  <Grid IsEnabled="{Binding EnableMajorUnit}" Margin="0,5,0,0">
                    <Grid.Style>
                      <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding EnableMajorUnit}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition />
                      <ColumnDefinition />
                      <ColumnDefinition Width="1.1*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="4">
                      <TextBlock Text="{Binding NewLargeUnit,StringFormat={}سعر الشراء / {0}}" Style="{StaticResource SectionLabel}" />
                      <TextBox Style="{StaticResource NumericField}" Text="{Binding NewMajorPurchasePrice,UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" TextAlignment="Right" Height="36" Margin="0,0,0,6" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="4">
                      <TextBlock Text="{Binding NewLargeUnit,StringFormat={}سعر البيع / {0}}" Style="{StaticResource SectionLabel}" />
                      <TextBox Style="{StaticResource NumericField}" Text="{Binding NewMajorSalePrice,UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" TextAlignment="Right" Height="36" Margin="0,0,0,6" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="4" VerticalAlignment="Center">
                      <TextBlock Text="يمكن تعديل سعر الوحدة الكبرى يدويًا" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
          </Grid></ScrollViewer>
          <Grid Grid.Row="2" Margin="0,8,0,0" MinHeight="42" Height="Auto">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="2,0,12,0" />
            <Button Grid.Column="1" Content="{DynamicResource Str_Cancel}" Command="{Binding CloseDialogCommand}" Style="{StaticResource GhostButton}" Width="100" Margin="0,0,8,0" />
            <Button Grid.Column="2" Content="{DynamicResource Str_SaveAndNew}" Command="{Binding SaveAndNewProductCommand}" Style="{StaticResource GhostButton}" Width="170" Margin="0,0,8,0" />
            <Button Grid.Column="3" Content="{DynamicResource Str_SaveAndClose}" Command="{Binding SaveAndCloseProductCommand}" Style="{StaticResource PrimaryButton}" Width="165" />
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </DataTemplate>
</ResourceDictionary>
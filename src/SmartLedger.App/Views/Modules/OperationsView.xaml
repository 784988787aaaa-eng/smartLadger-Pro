<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:SmartLedger.App.ViewModels" xmlns:behaviors="clr-namespace:SmartLedger.App.Behaviors" xmlns:local="clr-namespace:SmartLedger.App.Converters" xmlns:core="clr-namespace:SmartLedger.Core.Models;assembly=SmartLedger.Core"><DataTemplate DataType="{x:Type vm:OperationsViewModel}">
    <Grid FlowDirection="RightToLeft">
      <Grid.InputBindings>
        <KeyBinding Key="F5" Command="{Binding SaveCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
      </Grid.InputBindings>
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14">
        <Grid FlowDirection="RightToLeft">
          <Grid.ColumnDefinitions><ColumnDefinition Width="1.45*" /><ColumnDefinition Width="150" /><ColumnDefinition Width="1.35*" /><ColumnDefinition Width="1.65*" /></Grid.ColumnDefinitions>
          <Grid Grid.Column="0" Margin="4">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Text="الحساب" Style="{StaticResource SectionLabel}" />
            <Grid Grid.Row="1" Margin="0,4,0,0">
              <TextBox x:Name="OperationPersonSearch" Style="{StaticResource Field}" Text="{Binding PersonSearch,UpdateSourceTrigger=PropertyChanged}" FlowDirection="RightToLeft" TextAlignment="Right" AutomationProperties.Name="بحث عن الحساب" />
              <Popup Placement="Bottom" PlacementTarget="{Binding ElementName=OperationPersonSearch}" IsOpen="{Binding IsMainPersonSuggestionsOpen}" StaysOpen="False" AllowsTransparency="True" FlowDirection="RightToLeft">
                <Border Width="390" MaxHeight="260" Style="{StaticResource DialogShell}" Padding="6">
                  <ListBox ItemsSource="{Binding People}" SelectedValuePath="PersonId" SelectedValue="{Binding SelectedPersonId,Mode=TwoWay}" FlowDirection="RightToLeft">
                    <ListBox.ItemTemplate><DataTemplate><Grid Margin="4,2"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding PersonName}" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{Binding BookName}" Foreground="{StaticResource BrushMuted}" Margin="12,0,0,0" /></Grid></DataTemplate></ListBox.ItemTemplate>
                  </ListBox>
                </Border>
              </Popup>
            </Grid>
          </Grid>
          <StackPanel Grid.Column="3" Margin="4">
            <TextBlock Text="نوع الحركة" Style="{StaticResource SectionLabel}" />
            <UniformGrid Columns="3" Margin="0,4,0,0"><RadioButton Content="🟢 قبض نقدية" GroupName="OperationType" Style="{StaticResource MovementReceiveChoice}" IsChecked="{Binding IsReceiveSelected}" Command="{Binding SelectReceiveCommand}" Background="#059669" Foreground="White" BorderBrush="#047857" BorderThickness="1.5" Padding="6,8"  ToolTip="تسجيل استلام نقدي أو تحصيل من الحساب"/><RadioButton Content="🔴 صرف وسداد" GroupName="OperationType" Style="{StaticResource MovementPaymentChoice}" IsChecked="{Binding IsPaymentSelected}" Command="{Binding SelectPaymentCommand}" Background="#2563EB" Foreground="White" BorderBrush="#1D4ED8" BorderThickness="1.5" Padding="6,8"  ToolTip="تسجيل دفعة أو صرف نقدي للحساب"/><RadioButton Content="🟡 إثبات دين / قيد" GroupName="OperationType" Style="{StaticResource SegmentedChoice}" IsChecked="{Binding IsDebtSelected}" Command="{Binding SelectDebtCommand}" Background="#DC2626" Foreground="White" BorderBrush="#B91C1C" BorderThickness="1.5" Padding="6,8"  ToolTip="إثبات رصيد مستحق على الحساب أو له"/></UniformGrid>
          </StackPanel>
          <StackPanel Grid.Column="2" Margin="4"><TextBlock Text="المبلغ" Style="{StaticResource SectionLabel}" /><TextBox Text="{Binding AmountText,UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" FlowDirection="LeftToRight" TextAlignment="Right" FontSize="18" FontWeight="SemiBold"><TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource NumericField}"><Setter Property="BorderBrush" Value="#059669"/><Style.Triggers><DataTrigger Binding="{Binding IsPaymentSelected}" Value="True"><Setter Property="BorderBrush" Value="#DC2626"/></DataTrigger><DataTrigger Binding="{Binding IsDebtSelected}" Value="True"><Setter Property="BorderBrush" Value="#D97706"/></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox></StackPanel>
          <StackPanel Grid.Column="3" Margin="4"><TextBlock Text="البيان" Style="{StaticResource SectionLabel}" /><TextBox Style="{StaticResource Field}" Text="{Binding Note,UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" FlowDirection="LeftToRight" TextAlignment="Right" /></StackPanel>
        </Grid>
      </Border>
      <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8">
        <DataGrid FlowDirection="RightToLeft" ItemsSource="{Binding Rows}" IsReadOnly="True" AutoGenerateColumns="False" RowHeight="46" AlternationCount="1000000" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <DataGrid.Columns>
            <DataGridTemplateColumn Width="46"><DataGridTemplateColumn.HeaderTemplate><DataTemplate><TextBlock Text="م" HorizontalAlignment="Center" TextAlignment="Center" FontWeight="SemiBold" /></DataTemplate></DataGridTemplateColumn.HeaderTemplate><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}},Path=AlternationIndex,Converter={StaticResource SerialNumberConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="LeftToRight" Foreground="{StaticResource BrushMuted}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            <DataGridTextColumn Header="اسم الحساب" Binding="{Binding PersonName}" Width="1.35*" ElementStyle="{StaticResource TableTextCell}" />
            <DataGridTemplateColumn Header="المبلغ" Width="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Amount,Converter={StaticResource PrivacyMoneyConverter}}" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" FlowDirection="LeftToRight" Language="en-US"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource NumericCell}"><Setter Property="Foreground" Value="{StaticResource BrushMuted}" /><Style.Triggers><DataTrigger Binding="{Binding DirectionPositive}" Value="True"><Setter Property="Foreground" Value="{StaticResource BrushPositive}" /></DataTrigger><DataTrigger Binding="{Binding DirectionPositive}" Value="False"><Setter Property="Foreground" Value="{StaticResource BrushNegative}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            <DataGridTemplateColumn Header="الاتجاه" Width="1.15*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding DirectionLabel}" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource TableTextCell}"><Setter Property="Foreground" Value="{StaticResource BrushMuted}" /><Style.Triggers><DataTrigger Binding="{Binding DirectionPositive}" Value="True"><Setter Property="Foreground" Value="{StaticResource BrushPositive}" /></DataTrigger><DataTrigger Binding="{Binding DirectionPositive}" Value="False"><Setter Property="Foreground" Value="{StaticResource BrushNegative}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            <DataGridTextColumn Header="البيان" Binding="{Binding Note}" Width="1.55*" ElementStyle="{StaticResource TableTextCell}" />
            <DataGridTextColumn Header="الوقت والتاريخ" Binding="{Binding OccurredAt,Converter={StaticResource ArabicDateTimeConverter}}" Width="180" ElementStyle="{StaticResource TableTextCell}" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>
      <Grid Style="{StaticResource DialogOverlay}" Visibility="{Binding IsDialogOpen,Converter={StaticResource BoolToVisibility}}">
        <Border x:Name="DialogHostContainer" MinWidth="520" Width="620" MaxWidth="900" MaxHeight="850" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource DialogShell}" Padding="26">
          <Grid FlowDirection="RightToLeft" KeyboardNavigation.TabNavigation="Local" behaviors:InputDialogBehavior.IsEnabled="True">
            <Grid.InputBindings>
              <KeyBinding Key="F5" Command="{Binding SaveCommand}" />
              <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
              <KeyBinding Key="Escape" Command="{Binding CloseDialogCommand}" />
            </Grid.InputBindings>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,18" Cursor="SizeAll" behaviors:DialogInteractionBehavior.IsDraggable="True"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Grid.Column="0" Command="{Binding CloseDialogCommand}" Style="{StaticResource IconButton}" ToolTip="&#x625;&#x63;&#x644;&#x627;&#x642;" AutomationProperties.Name="&#x625;&#x63;&#x644;&#x627;&#x642;"><Path Width="14" Height="14" Stretch="Uniform" Stroke="#9DB7D4" StrokeThickness="1.6" Data="{StaticResource CloseIcon}" /></Button><TextBlock Grid.Column="1" Text="{DynamicResource Str_Op_Title}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/><Border Grid.Column="2" Width="30"/></Grid>
            <Grid Grid.Row="1" Margin="0,0,0,14">
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <TextBlock Text="الحساب" Style="{StaticResource SectionLabel}" />
              <Grid Grid.Row="1" Margin="0,4,0,0">
                <TextBox x:Name="OperationDialogPersonSearch" Style="{StaticResource Field}" Text="{Binding PersonSearch,UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" TextAlignment="Right" AutomationProperties.Name="الحساب" />
                <Popup Placement="Bottom" PlacementTarget="{Binding ElementName=OperationDialogPersonSearch}" IsOpen="{Binding IsDialogPersonSuggestionsOpen}" StaysOpen="False" AllowsTransparency="True">
                  <Border Width="520" MaxHeight="260" Style="{StaticResource DialogShell}" Padding="6">
                    <ListBox ItemsSource="{Binding People}" SelectedValuePath="PersonId" SelectedValue="{Binding SelectedPersonId,Mode=TwoWay}" FlowDirection="RightToLeft">
                      <ListBox.ItemTemplate><DataTemplate><Grid Margin="4,2"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding PersonName}" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{Binding BookName}" Foreground="{StaticResource BrushMuted}" Margin="12,0,0,0" /></Grid></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                  </Border>
                </Popup>
              </Grid>
            </Grid>
            <Grid Grid.Row="2" Margin="0,0,0,14">
              <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1.7*"/></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,7,0"><TextBlock Text="&#x627;&#x644;&#x645;&#x628;&#x644;&#x63;&#x20;*" Style="{StaticResource SectionLabel}"/><Grid Height="46" FlowDirection="LeftToRight" Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="&#x631;.&#x64A;" Foreground="{StaticResource BrushMuted}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/><TextBox Grid.Column="1" Style="{StaticResource NumericField}" FontSize="18" FontWeight="Bold" Text="{Binding AmountText,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="&#x627;&#x644;&#x645;&#x628;&#x644;&#x63;" TextAlignment="Right" HorizontalContentAlignment="Right" Padding="10,5" FlowDirection="LeftToRight"/></Grid></StackPanel>
              <StackPanel Grid.Column="1" Margin="7,0,0,0"><TextBlock Text="&#x627;&#x644;&#x628;&#x64A;&#x627;&#x646; / &#x627;&#x644;&#x62A;&#x641;&#x627;&#x635;&#x64A;&#x644;" Style="{StaticResource SectionLabel}"/><TextBox Style="{StaticResource Field}" Text="{Binding Note,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="&#x627;&#x644;&#x628;&#x64A;&#x627;&#x646; &#x648;&#x627;&#x644;&#x62A;&#x641;&#x627;&#x635;&#x64A;&#x644;" Margin="0,4,0,0" FlowDirection="LeftToRight" TextAlignment="Right"/></StackPanel>
            </Grid>
            <StackPanel Grid.Row="3" Margin="0,0,0,4">
              <TextBlock Text="&#x646;&#x648;&#x639; &#x627;&#x644;&#x62D;&#x631;&#x643;&#x629;" Style="{StaticResource SectionLabel}"/>
              <UniformGrid Columns="3" Margin="0,6,0,0">
                <RadioButton Content="🟢 قبض نقدية" GroupName="DialogOperationType" Style="{StaticResource MovementReceiveChoice}" IsChecked="{Binding IsReceiveSelected}" Command="{Binding SelectReceiveCommand}" MinHeight="44" FontWeight="SemiBold" Background="#059669" Foreground="White" BorderBrush="#047857" BorderThickness="1.5" Padding="10,8" ToolTip="تسجيل استلام نقدي أو تحصيل من الحساب"/>
                <RadioButton Content="🔴 صرف وسداد" GroupName="DialogOperationType" Style="{StaticResource MovementPaymentChoice}" IsChecked="{Binding IsPaymentSelected}" Command="{Binding SelectPaymentCommand}" MinHeight="44" FontWeight="SemiBold" Background="#2563EB" Foreground="White" BorderBrush="#1D4ED8" BorderThickness="1.5" Padding="10,8" ToolTip="تسجيل دفعة أو صرف نقدي للحساب"/>
                <RadioButton Content="🟡 إثبات دين / قيد" GroupName="DialogOperationType" IsChecked="{Binding IsDebtSelected}" Command="{Binding SelectDebtCommand}" MinHeight="44" FontWeight="SemiBold" Background="#DC2626" Foreground="White" BorderBrush="#B91C1C" BorderThickness="1.5" Padding="10,8" ToolTip="إثبات رصيد مستحق على الحساب أو له"/>
              </UniformGrid>
            </StackPanel>
            <Grid Grid.Row="4" Margin="0,8,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.Row="0" Text="&#x64A;&#x64F;&#x62E;&#x62A;&#x627;&#x631; &#x627;&#x644;&#x627;&#x62A;&#x62C;&#x627;&#x647; &#x627;&#x644;&#x627;&#x641;&#x62A;&#x631;&#x627;&#x636;&#x64A; &#x62D;&#x633;&#x628; &#x62A;&#x635;&#x646;&#x64A;&#x641; &#x627;&#x644;&#x62D;&#x633;&#x627;&#x628;&#x61B; &#x648;&#x64A;&#x645;&#x643;&#x646; &#x62A;&#x63A;&#x64A;&#x64A;&#x631;&#x647; &#x642;&#x628;&#x644; &#x627;&#x644;&#x62D;&#x641;&#x638;." Style="{StaticResource CaptionText}" TextWrapping="Wrap"/><TextBlock Grid.Row="1" Text="{Binding StatusText}" Style="{StaticResource CaptionText}" Foreground="{StaticResource BrushNegative}" Margin="0,4,0,0" TextWrapping="Wrap"/></Grid>
            <Grid Grid.Row="5" Margin="0,16,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Enter &#x644;&#x644;&#x62A;&#x627;&#x644;&#x64A;  &#x2022;  Ctrl+S &#x623;&#x648; F5 &#x644;&#x644;&#x62D;&#x641;&#x638;  &#x2022;  Esc &#x644;&#x644;&#x625;&#x63A;&#x644;&#x627;&#x642;" Style="{StaticResource CaptionText}" VerticalAlignment="Center" HorizontalAlignment="Left" TextWrapping="Wrap" Margin="0,0,12,0"/>
              <Button Grid.Column="1" Content="&#x62D;&#x641;&#x638; &#x627;&#x644;&#x62D;&#x631;&#x643;&#x629;  [F5]" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Width="150"/>
              <Button Grid.Column="2" Content="إلغاء" Command="{Binding CloseDialogCommand}" Style="{StaticResource GhostButton}" Width="105" Margin="8,0,0,0" ToolTip="إغلاق النموذج دون حفظ (Esc)"/>
            </Grid>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </DataTemplate></ResourceDictionary>
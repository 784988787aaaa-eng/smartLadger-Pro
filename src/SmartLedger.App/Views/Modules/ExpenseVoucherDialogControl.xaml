<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:SmartLedger.App.ViewModels" xmlns:behaviors="clr-namespace:SmartLedger.App.Behaviors" xmlns:local="clr-namespace:SmartLedger.App.Converters" xmlns:core="clr-namespace:SmartLedger.Core.Models;assembly=SmartLedger.Core">
  <DataTemplate x:Key="ExpenseVoucherDialogTemplate">
<Grid Style="{StaticResource ModernDialogOverlay}" Visibility="{Binding IsDialogOpen,Converter={StaticResource BoolToVisibility}}"><Border x:Name="DialogHostContainer" Width="560" MinWidth="420" MaxWidth="900" MaxHeight="900" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource ResponsiveDialogHost}" Padding="24"><Grid FlowDirection="RightToLeft" behaviors:InputDialogBehavior.IsEnabled="True"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Grid.Row="0" Margin="0,0,0,12" Cursor="SizeAll" behaviors:DialogInteractionBehavior.IsDraggable="True"><DockPanel Margin="0,0,0,20"><StackPanel><TextBlock Text="{DynamicResource Str_Expense_Title}" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource Str_Expense_Subtitle}" Style="{StaticResource CaptionText}" /></StackPanel><Button DockPanel.Dock="Left" Command="{Binding CloseDialogCommand}" Style="{StaticResource IconButton}" ToolTip="إغلاق" AutomationProperties.Name="إغلاق" AutomationProperties.AutomationId="Btn_CloseExpenseDialog"><Path Width="14" Height="14" Stretch="Uniform" Stroke="#9DB7D4" StrokeThickness="1.6" Data="{StaticResource CloseIcon}" /></Button></DockPanel><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><TextBlock Text="{DynamicResource Str_Expense_Category}" Style="{StaticResource SectionLabel}" /><ComboBox Style="{StaticResource DialogComboBox}" ItemsSource="{Binding SuggestedCategories}" SelectedItem="{Binding Category,UpdateSourceTrigger=PropertyChanged}" IsEditable="False" IsTextSearchEnabled="True" Margin="0,0,0,14" AutomationProperties.Name="{DynamicResource ColCategory}" FlowDirection="RightToLeft" /><TextBlock Text="{DynamicResource Str_Expense_Amount}" Style="{StaticResource SectionLabel}" /><TextBox Style="{StaticResource NumericField}" Text="{Binding AmountText,UpdateSourceTrigger=PropertyChanged}" Height="56" FontSize="40" FontWeight="Bold" TextAlignment="Right" FlowDirection="LeftToRight" Margin="0,0,0,14" AutomationProperties.Name="مبلغ النفقة" /><TextBlock Text="{DynamicResource Str_Expense_Date}" Style="{StaticResource SectionLabel}" /><DatePicker SelectedDate="{Binding ExpenseDate}" Height="38" Margin="0,0,0,14" /><TextBlock Text="{DynamicResource Str_Expense_Source}" Style="{StaticResource SectionLabel}" /><ComboBox Height="40" SelectedValue="{Binding PaymentMethod}" SelectedValuePath="Tag" Margin="0,0,0,14" FlowDirection="LeftToRight"><ComboBoxItem Content="{DynamicResource Str_Expense_PaymentCash}" Tag="Cash" /><ComboBoxItem Content="{DynamicResource Str_Expense_PaymentBank}" Tag="Bank" /><ComboBoxItem Content="{DynamicResource Str_Expense_PaymentCredit}" Tag="Credit" /></ComboBox><TextBlock Text="{DynamicResource Str_Expense_Statement}" Style="{StaticResource SectionLabel}" /><TextBox Style="{StaticResource Field}" Text="{Binding Note}" Margin="0,0,0,20" FlowDirection="RightToLeft" TextAlignment="Right" /><TextBlock Text="{Binding StatusText}" Foreground="{StaticResource BrushWarning}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></ScrollViewer><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,14,0,0"><Button Content="{DynamicResource Str_SaveAndClose}" Command="{Binding SaveCommand}" Style="{StaticResource SmartPrimaryButton}" Width="140" Margin="0,0,8,0" /><Button Content="{DynamicResource Str_Cancel}" Command="{Binding CloseDialogCommand}" Style="{StaticResource SmartGhostButton}" Width="100" /></StackPanel></Grid></Border></Grid>
  </DataTemplate>
</ResourceDictionary>
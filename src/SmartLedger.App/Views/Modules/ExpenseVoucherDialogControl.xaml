<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:SmartLedger.App.ViewModels" xmlns:behaviors="clr-namespace:SmartLedger.App.Behaviors" xmlns:local="clr-namespace:SmartLedger.App.Converters" xmlns:core="clr-namespace:SmartLedger.Core.Models;assembly=SmartLedger.Core">
  <DataTemplate x:Key="ExpenseVoucherDialogTemplate">
<Grid Style="{StaticResource DialogOverlay}" Visibility="{Binding IsDialogOpen,Converter={StaticResource BoolToVisibility}}"><Border Width="560" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource DialogShell}" Padding="28"><StackPanel behaviors:InputDialogBehavior.IsEnabled="True"><DockPanel Margin="0,0,0,20"><StackPanel><TextBlock Text="تسجيل نفقة" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="سجل النفقة بسرعة ووضوح" Style="{StaticResource CaptionText}" /></StackPanel><Button DockPanel.Dock="Left" Command="{Binding CloseDialogCommand}" Style="{StaticResource IconButton}" ToolTip="إغلاق" AutomationProperties.Name="إغلاق" AutomationProperties.AutomationId="Btn_CloseExpenseDialog"><Path Width="14" Height="14" Stretch="Uniform" Stroke="#9DB7D4" StrokeThickness="1.6" Data="{StaticResource CloseIcon}" /></Button></DockPanel><TextBlock Text="{DynamicResource ColCategory}" Style="{StaticResource SectionLabel}" /><ComboBox Style="{StaticResource DialogComboBox}" ItemsSource="{Binding SuggestedCategories}" SelectedItem="{Binding Category,UpdateSourceTrigger=PropertyChanged}" IsEditable="False" IsTextSearchEnabled="True" Margin="0,0,0,14" AutomationProperties.Name="{DynamicResource ColCategory}" FlowDirection="RightToLeft" /><TextBlock Text="المبلغ" Style="{StaticResource SectionLabel}" /><TextBox Style="{StaticResource NumericField}" Text="{Binding AmountText,UpdateSourceTrigger=PropertyChanged}" Height="56" FontSize="40" FontWeight="Bold" TextAlignment="Right" FlowDirection="LeftToRight" Margin="0,0,0,14" AutomationProperties.Name="مبلغ النفقة" /><TextBlock Text="تاريخ النفقة" Style="{StaticResource SectionLabel}" /><DatePicker SelectedDate="{Binding ExpenseDate}" Height="38" Margin="0,0,0,14" /><TextBlock Text="مصدر الدفع" Style="{StaticResource SectionLabel}" /><ComboBox Height="40" SelectedValue="{Binding PaymentMethod}" SelectedValuePath="Tag" Margin="0,0,0,14" FlowDirection="LeftToRight"><ComboBoxItem Content="الصندوق الرئيسي" Tag="Cash" /><ComboBoxItem Content="الحساب البنكي" Tag="Bank" /><ComboBoxItem Content="آجل" Tag="Credit" /></ComboBox><TextBlock Text="البيان" Style="{StaticResource SectionLabel}" /><TextBox Style="{StaticResource Field}" Text="{Binding Note}" Margin="0,0,0,20" FlowDirection="LeftToRight" TextAlignment="Right" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Left"><Button Content="حفظ النفقة" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Width="125" Margin="0,0,8,0" /><Button Content="إلغاء" Command="{Binding CloseDialogCommand}" Style="{StaticResource GhostButton}" Width="100" /></StackPanel></StackPanel></Border></Grid>
  </DataTemplate>
</ResourceDictionary>
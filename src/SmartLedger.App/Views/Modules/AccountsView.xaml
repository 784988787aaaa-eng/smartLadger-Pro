<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:SmartLedger.App.ViewModels" xmlns:behaviors="clr-namespace:SmartLedger.App.Behaviors" xmlns:local="clr-namespace:SmartLedger.App.Converters" xmlns:core="clr-namespace:SmartLedger.Core.Models;assembly=SmartLedger.Core"><DataTemplate DataType="{x:Type vm:AccountsViewModel}">
    <Grid x:Name="RootAccountsPage" KeyboardNavigation.TabNavigation="Local">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <Grid Style="{StaticResource AppStandardToolbar}" FlowDirection="LeftToRight">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" FlowDirection="RightToLeft">
          <Button Content="حذف المحدد" Command="{Binding DeleteSelectedCommand}" Style="{StaticResource DangerButton}" Width="120" Margin="0,0,8,0" />
          <Button Content="+ حساب جديد" Command="{Binding OpenAddCommand}" Style="{StaticResource PrimaryButton}" Width="138" AutomationProperties.AutomationId="Btn_OpenNewAccountDialog" />
        </StackPanel>
        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" FlowDirection="RightToLeft" MaxWidth="900">
          <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
            <RadioButton Content="الكل" Command="{Binding SelectBookKindCommand}" CommandParameter="{x:Static core:BookKind.All}" GroupName="AccountBookFilters" Style="{StaticResource SegmentedChoice}" Width="78" Margin="0,0,5,0">
              <RadioButton.IsChecked><MultiBinding Mode="OneWay" Converter="{StaticResource BookSelectionConverter}"><Binding ElementName="RootAccountsPage" Path="DataContext.AllBookId" /><Binding Path="SelectedBookId" /></MultiBinding></RadioButton.IsChecked>
            </RadioButton>
            <RadioButton Content="العملاء" Command="{Binding SelectBookKindCommand}" CommandParameter="{x:Static core:BookKind.Customers}" GroupName="AccountBookFilters" Style="{StaticResource SegmentedChoice}" Width="88" Margin="0,0,5,0">
              <RadioButton.IsChecked><MultiBinding Mode="OneWay" Converter="{StaticResource BookSelectionConverter}"><Binding ElementName="RootAccountsPage" Path="DataContext.CustomersBookId" /><Binding Path="SelectedBookId" /></MultiBinding></RadioButton.IsChecked>
            </RadioButton>
            <RadioButton Content="الموردون" Command="{Binding SelectBookKindCommand}" CommandParameter="{x:Static core:BookKind.Suppliers}" GroupName="AccountBookFilters" Style="{StaticResource SegmentedChoice}" Width="88" Margin="0,0,5,0">
              <RadioButton.IsChecked><MultiBinding Mode="OneWay" Converter="{StaticResource BookSelectionConverter}"><Binding ElementName="RootAccountsPage" Path="DataContext.SuppliersBookId" /><Binding Path="SelectedBookId" /></MultiBinding></RadioButton.IsChecked>
            </RadioButton>
            <RadioButton Content="العاملون" Command="{Binding SelectBookKindCommand}" CommandParameter="{x:Static core:BookKind.Employees}" GroupName="AccountBookFilters" Style="{StaticResource SegmentedChoice}" Width="88" Margin="0,0,5,0">
              <RadioButton.IsChecked><MultiBinding Mode="OneWay" Converter="{StaticResource BookSelectionConverter}"><Binding ElementName="RootAccountsPage" Path="DataContext.EmployeesBookId" /><Binding Path="SelectedBookId" /></MultiBinding></RadioButton.IsChecked>
            </RadioButton>
            <RadioButton Content="أخرى" Command="{Binding SelectBookKindCommand}" CommandParameter="{x:Static core:BookKind.Other}" GroupName="AccountBookFilters" Style="{StaticResource SegmentedChoice}" Width="70" Margin="0,0,5,0">
              <RadioButton.IsChecked><MultiBinding Mode="OneWay" Converter="{StaticResource BookSelectionConverter}"><Binding ElementName="RootAccountsPage" Path="DataContext.OtherBookId" /><Binding Path="SelectedBookId" /></MultiBinding></RadioButton.IsChecked>
            </RadioButton>
            <Button Content="+" Command="{Binding OpenBookAddCommand}" Style="{StaticResource GhostButton}" Width="40" AutomationProperties.AutomationId="Btn_OpenNewBookDialog" Height="40" ToolTip="إضافة تصنيف جديد" AutomationProperties.Name="إضافة تصنيف جديد" Margin="0,0,6,0" />
            <ItemsControl ItemsSource="{Binding CustomBookGroups}" FlowDirection="RightToLeft">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <RadioButton Content="{Binding Name}" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Command="{Binding DataContext.SelectCustomBookCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" GroupName="AccountBookFilters" Style="{StaticResource SegmentedChoice}" MinWidth="90" Height="40" Margin="0,0,5,0" ToolTip="النقر يفتح التصنيف — زر الفأرة الأيمن للتعديل أو الحذف">
                    <RadioButton.ContextMenu>
                      <ContextMenu FlowDirection="RightToLeft" Style="{StaticResource DarkContextMenu}">
                        <MenuItem Header="تعديل اسم التصنيف" Style="{StaticResource DarkMenuItem}" Command="{Binding PlacementTarget.Tag.OpenBookEditCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                        <MenuItem Header="حذف التصنيف" Style="{StaticResource DarkMenuItem}" Command="{Binding PlacementTarget.Tag.DeleteBookCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                      </ContextMenu>
                    </RadioButton.ContextMenu>
                    <RadioButton.IsChecked><MultiBinding Mode="OneWay" Converter="{StaticResource BookSelectionConverter}"><Binding Path="Id" /><Binding Path="DataContext.SelectedBookId" RelativeSource="{RelativeSource AncestorType=ItemsControl}" /></MultiBinding></RadioButton.IsChecked>
                  </RadioButton>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Grid>
      <Border Grid.Row="1" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="8" Margin="0,0,0,8">
        <Grid FlowDirection="RightToLeft">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="#102A25" BorderBrush="#1C5B4A" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,6,0">
            <StackPanel Orientation="Horizontal"><TextBlock Text="إجمالي لنا" Foreground="#A7F3D0" FontSize="11.5" FontWeight="SemiBold" /><TextBlock Text="  " Foreground="{StaticResource BrushMuted}" /><TextBlock Text="{Binding TotalOwedToUs,Converter={StaticResource PrivacyMoneyConverter}}" Foreground="#10B981" FontSize="13" FontWeight="Bold" FlowDirection="LeftToRight" /></StackPanel>
          </Border>
          <Border Grid.Column="1" Background="#321B22" BorderBrush="#63313A" BorderThickness="1" CornerRadius="8" Padding="12,6">
            <StackPanel Orientation="Horizontal"><TextBlock Text="إجمالي علينا" Foreground="#FECACA" FontSize="11.5" FontWeight="SemiBold" /><TextBlock Text="  " Foreground="{StaticResource BrushMuted}" /><TextBlock Text="{Binding TotalWeOwe,Converter={StaticResource PrivacyMoneyConverter}}" Foreground="#EF4444" FontSize="13" FontWeight="Bold" FlowDirection="LeftToRight" /></StackPanel>
          </Border>
          <TextBlock Grid.Column="2" Text="ملخص الحسابات المعروضة" Foreground="{StaticResource BrushMuted}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="8,0,0,0" />
        </Grid>
      </Border>
      <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="42" /></Grid.RowDefinitions>
          <DataGrid Grid.Row="0" FlowDirection="RightToLeft" AutoGenerateColumns="False" ItemsSource="{Binding People}" SelectedItem="{Binding SelectedPerson}" IsReadOnly="True" HeadersVisibility="Column" ColumnHeaderHeight="50" RowHeight="60" AlternationCount="100000" EnableRowVirtualization="True" EnableColumnVirtualization="True" HorizontalScrollBarVisibility="Disabled">
          <DataGrid.InputBindings>
            <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding OpenAccountCommand}" />
          </DataGrid.InputBindings>
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="م" Width="60" MinWidth="60" MaxWidth="60" CanUserResize="False">
              <DataGridTemplateColumn.CellTemplate><DataTemplate>
                <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}, Path=AlternationIndex, Converter={StaticResource SerialNumberConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FlowDirection="LeftToRight" FontSize="12" Foreground="{StaticResource BrushMuted}" />
              </DataTemplate></DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="اسم الحساب" Width="1.45*">
              <DataGridTemplateColumn.CellTemplate><DataTemplate>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" FlowDirection="RightToLeft" Margin="0,3">
                  <TextBlock Text="{Binding PersonName}" Style="{StaticResource TableTextCell}" FontWeight="SemiBold" MaxWidth="260" />
                  <Border Background="#13253E" BorderBrush="#2C4D72" BorderThickness="1" CornerRadius="5" Padding="7,2" Margin="10,0,0,0">
                    <TextBlock Text="{Binding BookName}" FontSize="10.5" Foreground="{StaticResource BrushMuted}" TextTrimming="CharacterEllipsis" />
                  </Border>
                </StackPanel>
              </DataTemplate></DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="الهاتف" Width="120" MinWidth="110">
              <DataGridTemplateColumn.CellTemplate><DataTemplate>
                <TextBlock Text="{Binding Person.Phone}" Foreground="{StaticResource BrushMuted}" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" FlowDirection="LeftToRight" />
              </DataTemplate></DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="المبلغ المتبقي" Width="145" MinWidth="135">
              <DataGridTemplateColumn.CellTemplate><DataTemplate>
                <TextBlock Text="{Binding NetBalance,Converter={StaticResource PrivacyMoneyConverter}}" Foreground="{Binding NetBalance,Converter={StaticResource NetBalanceBrushConverter}}" FontSize="13.5" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" FlowDirection="LeftToRight" />
              </DataTemplate></DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="الاتجاه" Width="90" MinWidth="84">
              <DataGridTemplateColumn.CellTemplate><DataTemplate>
                <TextBlock Text="{Binding NetBalance,Converter={StaticResource NetBalanceDirectionConverter}}" Foreground="{Binding NetBalance,Converter={StaticResource NetBalanceBrushConverter}}" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" />
              </DataTemplate></DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="البيان والتفصيل" Width="1.35*">
              <DataGridTemplateColumn.CellTemplate><DataTemplate>
                <TextBlock Text="{Binding Person.Note}" Foreground="{StaticResource BrushMuted}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Person.Note}" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" />
              </DataTemplate></DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="آخر حركة" Width="175" MinWidth="165">
              <DataGridTemplateColumn.CellTemplate><DataTemplate>
                <TextBlock Text="{Binding LastOperationAt,Converter={StaticResource ArabicDateTimeConverter}}" HorizontalAlignment="Center" TextAlignment="Center" FlowDirection="LeftToRight" Foreground="{StaticResource BrushMuted}" FontSize="12.5" FontWeight="Normal" />
              </DataTemplate></DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
        <Grid x:Name="AccountsEmptyStatePhase1" Grid.Row="0" Panel.ZIndex="5" Background="#F20F172A" Visibility="Collapsed"><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding People.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Margin="24"><TextBlock Text="◇" FontSize="42" Foreground="{StaticResource BrushMuted}" HorizontalAlignment="Center" TextAlignment="Center" /><TextBlock Text="لا توجد حسابات في هذا العرض" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,4" /><TextBlock Text="أضف حسابًا جديدًا أو غيّر مرشح التصنيف لعرض الحسابات المتاحة." Style="{StaticResource CaptionText}" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,16" /><Button Content="+ إضافة حساب جديد" Command="{Binding OpenAddCommand}" Style="{StaticResource PrimaryButton}" Width="190" Height="40" HorizontalAlignment="Center" /></StackPanel></Grid><Border Grid.Row="1" Background="#0B132B" BorderBrush="#1E293B" BorderThickness="1,1,1,0" CornerRadius="0,0,8,8" Padding="10,0">
          <Grid FlowDirection="RightToLeft">
            <TextBlock Text="{Binding VisibleAccountsCount, StringFormat={}إجمالي الحسابات: {0}}" Foreground="{StaticResource BrushMuted}" FontSize="11" VerticalAlignment="Center" />
            <TextBlock Text="[F7] لإضافة حساب جديد" Foreground="{StaticResource BrushMuted}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Left" />
          </Grid>
        </Border>
        </Grid>
      </Border>
      <ContentControl Style="{StaticResource DialogOverlay}" Content="{Binding}" ContentTemplate="{StaticResource AccountDialogControlTemplate}" />
      <Grid Style="{StaticResource DialogOverlay}" Visibility="{Binding IsBookDialogOpen,Converter={StaticResource BoolToVisibility}}">
        <Border Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource DialogShell}" Padding="22">
          <Grid FlowDirection="RightToLeft" KeyboardNavigation.TabNavigation="Cycle" behaviors:InputDialogBehavior.IsEnabled="True">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid Grid.Row="0" Height="40" Margin="0,0,0,16" FlowDirection="LeftToRight">
              <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
              <Button Grid.Column="2" Command="{Binding CloseBookDialogCommand}" Style="{StaticResource IconButton}" ToolTip="إغلاق" AutomationProperties.Name="إغلاق" AutomationProperties.AutomationId="Btn_CloseBookDialog" Width="36" Height="36">
                <Path Width="14" Height="14" Stretch="Uniform" Stroke="#9DB7D4" StrokeThickness="1.6" Data="{StaticResource CloseIcon}" />
              </Button>
              <TextBlock Grid.Column="1" Text="{Binding BookDialogTitle}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
            </Grid>
            <StackPanel Grid.Row="1">
              <TextBlock Text="اسم التصنيف" Style="{StaticResource SectionLabel}" />
              <TextBox Style="{StaticResource DialogField}" Text="{Binding BookNameText,UpdateSourceTrigger=PropertyChanged}" FlowDirection="RightToLeft" TextAlignment="Right" HorizontalContentAlignment="Right" AutomationProperties.Name="اسم التصنيف" TabIndex="0" />
              <TextBlock Text="يمكنك لاحقًا تغيير الاسم أو حذف التصنيف من زر الفأرة الأيمن." Style="{StaticResource CaptionText}" Margin="0,7,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <Grid Grid.Row="2" Margin="0,18,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding BookDialogStatus}" Foreground="{StaticResource BrushMuted}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="190" />
              <StackPanel Grid.Column="0" Orientation="Horizontal" FlowDirection="RightToLeft">
                <Button Content="حفظ التصنيف" Command="{Binding SaveBookCommand}" Style="{StaticResource PrimaryButton}" Width="118" Height="40" Margin="0,0,8,0" AutomationProperties.Name="حفظ التصنيف" />
                <Button Content="إلغاء" Command="{Binding CloseBookDialogCommand}" Style="{StaticResource GhostButton}" Width="82" Height="40" IsCancel="True" AutomationProperties.Name="إلغاء" />
              </StackPanel>
            </Grid>
          </Grid>
        </Border>
      </Grid>
      <Grid Style="{StaticResource DialogOverlay}" Visibility="{Binding IsAccountOpen,Converter={StaticResource BoolToVisibility}}">
        <Border Width="920" Height="640" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource DialogShell}" Padding="20">
          <Grid FlowDirection="RightToLeft">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,14" FlowDirection="RightToLeft">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <Button Grid.Column="0" Command="{Binding CloseAccountCommand}" Style="{StaticResource IconButton}" ToolTip="إغلاق تفاصيل الحساب" AutomationProperties.Name="إغلاق تفاصيل الحساب">
                <Path Width="14" Height="14" Stretch="Uniform" Stroke="#9DB7D4" StrokeThickness="1.6" Data="{StaticResource CloseIcon}" />
              </Button>
              <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="RightToLeft">
                <TextBlock Text="{Binding SelectedAccountTitle}" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" />
                <TextBlock Text="{Binding SelectedAccountTypeLabel}" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,4,0,0" />
              </StackPanel>
              <Border Grid.Column="2" Width="42" Height="42" Background="Transparent" />
            </Grid>
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12">
              <StackPanel>
              <UniformGrid Columns="4" FlowDirection="RightToLeft">
                <StackPanel Margin="4" HorizontalAlignment="Center"><TextBlock Text="الرصيد الافتتاحي" Style="{StaticResource KpiLabel}" HorizontalAlignment="Center" /><TextBlock Text="{Binding OpeningBalance,Converter={StaticResource PrivacyMoneyConverter}}" Style="{StaticResource MetricText}" HorizontalAlignment="Center" FlowDirection="LeftToRight" /></StackPanel>
                <StackPanel Margin="4" HorizontalAlignment="Center"><TextBlock Text="إجمالي الحركات عليه (مدين)" Style="{StaticResource KpiLabel}" Foreground="#EF4444" HorizontalAlignment="Center" /><TextBlock Text="{Binding TotalDebit,Converter={StaticResource PrivacyMoneyConverter}}" Style="{StaticResource MetricText}" Foreground="#EF4444" HorizontalAlignment="Center" FlowDirection="LeftToRight" /></StackPanel>
                <StackPanel Margin="4" HorizontalAlignment="Center"><TextBlock Text="إجمالي الحركات له (دائن)" Style="{StaticResource KpiLabel}" Foreground="#10B981" HorizontalAlignment="Center" /><TextBlock Text="{Binding TotalCredit,Converter={StaticResource PrivacyMoneyConverter}}" Style="{StaticResource MetricText}" Foreground="#10B981" HorizontalAlignment="Center" FlowDirection="LeftToRight" /></StackPanel>
                <StackPanel Margin="4" HorizontalAlignment="Center"><TextBlock Text="صافي الرصيد الحالي" Style="{StaticResource KpiLabel}" HorizontalAlignment="Center" /><TextBlock Text="{Binding NetBalance,Converter={StaticResource PrivacyMoneyConverter}}" Style="{StaticResource MetricText}" Foreground="{Binding NetBalance,Converter={StaticResource NetBalanceBrushConverter}}" HorizontalAlignment="Center" FlowDirection="LeftToRight" /><Border Background="{Binding NetBalance,Converter={StaticResource NetBalanceBrushConverter}}" CornerRadius="7" Padding="6,2" Margin="0,3,0,0"><TextBlock Text="{Binding BalanceStatusText}" Foreground="White" FontSize="10" FontWeight="SemiBold" /></Border></StackPanel>
              </UniformGrid>
              <TextBlock Text="ملاحظة الحساب" Style="{StaticResource KpiLabel}" Margin="4,8,4,2" />
              <TextBlock Text="{Binding SelectedAccountNote}" Foreground="{StaticResource BrushText}" TextWrapping="Wrap" Margin="4,0,4,2" AutomationProperties.Name="ملاحظة الحساب" />
              </StackPanel>
            </Border>
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="10">
              <DataGrid ItemsSource="{Binding SelectedAccountStatementRows}" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" RowHeight="50" FlowDirection="RightToLeft" GridLinesVisibility="Horizontal" AlternationCount="1000000">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Width="48" Visibility="Collapsed">
                    <DataGridTemplateColumn.HeaderTemplate>
                      <DataTemplate><TextBlock Text="م" HorizontalAlignment="Center" TextAlignment="Center" FontWeight="SemiBold" FontSize="12.5" /></DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}},Path=AlternationIndex,Converter={StaticResource SerialNumberConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FlowDirection="LeftToRight" Foreground="{StaticResource BrushMuted}" FontSize="11.5" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>

                  <DataGridTemplateColumn Header="رقم السند" Width="100">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding ReferenceNumber}" HorizontalAlignment="Center" FlowDirection="LeftToRight" Foreground="{StaticResource BrushMuted}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="البيان / التفاصيل" Width="1.7*">
                    <DataGridTemplateColumn.HeaderTemplate>
                      <DataTemplate><TextBlock Text="البيان / التفاصيل" HorizontalAlignment="Center" TextAlignment="Center" FontWeight="SemiBold" FontSize="12.5" /></DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Note}" Style="{StaticResource TableTextCell}" ToolTip="{Binding Note}" HorizontalAlignment="Stretch" TextAlignment="Center" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>

                  <DataGridTemplateColumn Header="نوع الحركة" Width="125">
                    <DataGridTemplateColumn.HeaderTemplate>
                      <DataTemplate><TextBlock Text="نوع الحركة" HorizontalAlignment="Center" TextAlignment="Center" FontWeight="SemiBold" FontSize="12.5" /></DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding TypeLabel}" HorizontalAlignment="Center" TextAlignment="Center" FontWeight="SemiBold" FontSize="13">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Foreground" Value="{StaticResource BrushMuted}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding TypeLabel}" Value="له"><Setter Property="Foreground" Value="{StaticResource BrushPositive}" /></DataTrigger>
                                <DataTrigger Binding="{Binding TypeLabel}" Value="عليه"><Setter Property="Foreground" Value="{StaticResource BrushNegative}" /></DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>

                  <DataGridTemplateColumn Header="المبلغ" Width="125">
                    <DataGridTemplateColumn.HeaderTemplate>
                      <DataTemplate><TextBlock Text="المبلغ" HorizontalAlignment="Center" TextAlignment="Center" FontWeight="SemiBold" FontSize="12.5" /></DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Amount,Converter={StaticResource PrivacyMoneyConverter}}" FlowDirection="LeftToRight" HorizontalAlignment="Center" TextAlignment="Center" FontWeight="SemiBold" FontSize="13">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource NumericCell}">
                              <Setter Property="Foreground" Value="{StaticResource BrushText}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Amount}" Value="0">
                                  <Setter Property="Foreground" Value="{StaticResource BrushMuted}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>

                  <DataGridTemplateColumn Header="{DynamicResource ColDebit}" Width="105">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Debit,Converter={StaticResource PrivacyMoneyConverter}}" Foreground="#EF4444" FlowDirection="LeftToRight" HorizontalAlignment="Right" TextAlignment="Right" FontWeight="SemiBold" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="{DynamicResource ColCredit}" Width="105">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Credit,Converter={StaticResource PrivacyMoneyConverter}}" Foreground="#10B981" FlowDirection="LeftToRight" HorizontalAlignment="Right" TextAlignment="Right" FontWeight="SemiBold" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="الوقت والتاريخ" Width="185">
                    <DataGridTemplateColumn.HeaderTemplate>
                      <DataTemplate><TextBlock Text="الوقت والتاريخ" HorizontalAlignment="Center" TextAlignment="Center" FontWeight="SemiBold" FontSize="12.5" /></DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding OccurredAt,Converter={StaticResource LedgerDateTimeConverter}}" HorizontalAlignment="Center" TextAlignment="Center" FlowDirection="LeftToRight" Foreground="{StaticResource BrushMuted}" FontSize="12.5" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>

                  <DataGridTemplateColumn Header="الإجمالي التراكمي" Width="160">
                    <DataGridTemplateColumn.HeaderTemplate>
                      <DataTemplate><TextBlock Text="الإجمالي التراكمي" HorizontalAlignment="Center" TextAlignment="Center" FontWeight="SemiBold" FontSize="12.5" /></DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding CumulativeBalance,Converter={StaticResource PrivacyMoneyConverter}}" FlowDirection="LeftToRight" HorizontalAlignment="Center" TextAlignment="Center" FontWeight="SemiBold">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource NumericCell}">
                              <Setter Property="Foreground" Value="{StaticResource BrushAccent2}" />
                              <Setter Property="FontSize" Value="13.5" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding CumulativeBalance}" Value="0">
                                  <Setter Property="Foreground" Value="{StaticResource BrushMuted}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="إجراءات" Width="112">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="واتساب" Padding="5,2" Margin="1" ToolTip="إرسال السند عبر واتساب" Command="{Binding DataContext.SendVoucherWhatsAppCommand,RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" CommandParameter="{Binding Operation}" />

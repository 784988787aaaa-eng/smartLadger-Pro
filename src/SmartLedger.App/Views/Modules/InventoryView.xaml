ius="6" Padding="8" Margin="2"><StackPanel><TextBlock Text="منصرف المخزون" Style="{StaticResource KpiLabel}" /><TextBlock Text="{Binding SelectedProductOutgoingQuantity,Converter={StaticResource PrivacyMoneyConverter}}" FontWeight="SemiBold" Margin="0,3,0,0" /></StackPanel></Border></UniformGrid></Grid></Border>
          <Border Grid.Row="2" Background="#0B162C" BorderBrush="{StaticResource BrushLine}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,8"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock Text="إضافة دفعة مخزنية" FontWeight="SemiBold" Margin="2,0,0,5" /><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Text="{Binding NewBatchNumber,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" Height="36" Margin="2" ToolTip="رقم الدفعة (اختياري)" FlowDirection="LeftToRight" TextAlignment="Right" /><TextBox Grid.Column="1" Text="{Binding NewBatchQuantity,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumericField}" Height="36" Margin="2" ToolTip="الكمية بالوحدة الأساسية" FlowDirection="LeftToRight" TextAlignment="Right" /><TextBox Grid.Column="2" Text="{Binding NewBatchCost,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumericField}" Height="36" Margin="2" ToolTip="تكلفة الوحدة" FlowDirection="LeftToRight" TextAlignment="Right" /><TextBox Grid.Column="3" Text="{Binding NewBatchExpiry,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" Height="36" Margin="2" ToolTip="انتهاء الصلاحية (اختياري)" FlowDirection="LeftToRight" TextAlignment="Right" /><Button Grid.Column="4" Content="إضافة" Command="{Binding AddStockBatchCommand}" Style="{StaticResource PrimaryButton}" Height="36" Padding="8,0" Margin="2" /></Grid></Grid></Border><TabControl Grid.Row="3" MinHeight="0" ClipToBounds="True" Background="{StaticResource BrushSurface}" Foreground="{StaticResource BrushText}" BorderBrush="{StaticResource BrushCardBorder}"><TabControl.Resources><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{StaticResource BrushSurface2}" /><Setter Property="Foreground" Value="{StaticResource BrushText}" /><Setter Property="BorderBrush" Value="{StaticResource BrushCardBorder}" /><Setter Property="Padding" Value="8,6" /><Setter Property="HorizontalContentAlignment" Value="Right" /></Style><Style TargetType="TabItem"><Setter Property="Background" Value="#162235" /><Setter Property="Foreground" Value="{StaticResource BrushText}" /><Setter Property="Padding" Value="12,7" /><Setter Property="BorderBrush" Value="{StaticResource BrushCardBorder}" /><Setter Property="BorderThickness" Value="0,0,0,2" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabChrome" Property="Background" Value="#1B3048" /><Setter TargetName="TabChrome" Property="BorderBrush" Value="#00B4D8" /><Setter TargetName="TabChrome" Property="BorderThickness" Value="0,0,0,3" /><Setter Property="Foreground" Value="#FFFFFF" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabChrome" Property="Background" Value="#20344D" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></TabControl.Resources><TabItem Header="بطاقة الحركة"><DataGrid ItemsSource="{Binding SelectedProductMovements}" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column" FlowDirection="RightToLeft" RowHeight="40" HorizontalScrollBarVisibility="Disabled"><DataGrid.Columns><DataGridTextColumn Header="الوقت والتاريخ" Binding="{Binding OccurredAt,Converter={StaticResource ArabicDateTimeConverter}}" Width="120" ElementStyle="{StaticResource TableTextCell}" /><DataGridTextColumn Header="نوع الحركة" Binding="{Binding TypeLabel}" Width="100" ElementStyle="{StaticResource TableTextCell}" /><DataGridTextColumn Header="{DynamicResource ColQty}" Binding="{Binding QuantitySmallUnits,Converter={StaticResource PrivacyMoneyConverter}}" Width="75" ElementStyle="{StaticResource NumericCell}" /><DataGridTextColumn Header="الرصيد المتراكم" Binding="{Binding RunningBalance,Converter={StaticResource PrivacyMoneyConverter}}" Width="105" ElementStyle="{StaticResource NumericCell}" /><DataGridTextColumn Header="البيان" Binding="{Binding Note}" Width="1.2*" ElementStyle="{StaticResource TableTextCell}" /></DataGrid.Columns></DataGrid></TabItem><TabItem Header="الدفعات النشطة"><DataGrid ItemsSource="{Binding SelectedProductBatches}" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column" FlowDirection="RightToLeft" RowHeight="40" AlternatingRowBackground="#111E32" RowBackground="#0B162C" GridLinesVisibility="Vertical" HorizontalGridLinesBrush="#1E293B" VerticalGridLinesBrush="#1E293B" HorizontalScrollBarVisibility="Auto"><DataGrid.Columns><DataGridTextColumn Header="رقم الدفعة" Binding="{Binding BatchNumber}" Width="Auto" MinWidth="100" ElementStyle="{StaticResource TableTextCell}" /><DataGridTextColumn Header="تاريخ الإدخال" Binding="{Binding CreatedAt,Converter={StaticResource ArabicDateTimeConverter}}" Width="140" ElementStyle="{StaticResource TableTextCell}" /><DataGridTextColumn Header="المتبقي بالمخزون" Binding="{Binding QuantityMinor,Converter={StaticResource PrivacyMoneyConverter}}" Width="Auto" MinWidth="105" ElementStyle="{StaticResource NumericCell}" /><DataGridTextColumn Header="تكلفة الوحدة" Binding="{Binding CostPrice,Converter={StaticResource PrivacyMoneyConverter}}" Width="100" ElementStyle="{StaticResource NumericCell}" /><DataGridTextColumn Header="تاريخ الانتهاء" Binding="{Binding ExpiryDate,Converter={StaticResource ArabicDateTimeConverter}}" Width="120" ElementStyle="{StaticResource TableTextCell}" /><DataGridTextColumn Header="مرجع الشراء" Binding="{Binding PurchaseInvoiceRef}" Width="Auto" MinWidth="100" ElementStyle="{StaticResource TableTextCell}" /></DataGrid.Columns></DataGrid></TabItem></TabControl>
        </Grid></Border>
      </Grid>
            <Grid Style="{StaticResource DialogOverlay}" Visibility="{Binding IsDialogOpen,Converter={StaticResource BoolToVisibility}}"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource ProductDialogControlTemplate}" /></Grid>
    </Grid>
  </DataTemplate></ResourceDictionary>
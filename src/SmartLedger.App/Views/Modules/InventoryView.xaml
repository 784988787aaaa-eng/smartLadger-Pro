      <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False"><StackPanel DockPanel.Dock="Right"><TextBlock Text="المخزون" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="الأصناف، الوحدات والأسعار وحركة البضاعة" Style="{StaticResource CaptionText}" /></StackPanel><Button DockPanel.Dock="Left" Content="+ إضافة صنف" Command="{Binding OpenAddCommand}" Style="{StaticResource PrimaryButton}" Width="155" Height="42" AutomationProperties.AutomationId="Btn_OpenNewProductDialog" Margin="8,0,0,0" /><TextBox DockPanel.Dock="Left" Width="250" VerticalContentAlignment="Center" Style="{StaticResource Field}" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" behaviors:FocusRequestBehavior.RequestFocus="{Binding IsSearchFocusRequested,Mode=TwoWay}" ToolTip="بحث بالباركود أو اسم الصنف أو التصنيف (Ctrl+F)" /></DockPanel>

              <DataGridTextColumn Header="{DynamicResource ColBarcode}" Binding="{Binding Barcode}" Width="Auto" MinWidth="110"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource TableTextCell}"><Setter Property="FlowDirection" Value="LeftToRight" /><Setter Property="TextAlignment" Value="Left" /><Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="ToolTip" Value="{Binding Barcode}" /></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="{DynamicResource ColCategory}" Binding="{Binding Category}" Width="120" ElementStyle="{StaticResource TableTextCell}" />
              <DataGridTemplateColumn Header="{DynamicResource ColStock}" Width="Auto" MinWidth="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding StockDisplay}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource TableTextCell}"><Setter Property="Foreground" Value="{StaticResource BrushPositive}" /><Style.Triggers><DataTrigger Binding="{Binding AvailabilityLabel}" Value="منخفض"><Setter Property="Foreground" Value="#F5B84B" /></DataTrigger><DataTrigger Binding="{Binding AvailabilityLabel}" Value="نفد"><Setter Property="Foreground" Value="{StaticResource BrushNegative}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTextColumn Header="{DynamicResource ColCost}" Binding="{Binding PurchasePrice,Converter={StaticResource PrivacyMoneyConverter}}" ElementStyle="{StaticResource NumericCell}" Width="Auto" MinWidth="90" /> 
              <DataGridTextColumn Header="{DynamicResource ColRetail}" Binding="{Binding SellingPriceMinor,Converter={StaticResource PrivacyMoneyConverter}}" ElementStyle="{StaticResource NumericCell}" Width="Auto" MinWidth="90" /> <DataGridTextColumn Header="{DynamicResource ColWholesale}" Binding="{Binding SellingPriceMajor,Converter={StaticResource PrivacyMoneyConverter}}" ElementStyle="{StaticResource NumericCell}" Width="Auto" MinWidth="90" /> 

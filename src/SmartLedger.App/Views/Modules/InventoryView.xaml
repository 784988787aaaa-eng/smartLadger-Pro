      <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.85*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="8" Margin="0,0,6,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="44" /></Grid.RowDefinitions><WrapPanel Grid.Row="0" Margin="2,0,2,8"><Button Content="الكل" Command="{Binding SetFilterCommand}" CommandParameter="All" Style="{StaticResource GhostButton}" Padding="12,5" Margin="2" /><Button Content="متوفر" Command="{Binding SetFilterCommand}" CommandParameter="InStock" Style="{StaticResource GhostButton}" Padding="12,5" Margin="2" /><Button Content="منخفض" Command="{Binding SetFilterCommand}" CommandParameter="LowStock" Style="{StaticResource GhostButton}" Padding="12,5" Margin="2" /><Button Content="منتهي المخزون" Command="{Binding SetFilterCommand}" CommandParameter="OutOfStock" Style="{StaticResource GhostButton}" Padding="12,5" Margin="2" /></WrapPanel>
          <DataGrid Grid.Row="1" FlowDirection="RightToLeft" ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct,Mode=TwoWay}" AlternationCount="10000" AlternatingRowBackground="#111E32" RowBackground="#0B162C" GridLinesVisibility="Vertical" HorizontalGridLinesBrush="#1E293B" VerticalGridLinesBrush="#1E293B" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" RowHeight="46" SelectionUnit="FullRow">

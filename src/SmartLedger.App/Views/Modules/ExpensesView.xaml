<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:SmartLedger.App.ViewModels" xmlns:behaviors="clr-namespace:SmartLedger.App.Behaviors" xmlns:local="clr-namespace:SmartLedger.App.Converters" xmlns:core="clr-namespace:SmartLedger.Core.Models;assembly=SmartLedger.Core"><DataTemplate DataType="{x:Type vm:ExpensesViewModel}">
    <Grid FlowDirection="RightToLeft"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><DockPanel Margin="0,0,0,8"><StackPanel DockPanel.Dock="Right"><TextBlock Text="المصروفات" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="تسجيل ومراجعة المصروفات بشكل واضح وسريع" Style="{StaticResource CaptionText}" /></StackPanel><Button DockPanel.Dock="Left" Content="+ تسجيل نفقة" Command="{Binding OpenAddCommand}" Style="{StaticResource PrimaryButton}" Width="130" AutomationProperties.AutomationId="Btn_OpenNewExpenseDialog" /></DockPanel><Border Grid.Row="1" Style="{StaticResource ElevatedCard}" Padding="14" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="إجمالي المقبوضات النقدية اليوم" Style="{StaticResource CaptionText}" /><TextBlock Text="{Binding CashSummary.CashIn,Converter={StaticResource PrivacyMoneyConverter}}" Style="{StaticResource MetricText}" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="إجمالي المدفوعات النقدية اليوم" Style="{StaticResource CaptionText}" /><TextBlock Text="{Binding CashSummary.CashOut,Converter={StaticResource PrivacyMoneyConverter}}" Style="{StaticResource MetricText}" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="رصيد الصندوق التقديري" Style="{StaticResource CaptionText}" /><TextBlock Text="{Binding CashSummary.Balance,Converter={StaticResource PrivacyMoneyConverter}}" Style="{StaticResource MetricText}" Foreground="#10B981" /></StackPanel></Grid></Border><Border Grid.Row="2" Style="{StaticResource Card}" Padding="8"><DataGrid ItemsSource="{Binding Expenses}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" AlternationCount="2" RowBackground="#0B162C" AlternatingRowBackground="#111E32" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#223752"><DataGrid.Columns><DataGridTemplateColumn Header="{DynamicResource ColCategory}" Width="190"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="#172B46" BorderBrush="#2A4568" BorderThickness="1" CornerRadius="9" Padding="9,3" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="{Binding Category}" Foreground="#C8D9EE" TextAlignment="Center" /></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="المبلغ" Binding="{Binding Amount,Converter={StaticResource PrivacyMoneyConverter}}" ElementStyle="{StaticResource NumericCell}" Width="160" /><DataGridTextColumn Header="التاريخ" Binding="{Binding OccurredAt,Converter={StaticResource ArabicDateTimeConverter}}" Width="180" ElementStyle="{StaticResource TableTextCell}" /><DataGridTextColumn Header="البيان" Binding="{Binding Note}" Width="1.4*" ElementStyle="{StaticResource TableTextCell}" /></DataGrid.Columns></DataGrid></Border><Grid Style="{StaticResource DialogOverlay}" Visibility="{Binding IsDialogOpen,Converter={StaticResource BoolToVisibility}}"><ContentControl Content="{Binding}" ContentTemplate="{DynamicResource ExpenseVoucherDialogTemplate}" /></Grid></Grid>
  </DataTemplate></ResourceDictionary>
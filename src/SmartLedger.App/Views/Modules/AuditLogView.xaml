<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:SmartLedger.App.ViewModels" xmlns:behaviors="clr-namespace:SmartLedger.App.Behaviors" xmlns:local="clr-namespace:SmartLedger.App.Converters" xmlns:core="clr-namespace:SmartLedger.Core.Models;assembly=SmartLedger.Core"><DataTemplate DataType="{x:Type vm:AuditLogViewModel}">
    <Grid FlowDirection="RightToLeft"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Border Style="{StaticResource ElevatedCard}" Padding="16" Margin="0,0,0,14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel Margin="2,0,2,12"><TextBlock Text="سجل التدقيق" FontSize="23" FontWeight="Bold" Foreground="{StaticResource BrushText}" TextAlignment="Right" /><TextBlock Text="مراجعة أنشطة المستخدمين والتغييرات المسجلة في النظام" Style="{StaticResource CaptionText}" TextAlignment="Right" Margin="0,4,0,0" /></StackPanel><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions><StackPanel Margin="4"><TextBlock Text="من تاريخ" Style="{StaticResource SectionLabel}" /><DatePicker SelectedDate="{Binding FromDate}" Height="40" /></StackPanel><StackPanel Grid.Column="1" Margin="4"><TextBlock Text="إلى تاريخ" Style="{StaticResource SectionLabel}" /><DatePicker SelectedDate="{Binding ToDate}" Height="40" /></StackPanel><StackPanel Grid.Column="2" Margin="4"><TextBlock Text="بحث في المستخدم أو العملية أو التفاصيل" Style="{StaticResource SectionLabel}" /><TextBox Style="{StaticResource Field}" Text="{Binding TextFilter,UpdateSourceTrigger=PropertyChanged}" ToolTip="يمكن البحث بالقيمة العربية أو الأصلية المسجلة" /></StackPanel><Button Grid.Column="3" Content="بحث" Command="{Binding SearchCommand}" Style="{StaticResource PrimaryButton}" Margin="8,23,4,0" Height="40" /></Grid></Grid></Border>
      <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6"><DataGrid FlowDirection="RightToLeft" ItemsSource="{Binding Entries}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" RowHeight="44" MinRowHeight="44" GridLinesVisibility="Horizontal" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><DataGrid.Columns><DataGridTextColumn Header="{DynamicResource ColDateTime}" Binding="{Binding OccurredAt,Converter={StaticResource AuditDisplayConverter},ConverterParameter=Date}" Width="190" MinWidth="185" ElementStyle="{StaticResource TableTextCell}" /><DataGridTextColumn Header="{DynamicResource ColActor}" Binding="{Binding UserName}" Width="1.1*" MinWidth="120" ElementStyle="{StaticResource TableTextCell}" /><DataGridTextColumn Header="العملية" Binding="{Binding Action,Converter={StaticResource AuditDisplayConverter},ConverterParameter=Action}" Width="1.15*" MinWidth="125" ElementStyle="{StaticResource TableTextCell}" /><DataGridTextColumn Header="الكيان" Binding="{Binding EntityType,Converter={StaticResource AuditDisplayConverter},ConverterParameter=Entity}" Width="0.9*" MinWidth="95" ElementStyle="{StaticResource TableTextCell}" /><DataGridTextColumn Header="المعرّف" Binding="{Binding EntityId}" Width="155" MinWidth="110" ElementStyle="{StaticResource TableTextCell}" /><DataGridTextColumn Header="{DynamicResource ColDetails}" Binding="{Binding Details,Converter={StaticResource AuditDisplayConverter},ConverterParameter=Details}" Width="2.2*" MinWidth="200" ElementStyle="{StaticResource TableTextCell}" /></DataGrid.Columns></DataGrid></Border><TextBlock Grid.Row="2" Text="{Binding StatusText}" Foreground="{StaticResource BrushMuted}" TextWrapping="Wrap" Margin="4,10,4,0" TextAlignment="Right" />
    </Grid>
  </DataTemplate></ResourceDictionary>
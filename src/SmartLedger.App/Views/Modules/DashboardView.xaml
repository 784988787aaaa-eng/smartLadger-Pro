<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:SmartLedger.App.ViewModels" xmlns:behaviors="clr-namespace:SmartLedger.App.Behaviors" xmlns:local="clr-namespace:SmartLedger.App.Converters" xmlns:core="clr-namespace:SmartLedger.Core.Models;assembly=SmartLedger.Core"><DataTemplate DataType="{x:Type vm:DashboardViewModel}">
    <Grid FlowDirection="RightToLeft">
      <Grid.RowDefinitions>
        <RowDefinition Height="130" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="0,0,0,16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,6,0">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid Grid.Row="0"><TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,44,0" Text="صافي المركز المالي" TextAlignment="Right" FlowDirection="RightToLeft" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushMuted}" /><Border Width="34" Height="34" HorizontalAlignment="Left" Background="#16263D" CornerRadius="17"><TextBlock Text="◆" Foreground="{StaticResource BrushAccent2}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" /></Border></Grid>
            <TextBlock Grid.Row="1" Text="{Binding Summary.NetBalance,Converter={StaticResource PrivacyMoneyConverter}}" TextAlignment="Right" HorizontalAlignment="Stretch" FontSize="25" FontWeight="Bold" Margin="0,10,0,12" Foreground="{Binding Summary.NetBalance,Converter={StaticResource NetBalanceBrushConverter}}" FlowDirection="LeftToRight" />
            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><Border Grid.Column="0" Background="#101F1D" BorderBrush="#1A4038" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,4,0"><StackPanel Orientation="Horizontal"><TextBlock Text="لنا" Foreground="#10B981" FontWeight="SemiBold" /><TextBlock Text="  " /><TextBlock Text="{Binding Summary.OwedToUs,Converter={StaticResource PrivacyMoneyConverter}}" Foreground="#10B981" FlowDirection="LeftToRight" /></StackPanel></Border><Border Grid.Column="1" Background="#241719" BorderBrush="#4A2529" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="4,0,0,0"><StackPanel Orientation="Horizontal"><TextBlock Text="علينا" Foreground="#EF4444" FontWeight="SemiBold" /><TextBlock Text="  " /><TextBlock Text="{Binding Summary.WeOwe,Converter={StaticResource PrivacyMoneyConverter}}" Foreground="#EF4444" FlowDirection="LeftToRight" /></StackPanel></Border></Grid>
          </Grid>
        </Border>
        <Border Grid.Column="1" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="12" Padding="18" Margin="6,0">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid Grid.Row="0"><TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,44,0" Text="نشاط اليوم" TextAlignment="Right" FlowDirection="RightToLeft" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushMuted}" /><Border Width="34" Height="34" HorizontalAlignment="Left" Background="#16263D" CornerRadius="17"><TextBlock Text="↗" Foreground="{StaticResource BrushAccent2}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17" FontWeight="Bold" /></Border></Grid>
            <TextBlock Grid.Row="1" Text="{Binding Summary.SalesToday,Converter={StaticResource PrivacyMoneyConverter}}" TextAlignment="Right" HorizontalAlignment="Stretch" FontSize="25" FontWeight="Bold" Margin="0,10,0,12" Foreground="{StaticResource BrushAccent2}" FlowDirection="LeftToRight" />
            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><Border Grid.Column="0" Background="#241719" BorderBrush="#4A2529" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,4,0"><StackPanel Orientation="Horizontal"><TextBlock Text="مصروفات" Foreground="#EF4444" FontSize="11" /><TextBlock Text="  " /><TextBlock Text="{Binding Summary.ExpensesToday,Converter={StaticResource PrivacyMoneyConverter}}" Foreground="#EF4444" FontSize="11" FlowDirection="LeftToRight" /></StackPanel></Border><Border Grid.Column="1" Background="#121D2D" BorderBrush="#22354F" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="4,0,0,0"><StackPanel Orientation="Horizontal"><TextBlock Text="حركات" Foreground="{StaticResource BrushMuted}" FontSize="11" /><TextBlock Text="  " /><TextBlock Text="{Binding Summary.OperationsToday}" Foreground="White" FontSize="12" /></StackPanel></Border></Grid>
          </Grid>
        </Border>
        <Border Grid.Column="2" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="12" Padding="18" Margin="6,0,0,0">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid Grid.Row="0"><TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,44,0" Text="قيمة بضاعة المخزون" TextAlignment="Right" FlowDirection="RightToLeft" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushMuted}" /><Border Width="34" Height="34" HorizontalAlignment="Left" Background="#16263D" CornerRadius="17"><TextBlock Text="▦" Foreground="{StaticResource BrushAccent2}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" /></Border></Grid><TextBlock Grid.Row="1" Text="{Binding Summary.StockValue,Converter={StaticResource PrivacyMoneyConverter}}" TextAlignment="Right" HorizontalAlignment="Stretch" FontSize="25" FontWeight="Bold" Margin="0,10,0,3" Foreground="{StaticResource BrushAccent2}" FlowDirection="LeftToRight" /><Grid Grid.Row="2" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock HorizontalAlignment="Stretch" Text="الأصول التشغيلية الحالية" TextAlignment="Right" FlowDirection="RightToLeft" FontSize="11" Foreground="{StaticResource BrushMuted}" VerticalAlignment="Bottom" /><Border Grid.Column="1" Background="#11263A" CornerRadius="7" Padding="8,5"><TextBlock Text="المخزون" FontSize="10" Foreground="{StaticResource BrushAccent2}" /></Border></Grid></Grid>
        </Border>
      </Grid>

      <Border Grid.Row="1" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,16">
        <StackPanel><TextBlock HorizontalAlignment="Right" Text="الإجراءات السريعة" TextAlignment="Right" FlowDirection="RightToLeft" FontSize="15" FontWeight="Bold" Margin="0,0,0,10" /><ItemsControl ItemsSource="{Binding DataContext.QuickActions, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" FlowDirection="RightToLeft"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Command="{Binding Command}" ToolTip="{Binding Label}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource GhostButton}"><Setter Property="Height" Value="50" /><Setter Property="Margin" Value="4" /><Setter Property="Padding" Value="10,6" /></Style></Button.Style><Grid FlowDirection="RightToLeft"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /><Border Grid.Column="1" Width="32" Height="24" CornerRadius="4" Background="#0B1220" BorderBrush="#26364D" BorderThickness="1" VerticalAlignment="Center"><TextBlock Text="{Binding Shortcut}" Foreground="#CBD5E1" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="LeftToRight" /></Border></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
      </Border>

      <Grid Grid.Row="2" Margin="0,0,0,12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.8*" /><ColumnDefinition Width="0" /></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="34" /></Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,0,0,10" HorizontalAlignment="Stretch">
              <TextBlock HorizontalAlignment="Right" Text="أحدث العمليات" TextAlignment="Right" FlowDirection="RightToLeft" FontSize="15" FontWeight="Bold" />
              <TextBlock HorizontalAlignment="Right" Text="آخر الحركات المسجلة في الدفتر" TextAlignment="Right" FlowDirection="RightToLeft" FontSize="11" Foreground="{StaticResource BrushMuted}" Margin="0,3,0,0" />
            </StackPanel>
            <Border Grid.Row="1" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="12">
              <DataGrid FlowDirection="RightToLeft" ItemsSource="{Binding Recent}" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" RowHeight="48" AlternationCount="1000000" BorderThickness="0">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="م" Width="48" MinWidth="48" CanUserResize="False"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}},Path=AlternationIndex,Converter={StaticResource SerialNumberConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="11.5" Foreground="{StaticResource BrushMuted}" FlowDirection="LeftToRight" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTextColumn Header="الحساب" Binding="{Binding PersonName}" Width="1.15*" ElementStyle="{StaticResource TableTextCell}" />
                  <DataGridTemplateColumn Header="المبلغ" Width="140"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Amount,Converter={StaticResource RecentOperationAmountConverter}}" Foreground="{Binding Type,Converter={StaticResource RecentOperationBrushConverter}}" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" FlowDirection="LeftToRight" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="نوع الحركة" Width="105"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="#17283D" BorderBrush="#2B4666" BorderThickness="1" CornerRadius="8" Padding="9,4" HorizontalAlignment="Center"><TextBlock Text="{Binding Type,Converter={StaticResource RecentOperationLabelConverter}}" Foreground="{Binding Type,Converter={StaticResource RecentOperationBrushConverter}}" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" /></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTextColumn Header="البيان / التفاصيل" Binding="{Binding Note}" Width="1.45*" ElementStyle="{StaticResource TableTextCell}" />
                  <DataGridTemplateColumn Header="{DynamicResource ColDateTime}" Width="178"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Date,Converter={StaticResource ArabicDateTimeConverter}}" HorizontalAlignment="Center" TextAlignment="Center" FlowDirection="LeftToRight" Foreground="{StaticResource BrushMuted}" FontSize="12.5" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
            </Border>
            <Border Grid.Row="2" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="10,0">
              <Grid FlowDirection="RightToLeft">
                <TextBlock Text="يتم عرض أحدث 10 قيود مسجلة" Foreground="{StaticResource BrushMuted}" FontSize="11" VerticalAlignment="Center" />
                
              </Grid>
            </Border>
          </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="0" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="1.25*" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Border Grid.Row="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,6">
            <StackPanel>
              <Grid Margin="2,0,0,10"><TextBlock HorizontalAlignment="Stretch" Text="النشاط اليومي" TextAlignment="Right" FlowDirection="RightToLeft" FontSize="15" FontWeight="Bold" /><Border Width="30" Height="30" HorizontalAlignment="Left" Background="#16263D" CornerRadius="15"><TextBlock Text="↗" Foreground="{StaticResource BrushAccent2}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" /></Border></Grid>
              <TextBlock HorizontalAlignment="Stretch" Text="ملخص الحركة المالية اليوم" TextAlignment="Right" FlowDirection="RightToLeft" FontSize="11" Foreground="{StaticResource BrushMuted}" Margin="0,0,0,10" />
              <Border Background="#121D2D" BorderBrush="#22354F" BorderThickness="1" CornerRadius="9" Padding="10,8" Margin="0,0,0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Width="26" Height="26" Background="#132A38" CornerRadius="13"><TextBlock Text="↗" Foreground="{StaticResource BrushPositive}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Grid.Column="1" HorizontalAlignment="Stretch" Text="مبيعات اليوم" TextAlignment="Right" FlowDirection="RightToLeft" Margin="10,0" VerticalAlignment="Center" Foreground="{StaticResource BrushMuted}" FontSize="12" /><TextBlock Grid.Column="2" Text="{Binding Summary.SalesToday,Converter={StaticResource PrivacyMoneyConverter}}" Foreground="{StaticResource BrushPositive}" FontWeight="SemiBold" FlowDirection="LeftToRight" VerticalAlignment="Center" /></Grid></Border>
              <Border Background="#121D2D" BorderBrush="#22354F" BorderThickness="1" CornerRadius="9" Padding="10,8" Margin="0,0,0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Width="26" Height="26" Background="#16263D" CornerRadius="13"><TextBlock Text="↙" Foreground="{StaticResource BrushAccent2}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Grid.Column="1" HorizontalAlignment="Stretch" Text="مشتريات اليوم" TextAlignment="Right" FlowDirection="RightToLeft" Margin="10,0" VerticalAlignment="Center" Foreground="{StaticResource BrushMuted}" FontSize="12" /><TextBlock Grid.Column="2" Text="{Binding Summary.PurchasesToday,Converter={StaticResource PrivacyMoneyConverter}}" Foreground="{StaticResource BrushAccent2}" FontWeight="SemiBold" FlowDirection="LeftToRight" VerticalAlignment="Center" /></Grid></Border>
              <Border Background="#121D2D" BorderBrush="#22354F" BorderThickness="1" CornerRadius="9" Padding="10,8" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Width="26" Height="26" Background="#2A1B20" CornerRadius="13"><TextBlock Text="−" Foreground="#EF4444" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" /></Border><TextBlock Grid.Column="1" HorizontalAlignment="Stretch" Text="مصروفات اليوم" TextAlignment="Right" FlowDirection="RightToLeft" Margin="10,0" VerticalAlignment="Center" Foreground="{StaticResource BrushMuted}" FontSize="12" /><TextBlock Grid.Column="2" Text="{Binding Summary.ExpensesToday,Converter={StaticResource PrivacyMoneyConverter}}" Foreground="#EF4444" FontWeight="SemiBold" FlowDirection="LeftToRight" VerticalAlignment="Center" /></Grid></Border>
              <Border Background="#13263A" BorderBrush="#28506B" BorderThickness="1" CornerRadius="10" Padding="10,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock HorizontalAlignment="Stretch" Text="صافي الحركة التقديرية" TextAlignment="Right" FlowDirection="RightToLeft" Foreground="White" FontSize="12" FontWeight="SemiBold" /><TextBlock HorizontalAlignment="Stretch" Text="بعد المشتريات والمصروفات" TextAlignment="Right" FlowDirection="RightToLeft" Foreground="{StaticResource BrushMuted}" FontSize="10" Margin="0,2,0,0" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding DailyNetEstimate,Converter={StaticResource PrivacyMoneyConverter}}" Foreground="{Binding DailyNetEstimate,Converter={StaticResource NetBalanceBrushConverter}}" FontSize="16" FontWeight="Bold" FlowDirection="LeftToRight" VerticalAlignment="Center" /></Grid></Border>
            </StackPanel>
          </Border>
          <Border Grid.Row="1" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,6,0,0">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
              <Grid Margin="2,0,0,8"><TextBlock HorizontalAlignment="Stretch" Text="مؤشر السيولة السريعة" TextAlignment="Right" FlowDirection="RightToLeft" FontSize="15" FontWeight="Bold" /><Border Width="30" Height="30" HorizontalAlignment="Left" Background="#16263D" CornerRadius="15"><TextBlock Text="▣" Foreground="{StaticResource BrushAccent2}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></Grid>
              <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Width="34" Height="34" Background="#10263A" CornerRadius="17"><TextBlock Text="₿" Foreground="{StaticResource BrushAccent2}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" /></Border><StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center"><TextBlock HorizontalAlignment="Stretch" Text="حركة نقدية متوقعة" TextAlignment="Right" FlowDirection="RightToLeft" Foreground="{StaticResource BrushMuted}" FontSize="11" /><TextBlock HorizontalAlignment="Stretch" Text="مبني على نشاط اليوم" TextAlignment="Right" FlowDirection="RightToLeft" Foreground="{StaticResource BrushMuted}" FontSize="10" Margin="0,2,0,0" /></StackPanel><TextBlock Grid.Column="2" Text="{Binding DailyNetEstimate,Converter={StaticResource PrivacyMoneyConverter}}" Foreground="{Binding DailyNetEstimate,Converter={StaticResource NetBalanceBrushConverter}}" FontSize="17" FontWeight="Bold" FlowDirection="LeftToRight" VerticalAlignment="Center" /></Grid>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </DataTemplate></ResourceDictionary>
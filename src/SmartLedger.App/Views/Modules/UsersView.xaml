<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:SmartLedger.App.ViewModels" xmlns:behaviors="clr-namespace:SmartLedger.App.Behaviors" xmlns:local="clr-namespace:SmartLedger.App.Converters" xmlns:core="clr-namespace:SmartLedger.Core.Models;assembly=SmartLedger.Core"><DataTemplate DataType="{x:Type vm:UsersViewModel}">
    <Grid FlowDirection="RightToLeft">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Border Style="{StaticResource ElevatedCard}" Padding="16" Margin="0,0,0,14">
        <Grid FlowDirection="RightToLeft">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock Text="المستخدمون والصلاحيات" FontSize="22" FontWeight="Bold" TextAlignment="Right" />
            <TextBlock Text="إدارة حسابات الفريق وأدوار الوصول إلى وظائف النظام." Style="{StaticResource CaptionText}" Margin="0,5,0,0" TextAlignment="Right" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" FlowDirection="RightToLeft">
            <Button Content="+ مستخدم جديد" Command="{Binding NewCommand}" Style="{StaticResource PrimaryButton}" MinWidth="145" Margin="0,0,0,0" IsEnabled="{Binding CanManage}" />
            <Button Content="تعديل" Command="{Binding EditCommand}" Style="{StaticResource GhostButton}" Width="82" Margin="8,0,0,0" />
            <Button Content="تفعيل/تعطيل" Command="{Binding ToggleActiveCommand}" Style="{StaticResource GhostButton}" Width="112" Margin="8,0,0,0" IsEnabled="{Binding CanManage}" />
            <Button Content="حذف" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}" Width="76" Margin="8,0,0,0" IsEnabled="{Binding CanManage}" />
          </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8" ClipToBounds="True">
        <DataGrid FlowDirection="RightToLeft" ItemsSource="{Binding Users}" SelectedItem="{Binding Selected}" IsReadOnly="True" AutoGenerateColumns="False" RowHeight="54" MinRowHeight="54" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" HeadersVisibility="Column" CanUserAddRows="False" CanUserResizeRows="False" SelectionUnit="FullRow" ScrollViewer.VerticalScrollBarVisibility="Auto">
          <DataGrid.Columns>
            <DataGridTextColumn Header="{DynamicResource ColActor}" Binding="{Binding UserName}" Width="1.15*" MinWidth="150" ElementStyle="{StaticResource TableTextCell}" />
            <DataGridTextColumn Header="الاسم" Binding="{Binding DisplayName}" Width="1.45*" MinWidth="180" ElementStyle="{StaticResource TableTextCell}" />
            <DataGridTemplateColumn Header="الدور" Width="105" MinWidth="90">
              <DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="#172B46" BorderBrush="#2A4568" BorderThickness="1" CornerRadius="10" Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="مستخدم" TextAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="#C8D9EE"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="مستخدم" /><Style.Triggers><DataTrigger Binding="{Binding IsAdministrator}" Value="True"><Setter Property="Text" Value="مدير" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border></DataTemplate></DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="الحالة" Width="100" MinWidth="90">
              <DataGridTemplateColumn.CellTemplate><DataTemplate><Border CornerRadius="10" Padding="9,4" HorizontalAlignment="Center" VerticalAlignment="Center"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#332F3948" /><Setter Property="BorderBrush" Value="#526477" /><Setter Property="BorderThickness" Value="1" /><Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Background" Value="#2030A878" /><Setter Property="BorderBrush" Value="#5060C99A" /></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="متوقف" FontSize="12" Foreground="#FCA5A5" HorizontalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="متوقف" /><Setter Property="Foreground" Value="#FCA5A5" /><Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Text" Value="نشط" /><Setter Property="Foreground" Value="#6EE7B7" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border></DataTemplate></DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="{DynamicResource ColActions}" Width="250" MinWidth="250" MaxWidth="250" IsReadOnly="True">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="RightToLeft">
                    <Button Content="تعديل" Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" CommandParameter="{Binding}" ToolTip="تعديل بيانات المستخدم" Style="{StaticResource GhostButton}" Height="32" MinWidth="62" Padding="8,0" Margin="0,0,0,0" VerticalAlignment="Center" />
                    <Button Content="تعطيل" ToolTip="تعطيل هذا المستخدم" Height="32" MinWidth="68" Padding="7,0" Margin="6,0,0,0" VerticalAlignment="Center">
                      <Button.Style><Style TargetType="Button" BasedOn="{StaticResource GhostButton}"><Setter Property="Content" Value="تعطيل" /><Setter Property="Height" Value="32" /><Setter Property="MinWidth" Value="68" /><Setter Property="Padding" Value="7,0" /><Setter Property="Margin" Value="6,0,0,0" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Command" Value="{Binding DataContext.ToggleActiveCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" /><Setter Property="CommandParameter" Value="{Binding}" /><Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="False"><Setter Property="Content" Value="تفعيل" /></DataTrigger></Style.Triggers></Style></Button.Style>
                    </Button>
                    <Button Content="حذف" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" CommandParameter="{Binding}" ToolTip="حذف المستخدم" Style="{StaticResource DangerButton}" Height="32" MinWidth="54" Padding="8,0" Margin="6,0,0,0" VerticalAlignment="Center" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Border>
      <TextBlock Grid.Row="2" Text="{Binding StatusText}" Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center" Margin="4,10,4,0" TextAlignment="Right" />
      <Grid Style="{StaticResource DialogOverlay}" Visibility="{Binding IsDialogOpen,Converter={StaticResource BoolToVisibility}}">
        <Border Width="720" MaxWidth="900" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource DialogShell}" Padding="22">
          <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="720">
          <Grid behaviors:InputDialogBehavior.IsEnabled="True" FlowDirection="RightToLeft">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,16" FlowDirection="RightToLeft"><StackPanel><TextBlock Text="بيانات المستخدم" FontSize="22" FontWeight="SemiBold" TextAlignment="Right" /><TextBlock Text="بيانات الحساب والدور وصلاحيات الوصول." Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextAlignment="Right" /></StackPanel><Button Command="{Binding CancelCommand}" Style="{StaticResource IconButton}" DockPanel.Dock="Left" ToolTip="إغلاق" AutomationProperties.Name="إغلاق"><Path Width="14" Height="14" Stretch="Uniform" Stroke="#9DB7D4" StrokeThickness="1.6" Data="{StaticResource CloseIcon}" /></Button></DockPanel>
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel Margin="5"><TextBlock Text="اسم المستخدم" Style="{StaticResource SectionLabel}" TextAlignment="Right" /><TextBox Style="{StaticResource Field}" FlowDirection="LeftToRight" TextAlignment="Left" Text="{Binding UserName,UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
              <StackPanel Grid.Column="1" Margin="5"><TextBlock Text="الاسم الكامل" Style="{StaticResource SectionLabel}" TextAlignment="Right" /><TextBox Style="{StaticResource Field}" TextAlignment="Right" FlowDirection="RightToLeft" Text="{Binding DisplayName,UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
              <CheckBox Grid.Column="2" Content="مدير النظام" IsChecked="{Binding IsAdministrator}" VerticalAlignment="Center" Margin="14,18,8,0" IsEnabled="{Binding CanManage}" />
            </Grid></Border>
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
              <StackPanel Margin="5"><TextBlock Text="كلمة المرور الجديدة (اختيارية عند التعديل)" Style="{StaticResource SectionLabel}" TextAlignment="Right" /><PasswordBox Style="{StaticResource PasswordField}" behaviors:PasswordBoxBehavior.Password="{Binding Password,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
              <StackPanel Grid.Column="1" Margin="5"><TextBlock Text="تأكيد كلمة المرور" Style="{StaticResource SectionLabel}" TextAlignment="Right" /><PasswordBox Style="{StaticResource PasswordField}" behaviors:PasswordBoxBehavior.Password="{Binding ConfirmPassword,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
            </Grid></Border>
            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12"><StackPanel><TextBlock Text="صلاحيات العمل" FontSize="15" FontWeight="SemiBold" TextAlignment="Right" Margin="0,0,0,10" /><UniformGrid Columns="4" FlowDirection="RightToLeft">
              <CheckBox Content="عرض البيانات" IsChecked="{Binding AllowView}" Margin="6" />
              <CheckBox Content="إنشاء السجلات" IsChecked="{Binding AllowCreate}" Margin="6" />
              <CheckBox Content="تعديل السجلات" IsChecked="{Binding AllowEdit}" Margin="6" />
              <CheckBox Content="حذف السجلات" IsChecked="{Binding AllowDelete}" Margin="6" />
              <CheckBox Content="التقارير" IsChecked="{Binding AllowReports}" Margin="6" />
            </UniformGrid></StackPanel></Border>
            <Border Grid.Row="4" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12"><StackPanel><TextBlock Text="إدارة النظام (للمدير فقط)" FontSize="15" FontWeight="SemiBold" TextAlignment="Right" Margin="0,0,0,10" /><UniformGrid Columns="3" FlowDirection="RightToLeft">
              <CheckBox Content="إدارة المستخدمين" IsChecked="{Binding AllowUsers}" Margin="6" IsEnabled="{Binding CanManage}" />
              <CheckBox Content="الإعدادات" IsChecked="{Binding AllowSettings}" Margin="6" IsEnabled="{Binding CanManage}" />
              <CheckBox Content="النسخ الاحتياطي" IsChecked="{Binding AllowBackup}" Margin="6" IsEnabled="{Binding CanManage}" />
            </UniformGrid></StackPanel></Border>
            <TextBlock Grid.Row="5" Text="{Binding StatusText}" Foreground="#FCA5A5" TextAlignment="Right" TextWrapping="Wrap" Margin="4,0,4,8" />
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Left" Margin="4,4,4,0"><Button Content="حفظ المستخدم" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Width="140" /><Button Content="إلغاء" Command="{Binding CancelCommand}" Style="{StaticResource GhostButton}" Width="100" Margin="8,0,0,0" /></StackPanel>
          </Grid>
          </ScrollViewer>
        </Border>
      </Grid>
    </Grid>
  </DataTemplate></ResourceDictionary>
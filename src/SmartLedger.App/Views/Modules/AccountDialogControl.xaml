<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:SmartLedger.App.ViewModels" xmlns:behaviors="clr-namespace:SmartLedger.App.Behaviors" xmlns:local="clr-namespace:SmartLedger.App.Converters" xmlns:core="clr-namespace:SmartLedger.Core.Models;assembly=SmartLedger.Core">
  <DataTemplate x:Key="AccountDialogControlTemplate">
<Grid Style="{StaticResource DialogOverlay}" Grid.Row="0" Grid.Column="0" Grid.RowSpan="999" Grid.ColumnSpan="999" Panel.ZIndex="1001" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="{Binding IsDialogOpen,Converter={StaticResource BoolToVisibility}}">
        <Border Width="620" MaxWidth="680" MaxHeight="760" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource DialogShell}" Padding="16">
          <Grid FlowDirection="RightToLeft" KeyboardNavigation.TabNavigation="Cycle" behaviors:InputDialogBehavior.IsEnabled="True" behaviors:InputDialogBehavior.EnterSavesOnRadio="True">
            <Grid.InputBindings>
              <KeyBinding Key="F5" Command="{Binding SaveNewCommand}" />
              <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveNewCommand}" />
              <KeyBinding Key="Escape" Command="{Binding CloseDialogCommand}" />
            </Grid.InputBindings>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

            <Grid Grid.Row="0" Height="38" Margin="0,0,0,10" FlowDirection="LeftToRight">
              <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /><ColumnDefinition Width="38" /></Grid.ColumnDefinitions>
              <Button Grid.Column="2" Command="{Binding CloseDialogCommand}" Style="{StaticResource IconButton}" ToolTip="إغلاق" AutomationProperties.Name="إغلاق" AutomationProperties.AutomationId="Btn_CloseAccountDialog" Width="36" Height="36">
                <Path Width="14" Height="14" Stretch="Uniform" Stroke="#9DB7D4" StrokeThickness="1.6" Data="{StaticResource CloseIcon}" />
              </Button>
              <TextBlock Grid.Column="1" Text="إضافة حساب جديد" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FlowDirection="RightToLeft" />
            </Grid>

            <Grid Grid.Row="1" KeyboardNavigation.TabNavigation="Local" MinHeight="0">
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

              <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,4,4">
                <TextBlock Text="اسم الحساب *" Style="{StaticResource SectionLabel}" Margin="0,0,0,3" />
                <TextBox Style="{StaticResource DialogField}" AutomationProperties.Name="اسم الحساب" Text="{Binding NewName,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="AccountNameInput" HorizontalContentAlignment="Right" Language="ar-SA" InputMethod.IsInputMethodEnabled="True" InputMethod.PreferredImeState="On" InputMethod.PreferredImeConversionMode="Native" Padding="10,4,8,4" CaretBrush="#EAF4FF" SelectionBrush="#356FB5" TabIndex="0" FlowDirection="RightToLeft" TextAlignment="Right" />
              </StackPanel>
              <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,0,0,4">
                <TextBlock Text="رمز الحساب (تلقائي)" Style="{StaticResource SectionLabel}" Margin="0,0,0,3" />
                <TextBox Style="{StaticResource DialogField}" Text="{Binding NewAccountCode}" IsReadOnly="True" AutomationProperties.Name="رمز الحساب" FlowDirection="LeftToRight" TextAlignment="Left" />
              </StackPanel>

              <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,4,4">
                <TextBlock Text="الدفتر" Style="{StaticResource SectionLabel}" Margin="0,0,0,3" />
                <ComboBox Style="{StaticResource DialogComboBox}" ItemsSource="{Binding BookGroups}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedGroupBook,Mode=TwoWay}" IsEditable="False" AutomationProperties.Name="الدفتر" TabIndex="1" Focusable="True" IsTabStop="True" KeyboardNavigation.DirectionalNavigation="Contained" behaviors:InputDialogBehavior.SpaceOpensComboBox="True" Background="#0B162C" Foreground="#EAF4FF" BorderBrush="#263E61" />
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,0,0,4">
                <TextBlock Text="{Binding Currency, StringFormat={}المبلغ ({0})}" Style="{StaticResource SectionLabel}" Margin="0,0,0,3" />
                <Grid Height="44">
                  <TextBox Style="{StaticResource DialogNumericField}" AutomationProperties.Name="المبلغ الافتتاحي" Text="{Binding OpeningBalanceText,UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" TextAlignment="Right" HorizontalContentAlignment="Right" Padding="9,4" FontSize="14" TabIndex="2" />
                  
                </Grid>
              </StackPanel>

              <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,4">
                <TextBlock Text="الملاحظات (اختياري)" Style="{StaticResource SectionLabel}" Margin="0,0,0,3" />
                <TextBox Style="{StaticResource DialogField}" AutomationProperties.Name="الملاحظات" Text="{Binding NewNote,UpdateSourceTrigger=PropertyChanged}" FlowDirection="RightToLeft" TextAlignment="Right" HorizontalContentAlignment="Right" TabIndex="3" />
              </StackPanel>

              <Grid Grid.Row="3" Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="1.15*" /></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                  <TextBlock Text="رقم الهاتف (اختياري)" Style="{StaticResource SectionLabel}" Margin="0,0,0,3" />
                  <TextBox Style="{StaticResource DialogField}" AutomationProperties.Name="رقم الهاتف" Text="{Binding NewPhone,UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" TextAlignment="Left" HorizontalContentAlignment="Left" TabIndex="4" Language="ar-SA" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                  <TextBlock Text="اتجاه الحركة" Style="{StaticResource SectionLabel}" Margin="0,0,0,3" />
                  <UniformGrid Columns="2" Height="44" FlowDirection="RightToLeft">
                    <RadioButton Content="له" GroupName="OpeningBalanceDirection" Height="44" TabIndex="5" Style="{StaticResource OpeningAgainstUsChoice}" IsChecked="{Binding OpeningBalanceAgainstUs}" Command="{Binding SelectOpeningAgainstUsCommand}" AutomationProperties.Name="له" />
                    <RadioButton Content="عليه" GroupName="OpeningBalanceDirection" Height="44" TabIndex="6" Style="{StaticResource OpeningForUsChoice}" IsChecked="{Binding OpeningBalanceForUs}" Command="{Binding SelectOpeningForUsCommand}" AutomationProperties.Name="عليه" />
                  </UniformGrid>
                </StackPanel>
              </Grid>
              <Grid Grid.Row="4" Grid.ColumnSpan="2" Margin="0,5,0,5">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                  <TextBlock Text="رقم هاتف إضافي (اختياري)" Style="{StaticResource SectionLabel}" Margin="0,0,0,3" />
                  <TextBox Style="{StaticResource DialogField}" Text="{Binding NewSecondaryPhone,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="رقم هاتف إضافي" Height="40" FlowDirection="LeftToRight" TextAlignment="Left" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                  <TextBlock Text="العنوان" Style="{StaticResource SectionLabel}" Margin="0,0,0,3" />
                  <TextBox Style="{StaticResource DialogField}" Text="{Binding NewAddress,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="العنوان" Height="40" FlowDirection="RightToLeft" TextAlignment="Right" />
                </StackPanel>
              </Grid>
              <Grid Grid.Row="5" Grid.ColumnSpan="2" Margin="0,0,0,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                  <TextBlock Text="حد الائتمان (اختياري)" Style="{StaticResource SectionLabel}" Margin="0,0,0,3" />
                  <TextBox Style="{StaticResource DialogNumericField}" Text="{Binding NewCreditLimit,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="حد الائتمان" Height="40" FlowDirection="LeftToRight" TextAlignment="Right" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                  <TextBlock Text="طبيعة الحساب" Style="{StaticResource SectionLabel}" Margin="0,0,0,3" />
                  <ComboBox Style="{StaticResource DialogComboBox}" SelectedValue="{Binding NewAccountNature}" SelectedValuePath="Tag" Height="40">
                    <ComboBoxItem Content="مرن" Tag="{x:Static core:AccountNature.Flexible}" />
                    <ComboBoxItem Content="مدين" Tag="{x:Static core:AccountNature.Debit}" />
                    <ComboBoxItem Content="دائن" Tag="{x:Static core:AccountNature.Credit}" />
                  </ComboBox>
                </StackPanel>
              </Grid>
              <CheckBox Grid.Row="6" Content="تفعيل واتساب لهذا الحساب" IsChecked="{Binding NewWhatsAppEnabled}" HorizontalAlignment="Right" Margin="0,2,0,5" Foreground="{StaticResource BrushText}" />
            </Grid>
            <Grid Grid.Row="2" Margin="0,6,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{StaticResource BrushMuted}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="210" FlowDirection="RightToLeft" />
              <StackPanel Grid.Column="0" Orientation="Horizontal" FlowDirection="RightToLeft">
                <Button Command="{Binding SaveAndNewCommand}" Content="حفظ ومتابعة" Width="112" Height="36" Margin="0,0,5,0" AutomationProperties.Name="حفظ ومتابعة">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSaving}" Value="True">
                          <Setter Property="Content" Value="جارٍ الحفظ…" />
                          <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                </Button>
                <Button Content="حفظ وإغلاق" Command="{Binding SaveAndCloseCommand}" Style="{StaticResource PrimaryButton}" Width="104" Height="36" Margin="0,0,5,0" AutomationProperties.Name="حفظ وإغلاق" />
                <Button Content="إلغاء" Command="{Binding CloseDialogCommand}" Style="{StaticResource GhostButton}" Width="68" Height="36" IsCancel="True" AutomationProperties.Name="إلغاء" />
              </StackPanel>
            </Grid>
          </Grid>
        </Border>
      </Grid>
  </DataTemplate>
</ResourceDictionary>
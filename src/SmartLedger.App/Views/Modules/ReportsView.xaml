<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:SmartLedger.App.ViewModels" xmlns:behaviors="clr-namespace:SmartLedger.App.Behaviors" xmlns:local="clr-namespace:SmartLedger.App.Converters" xmlns:core="clr-namespace:SmartLedger.Core.Models;assembly=SmartLedger.Core"><DataTemplate DataType="{x:Type vm:ReportsViewModel}">
    <Grid FlowDirection="RightToLeft"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <Border Style="{StaticResource ElevatedCard}" Padding="16" Margin="0,0,0,14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition Width="180" /><ColumnDefinition Width="110" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions><StackPanel Margin="4"><TextBlock Text="من تاريخ" Style="{StaticResource SectionLabel}" /><DatePicker SelectedDate="{Binding FromDate}" /></StackPanel><StackPanel Grid.Column="1" Margin="4"><TextBlock Text="إلى تاريخ" Style="{StaticResource SectionLabel}" /><DatePicker SelectedDate="{Binding ToDate}" /></StackPanel><StackPanel Grid.Column="2" Margin="4"><TextBlock Text="صيغة المستند" Style="{StaticResource SectionLabel}" /><ComboBox ItemsSource="{Binding PageKinds}" SelectedItem="{Binding SelectedPageKind}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel><Button Grid.Column="3" Content="تحديث" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButton}" Margin="8,21,4,0" /><Button Grid.Column="4" Content="تصدير Excel" Command="{Binding ExportExcelCommand}" Style="{StaticResource GhostButton}" Margin="4,21,0,0" /><StackPanel Grid.Row="1" Grid.ColumnSpan="5" Orientation="Horizontal" HorizontalAlignment="Left" Margin="4,10,4,0"><Button Content="اليوم" Command="{Binding SelectTodayCommand}" Style="{StaticResource GhostButton}" Width="72" Margin="0,0,6,0" /><Button Content="هذا الأسبوع" Command="{Binding SelectThisWeekCommand}" Style="{StaticResource GhostButton}" Width="100" Margin="0,0,6,0" /><Button Content="هذا الشهر" Command="{Binding SelectThisMonthCommand}" Style="{StaticResource GhostButton}" Width="92" Margin="0,0,6,0" /><Button Content="مخصص" Command="{Binding SelectCustomRangeCommand}" Style="{StaticResource GhostButton}" Width="76" Margin="0,0,12,0" /><Button Content="تصدير PDF" Command="{Binding ExportPdfCommand}" Style="{StaticResource PrimaryButton}" Width="125" Margin="0,0,8,0" /><TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" TextWrapping="Wrap" /></StackPanel></Grid></Border>
      <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14"><StackPanel><UniformGrid Columns="4" FlowDirection="RightToLeft" Margin="0,0,0,14"><Border Background="#10233D" BorderBrush="#28476B" BorderThickness="1" CornerRadius="8" Padding="10" Margin="3"><StackPanel><TextBlock Text="كشف حساب تفصيلي" FontWeight="SemiBold" /><TextBlock Text="حركات الحساب ضمن الفترة المحددة" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0" /></StackPanel></Border><Border Background="#10233D" BorderBrush="#28476B" BorderThickness="1" CornerRadius="8" Padding="10" Margin="3"><StackPanel><TextBlock Text="ملخص المبيعات والمشتريات" FontWeight="SemiBold" /><TextBlock Text="المبيعات والمشتريات والنفقات والأرصدة" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0" /></StackPanel></Border><Border Background="#10233D" BorderBrush="#28476B" BorderThickness="1" CornerRadius="8" Padding="10" Margin="3"><StackPanel><TextBlock Text="جرد وتقييم المخزون" FontWeight="SemiBold" /><TextBlock Text="اختر المخزون من شاشة الأصناف لمراجعة الكميات" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0" /></StackPanel></Border><Border Background="#10233D" BorderBrush="#28476B" BorderThickness="1" CornerRadius="8" Padding="10" Margin="3"><StackPanel><TextBlock Text="المصروفات والنفقات" FontWeight="SemiBold" /><TextBlock Text="راجع سجل المصروفات حسب التاريخ والفئة" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0" /></StackPanel></Border></UniformGrid><UniformGrid Columns="6" FlowDirection="RightToLeft"><StackPanel Margin="0,0,12,0"><TextBlock Text="المبيعات" Style="{StaticResource KpiLabel}" Foreground="{StaticResource BrushPositive}" /><TextBlock Text="{Binding Summary.Sales,Converter={StaticResource PrivacyMoneyConverter}}" Style="{StaticResource MetricText}" /></StackPanel><StackPanel Margin="4,0,8,0"><TextBlock Text="المشتريات" Style="{StaticResource KpiLabel}" Foreground="{StaticResource BrushWarning}" /><TextBlock Text="{Binding Summary.Purchases,Converter={StaticResource PrivacyMoneyConverter}}" Style="{StaticResource MetricText}" /></StackPanel><StackPanel Margin="8,0,4,0"><TextBlock Text="النفقات" Style="{StaticResource KpiLabel}" Foreground="{StaticResource BrushNegative}" /><TextBlock Text="{Binding Summary.Expenses,Converter={StaticResource PrivacyMoneyConverter}}" Style="{StaticResource MetricText}" /></StackPanel><StackPanel Margin="4"><TextBlock Text="لنا" Style="{StaticResource KpiLabel}" Foreground="{StaticResource BrushPositive}" /><TextBlock Text="{Binding Summary.Receivables,Converter={StaticResource PrivacyMoneyConverter}}" Style="{StaticResource MetricText}" /></StackPanel><StackPanel Margin="4"><TextBlock Text="علينا" Style="{StaticResource KpiLabel}" Foreground="{StaticResource BrushNegative}" /><TextBlock Text="{Binding Summary.Payables,Converter={StaticResource PrivacyMoneyConverter}}" Style="{StaticResource MetricText}" /></StackPanel><StackPanel Margin="8,0,0,0"><TextBlock Text="مؤشر الحركة (ليس ربحًا)" Style="{StaticResource KpiLabel}" Foreground="{StaticResource BrushAccent2}" /><TextBlock Text="{Binding MovementIndicator,Converter={StaticResource PrivacyMoneyConverter}}" Style="{StaticResource MetricText}" /></StackPanel></UniformGrid>        <Border Background="#0B162C" BorderBrush="#28476B" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,12,0,0">
  <StackPanel>
    <DockPanel Margin="0,0,0,10"><TextBlock Text="محركات التقارير المتخصصة" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" /><Button DockPanel.Dock="Left" Content="تصدير كشف الحساب PDF" Command="{Binding ExportAccountStatementPdfCommand}" Style="{StaticResource PrimaryButton}" Width="205" /></DockPanel>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <StackPanel Margin="3"><TextBlock Text="نوع التقرير" Style="{StaticResource SectionLabel}" /><ComboBox ItemsSource="{Binding ReportModes}" SelectedItem="{Binding SelectedReportMode,UpdateSourceTrigger=PropertyChanged}" Height="38" /></StackPanel>
      <StackPanel Grid.Column="1" Margin="3"><TextBlock Text="{DynamicResource ColStatementAccount}" Style="{StaticResource SectionLabel}" /><ComboBox ItemsSource="{Binding StatementAccounts}" SelectedItem="{Binding SelectedStatementAccount}" DisplayMemberPath="PersonName" Height="38" FlowDirection="RightToLeft" /></StackPanel>
      <StackPanel Grid.Column="2" Margin="3"><TextBlock Text="الرصيد الافتتاحي / الختامي" Style="{StaticResource SectionLabel}" /><StackPanel Orientation="Horizontal"><TextBlock Text="افتتاحي: " Foreground="{StaticResource BrushMuted}" /><TextBlock Text="{Binding OpeningBalance,Converter={StaticResource PrivacyMoneyConverter}}" FontWeight="SemiBold" /><TextBlock Text="  ختامي: " Margin="12,0,0,0" Foreground="{StaticResource BrushMuted}" /><TextBlock Text="{Binding ClosingBalance,Converter={StaticResource PrivacyMoneyConverter}}" FontWeight="SemiBold" /><TextBlock Text="{Binding ClosingBalanceDirection}" Margin="10,0,0,0" /></StackPanel></StackPanel>
    </Grid>
    <UniformGrid Columns="4" Margin="0,10,0,8">
      <StackPanel Margin="3"><TextBlock Text="إجمالي الكمية الفعلية" Style="{StaticResource KpiLabel}" /><TextBlock Text="{Binding TotalPhysicalStock,StringFormat={}{0:N2}}" Style="{StaticResource MetricText}" /></StackPanel>
      <StackPanel Margin="3"><TextBlock Text="قيمة المخزون بالتكلفة" Style="{StaticResource KpiLabel}" /><TextBlock Text="{Binding StockCostValuation,Converter={StaticResource PrivacyMoneyConverter}}" Style="{StaticResource MetricText}" /></StackPanel>
      <StackPanel Margin="3"><TextBlock Text="قيمة المخزون بسعر البيع" Style="{StaticResource KpiLabel}" /><TextBlock Text="{Binding StockRetailValuation,Converter={StaticResource PrivacyMoneyConverter}}" Style="{StaticResource MetricText}" /></StackPanel>
      <StackPanel Margin="3"><TextBlock Text="الربح الإجمالي المتوقع" Style="{StaticResource KpiLabel}" /><TextBlock Text="{Binding ExpectedGrossProfit,Converter={StaticResource PrivacyMoneyConverter}}" Style="{StaticResource MetricText}" Foreground="#10B981" /></StackPanel>
    </UniformGrid>
    <TextBlock Text="تحليل المصروفات حسب الفئة: الإجمالي والنسبة والنقدي والبنكي" FontWeight="SemiBold" Margin="3,4,3,6" />
    <DataGrid ItemsSource="{Binding ExpenseAnalysis}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" MaxHeight="150" HeadersVisibility="Column"><DataGrid.Columns><DataGridTextColumn Header="الفئة" Binding="{Binding Category}" Width="2*" /><DataGridTextColumn Header="الإجمالي" Binding="{Binding Total,Converter={StaticResource PrivacyMoneyConverter}}" Width="*" /><DataGridTextColumn Header="النسبة %" Binding="{Binding Percentage,StringFormat={}{0:N2}}" Width="*" /><DataGridTextColumn Header="نقدي" Binding="{Binding CashTotal,Converter={StaticResource PrivacyMoneyConverter}}" Width="*" /><DataGridTextColumn Header="بنكي" Binding="{Binding BankTotal,Converter={StaticResource PrivacyMoneyConverter}}" Width="*" /></DataGrid.Columns></DataGrid>
    <TextBlock Text="حركات كشف الحساب خلال الفترة المحددة" FontWeight="SemiBold" Margin="3,10,3,6" />
    <DataGrid ItemsSource="{Binding AccountStatementMovements}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" MaxHeight="180" HeadersVisibility="Column"><DataGrid.Columns><DataGridTextColumn Header="{DynamicResource ColStatementDateTime}" Binding="{Binding OccurredAt,Converter={StaticResource ArabicDateTimeConverter}}" Width="150" /><DataGridTextColumn Header="النوع" Binding="{Binding TypeLabel}" Width="120" /><DataGridTextColumn Header="{DynamicResource ColStatementDetails}" Binding="{Binding Note}" Width="2*" /><DataGridTextColumn Header="{DynamicResource ColStatementDebit}" Binding="{Binding Debit,Converter={StaticResource PrivacyMoneyConverter}}" Width="*" /><DataGridTextColumn Header="{DynamicResource ColStatementCredit}" Binding="{Binding Credit,Converter={StaticResource PrivacyMoneyConverter}}" Width="*" /><DataGridTextColumn Header="{DynamicResource ColStatementBalance}" Binding="{Binding RunningBalance,Converter={StaticResource PrivacyMoneyConverter}}" Width="*" /></DataGrid.Columns></DataGrid>
  </StackPanel>
</Border></StackPanel></Border>
      <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8"><DockPanel><StackPanel DockPanel.Dock="Top" Margin="8,5,8,12"><TextBlock Text="تفاصيل العمليات خلال الفترة" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="{Binding PeriodText}" Style="{StaticResource CaptionText}" /></StackPanel><DataGrid FlowDirection="RightToLeft" ItemsSource="{Binding Recent}" IsReadOnly="True"><DataGrid.Columns><DataGridTemplateColumn Header="م" Width="45"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}, Path=AlternationIndex, Converter={StaticResource SerialNumberConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontFamily="{StaticResource ArabicFont}" FontSize="11" FlowDirection="LeftToRight" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="{DynamicResource ColDateTime}" Binding="{Binding Date,Converter={StaticResource ArabicDateTimeConverter}}" Width="140" ElementStyle="{StaticResource TableTextCell}" /><DataGridTextColumn Header="الحساب" Binding="{Binding PersonName}" Width="1.2*" ElementStyle="{StaticResource TableTextCell}" /><DataGridTemplateColumn Header="نوع الحركة" Width="130"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Type}" HorizontalAlignment="Center" TextAlignment="Center" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="المبلغ" Width="140"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Amount,Converter={StaticResource PrivacyMoneyConverter}}" Foreground="{StaticResource BrushAccent2}" HorizontalAlignment="Center" TextAlignment="Center" FlowDirection="LeftToRight" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="البيان / التفاصيل" Binding="{Binding Note}" Width="1.8*" ElementStyle="{StaticResource TableTextCell}" /></DataGrid.Columns></DataGrid></DockPanel></Border>
    </Grid>
  </DataTemplate></ResourceDictionary>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:SmartLedger.App.ViewModels" xmlns:behaviors="clr-namespace:SmartLedger.App.Behaviors" xmlns:local="clr-namespace:SmartLedger.App.Converters" xmlns:core="clr-namespace:SmartLedger.Core.Models;assembly=SmartLedger.Core"><DataTemplate DataType="{x:Type vm:SalesViewModel}">
    <Grid FlowDirection="RightToLeft">
      <Grid.RowDefinitions><RowDefinition Height="*" /></Grid.RowDefinitions>
      <Border Grid.Row="0" Style="{StaticResource ElevatedCard}" Padding="24" Margin="0,0,0,4">
        <Grid FlowDirection="RightToLeft">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="لا توجد فواتير بيع بعد" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="نقطة بيع سريعة — امسح الباركود، اختر العميل، راجع الخصم ثم احفظ واطبع." Style="{StaticResource CaptionText}" TextWrapping="Wrap" MaxWidth="720" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,7,0,10" /><TextBlock Text="F1 الباركود  •  F2 العميل  •  F3 تبديل الوحدة  •  F4 الخصم  •  F5 حفظ وطباعة  •  F6 تعليق  •  Esc تفريغ" Style="{StaticResource CaptionText}" TextWrapping="Wrap" MaxWidth="900" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="إنشاء فاتورة بيع" Command="{Binding OpenNewCommand}" Style="{StaticResource PrimaryButton}" AutomationProperties.AutomationId="Btn_OpenNewSaleInvoice" Width="160" Height="36" Margin="4" /><Button Content="معاينة آخر إيصال" Command="{Binding PrintLastInvoiceCommand}" Style="{StaticResource GhostButton}" Width="145" Height="36" Margin="4" /><Button Content="طباعة مباشرة" Command="{Binding PrintDirectlyCommand}" Style="{StaticResource GhostButton}" Width="125" Height="36" Margin="4" /><Button Content="إرسال لواتساب" Command="{Binding SendWhatsAppCommand}" Style="{StaticResource GhostButton}" Width="135" Height="36" Margin="4" /></StackPanel>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Style="{StaticResource DialogOverlay}" Visibility="{Binding IsDialogOpen,Converter={StaticResource BoolToVisibility}}">
        <Border Width="1120" MaxHeight="900" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource DialogShell}" Padding="22"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Grid FlowDirection="RightToLeft" KeyboardNavigation.TabNavigation="Local" behaviors:InputDialogBehavior.IsEnabled="True">
            <Grid.InputBindings><KeyBinding Key="F1" Command="{Binding FocusBarcodeCommand}" /><KeyBinding Key="F2" Command="{Binding FocusCustomerCommand}" /><KeyBinding Key="F3" Command="{Binding ToggleSelectedUnitCommand}" /><KeyBinding Key="F4" Command="{Binding ApplyDiscountCommand}" /><KeyBinding Key="F5" Command="{Binding SaveAndPrintCommand}" /><KeyBinding Key="F6" Command="{Binding HoldInvoiceCommand}" /><KeyBinding Key="Escape" Command="{Binding ClearInvoiceCommand}" /><KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" /><KeyBinding Key="P" Modifiers="Control" Command="{Binding PrintLastInvoiceCommand}" /></Grid.InputBindings>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,8">
              <Button DockPanel.Dock="Left" Command="{Binding CloseDialogCommand}" Style="{StaticResource IconButton}" ToolTip="إغلاق" AutomationProperties.Name="إغلاق"><Path Width="14" Height="14" Stretch="Uniform" Stroke="#9DB7D4" StrokeThickness="1.6" Data="{StaticResource CloseIcon}" /></Button>
              <StackPanel><TextBlock Text="فاتورة بيع جديدة" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="أدخل بيانات الفاتورة بالترتيب ثم احفظ." Style="{StaticResource CaptionText}" /></StackPanel>
            </DockPanel>
            <Grid Grid.Row="1" Margin="0,0,0,12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="1.8*" /><ColumnDefinition Width="0.7*" /><ColumnDefinition Width="0.8*" /></Grid.ColumnDefinitions>
              <StackPanel Margin="4"><TextBlock Text="{DynamicResource ColBarcode}" Style="{StaticResource SectionLabel}" /><TextBox x:Name="SaleBarcodeInput" AutomationProperties.AutomationId="SaleBarcodeInput" Style="{StaticResource Field}" Text="{Binding BarcodeInput,UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" AutomationProperties.Name="باركود الصنف" TextAlignment="Left"><TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding AddScannedBarcodeCommand}" /></TextBox.InputBindings></TextBox></StackPanel>
              <StackPanel Grid.Column="1" Margin="4"><TextBlock Text="العميل" Style="{StaticResource SectionLabel}" /><Grid><TextBox x:Name="SaleCustomerSearch" behaviors:InputDialogBehavior.SuggestionKeysEnabled="True" behaviors:InputDialogBehavior.SuggestionPopupName="SaleCustomerSuggestions" behaviors:InputDialogBehavior.SuggestionPopup="{Binding ElementName=SaleCustomerSuggestions}" TabIndex="1" Style="{StaticResource Field}" Text="{Binding CustomerSearch,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="العميل" /><Popup x:Name="SaleCustomerSuggestions" behaviors:InputDialogBehavior.RegisterSuggestionPopup="True" Placement="Bottom" PlacementTarget="{Binding ElementName=SaleCustomerSearch}" IsOpen="{Binding IsCustomerSuggestionsOpen,Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True"><Border Width="520" MaxHeight="240" Style="{StaticResource DialogShell}" Padding="5"><ListBox ItemsSource="{Binding People}" SelectedValuePath="PersonId" SelectedValue="{Binding PersonId,Mode=TwoWay}" FlowDirection="RightToLeft"><ListBox.ItemTemplate><DataTemplate><Grid Margin="4,3"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding PersonName}" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{Binding Person.Phone, StringFormat={}الهاتف: {0}}" Foreground="{StaticResource BrushMuted}" Margin="12,0,0,0" /></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Border></Popup></Grid><Button Content="+ حساب جديد" Command="{Binding OpenQuickPersonCommand}" Style="{StaticResource GhostButton}" Height="32" Padding="8,2" MinWidth="130" Margin="0,2,0,0" HorizontalAlignment="Right" /></StackPanel>
              <StackPanel Grid.Column="2" Margin="4"><TextBlock Text="الصنف" Style="{StaticResource SectionLabel}" /><Grid><TextBox x:Name="SaleProductSearch" behaviors:InputDialogBehavior.SuggestionKeysEnabled="True" behaviors:InputDialogBehavior.SuggestionPopupName="SaleProductSuggestions" behaviors:InputDialogBehavior.SuggestionPopup="{Binding ElementName=SaleProductSuggestions}" TabIndex="2" Style="{StaticResource Field}" Text="{Binding ProductSearch,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="الصنف" /><Popup x:Name="SaleProductSuggestions" behaviors:InputDialogBehavior.RegisterSuggestionPopup="True" Placement="Bottom" PlacementTarget="{Binding ElementName=SaleProductSearch}" IsOpen="{Binding IsProductSuggestionsOpen,Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True"><Border Width="520" MaxHeight="240" Style="{StaticResource DialogShell}" Padding="5"><ListBox ItemsSource="{Binding Products}" SelectedValuePath="Id" SelectedValue="{Binding ProductId,Mode=TwoWay}" FlowDirection="RightToLeft"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,3"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Foreground="{StaticResource BrushMuted}" FontSize="11" Text="{Binding SmallUnit, StringFormat={}الوحدة: {0}}" /><TextBlock Foreground="{StaticResource BrushMuted}" FontSize="11" Text="{Binding StockSmallUnits, StringFormat={}الرصيد: {0}}" /><TextBlock Foreground="{StaticResource BrushMuted}" FontSize="11" Text="{Binding SalePrice, StringFormat={}سعر البيع: {0}}" /><TextBlock Foreground="{StaticResource BrushMuted}" FontSize="11" Text="{Binding PurchasePrice, StringFormat={}شراء مرجعي: {0}}" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Border></Popup></Grid><Button Content="+ صنف جديد" Command="{Binding OpenQuickProductCommand}" Style="{StaticResource GhostButton}" Height="32" Padding="8,2" MinWidth="130" Margin="0,2,0,0" HorizontalAlignment="Right" /></StackPanel>
              <StackPanel Grid.Column="3" Margin="4"><TextBlock Text="الكمية *" Style="{StaticResource SectionLabel}" /><TextBox TabIndex="3" Style="{StaticResource NumericField}" Text="{Binding QuantityText,UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" TextAlignment="Right" /></StackPanel>
              <StackPanel Grid.Column="4" Margin="4"><TextBlock Text="{DynamicResource ColUnit}" Style="{StaticResource SectionLabel}" /><ComboBox ItemsSource="{Binding QuantityUnits}" SelectedItem="{Binding SelectedQuantityUnit,Mode=TwoWay}" TabIndex="4" AutomationProperties.Name="وحدة الكمية" FlowDirection="LeftToRight" /></StackPanel>
            </Grid>
            <Grid Grid.Row="2" Margin="0,0,0,12">
              <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
              <StackPanel Margin="4"><TextBlock Text="السعر *" Style="{StaticResource SectionLabel}" /><TextBox TabIndex="5" Style="{StaticResource NumericField}" Text="{Binding PriceText,UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" TextAlignment="Right" /></StackPanel>
              <StackPanel Grid.Column="1" Margin="4"><TextBlock Text="{DynamicResource LblPaid}" Style="{StaticResource SectionLabel}" /><TextBox TabIndex="6" Style="{StaticResource NumericField}" Text="{Binding PaidText,UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
              <StackPanel Grid.Column="2" Margin="4"><TextBlock Text="{DynamicResource LblDiscount}" Style="{StaticResource SectionLabel}" /><TextBox TabIndex="7" Style="{StaticResource NumericField}" Text="{Binding InvoiceDiscountText,UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" TextAlignment="Right" /></StackPanel>
              <StackPanel Grid.Column="3" Margin="4"><TextBlock Text="الضريبة %" Style="{StaticResource SectionLabel}" /><TextBox TabIndex="8" Style="{StaticResource NumericField}" Text="{Binding TaxPercentText,UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" TextAlignment="Right" /></StackPanel>
              <StackPanel Grid.Column="4" Margin="4"><TextBlock Text="البيان" Style="{StaticResource SectionLabel}" /><TextBox TabIndex="7" Style="{StaticResource Field}" Text="{Binding Note,UpdateSourceTrigger=PropertyChanged}" FlowDirection="RightToLeft" TextAlignment="Right" /></StackPanel>
            </Grid>
            <StackPanel Grid.Row="3" Margin="4,0,4,8"><Button Content="إضافة الصنف إلى الفاتورة" Command="{Binding AddLineCommand}" Style="{StaticResource PrimaryButton}" Height="36" AutomationProperties.AutomationId="Btn_AddInvoiceLine" HorizontalAlignment="Right" /><Border Background="#0B162C" BorderBrush="{StaticResource BrushLine}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,6,0,0" Visibility="{Binding IsCartEmpty,Converter={StaticResource BoolToVisibility}}"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="🛒" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center" /><TextBlock Text="لا توجد أصناف في الفاتورة — امسح الباركود أو ابحث عن صنف لإضافته" Style="{StaticResource CaptionText}" VerticalAlignment="Center" TextWrapping="Wrap" /></StackPanel></Border><DataGrid ItemsSource="{Binding Lines}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Height="118" Margin="0,6,0,0" FlowDirection="RightToLeft" HeadersVisibility="Column"><DataGrid.InputBindings><KeyBinding Key="Delete" Command="{Binding DataContext.RemoveLineCommand,RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding SelectedItem,RelativeSource={RelativeSource AncestorType=DataGrid}}" /></DataGrid.InputBindings><DataGrid.Columns><DataGridTextColumn Header="الصنف" Binding="{Binding ProductName}" Width="2*" /><DataGridTextColumn Header="{DynamicResource ColQty}" Binding="{Binding Quantity, StringFormat={}{0:N2}}" Width="*" /><DataGridTextColumn Header="{DynamicResource ColUnit}" Binding="{Binding Unit}" Width="*" /><DataGridTextColumn Header="السعر" Binding="{Binding UnitPrice, StringFormat={}{0:N2}}" Width="*" /><DataGridTextColumn Header="الإجمالي" Binding="{Binding LineTotal, StringFormat={}{0:N2}}" Width="*" /><DataGridTemplateColumn Header="حذف" Width="60"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="×" Command="{Binding DataContext.RemoveLineCommand,RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource GhostButton}" Padding="5,0" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></StackPanel>
            <StackPanel Grid.Row="4" Margin="4,0,4,12">
              <TextBlock Text="طريقة السداد" Style="{StaticResource SectionLabel}" />
              <UniformGrid Columns="3" Margin="0,2,0,0">
                <RadioButton Content="نقدي" GroupName="SalePayment" Style="{StaticResource SegmentedChoice}" IsChecked="{Binding IsCashSelected}" Command="{Binding SelectCashCommand}" />
                <RadioButton Content="آجل — له" GroupName="SalePayment" Style="{StaticResource SegmentedChoice}" IsChecked="{Binding IsCreditSelected}" Command="{Binding SelectCreditCommand}" />
                <RadioButton Content="جزئي — المتبقي له" GroupName="SalePayment" Style="{StaticResource SegmentedChoice}" IsChecked="{Binding IsPartialSelected}" Command="{Binding SelectPartialCommand}" />
              </UniformGrid>
            </StackPanel>
            <Border Grid.Row="5" Style="{StaticResource Card}" Padding="12" Margin="4,0,4,10">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="إجمالي الأصناف" Style="{StaticResource CaptionText}" /><TextBlock Text="{Binding LinesTotal,Converter={StaticResource PrivacyMoneyConverter}}" Style="{StaticResource MetricText}" /></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource LblDiscount}" Style="{StaticResource CaptionText}" /><TextBlock Text="{Binding DiscountAmountDisplay,Converter={StaticResource PrivacyMoneyConverter}}" Style="{StaticResource MetricText}" /></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource LblTax}" Style="{StaticResource CaptionText}" /><TextBlock Text="{Binding TaxAmountDisplay,Converter={StaticResource PrivacyMoneyConverter}}" Style="{StaticResource MetricText}" /></StackPanel>
                <StackPanel Grid.Column="3"><TextBlock Text="الصافي" Style="{StaticResource CaptionText}" /><TextBlock Text="{Binding Total,Converter={StaticResource PrivacyMoneyConverter}}" Style="{StaticResource MetricText}" /></StackPanel>
                <StackPanel Grid.Column="4"><TextBlock Text="{DynamicResource LblPaid}" Style="{StaticResource CaptionText}" /><TextBlock Text="{Binding PaidText}" Style="{StaticResource MetricText}" /></StackPanel>
                <StackPanel Grid.Column="5"><TextBlock Text="{Binding BalanceLabel}" Style="{StaticResource CaptionText}" /><TextBlock Text="{Binding Remaining,Converter={StaticResource PrivacyMoneyConverter}}" Style="{StaticResource MetricText}" Foreground="{StaticResource BrushWarning}" /></StackPanel><StackPanel Grid.Column="6"><TextBlock Text="رصيد العميل الحالي" Style="{StaticResource CaptionText}" /><TextBlock Text="{Binding CurrentCustomerBalance,Converter={StaticResource PrivacyMoneyConverter}}" Style="{StaticResource MetricText}" /></StackPanel><StackPanel Grid.Column="7"><TextBlock Text="الرصيد المتوقع بعد الترحيل" Style="{StaticResource CaptionText}" /><TextBlock Text="{Binding ProjectedCustomerBalance,Converter={StaticResource PrivacyMoneyConverter}}" Style="{StaticResource MetricText}" Foreground="{StaticResource BrushAccent2}" /></StackPanel>
              </Grid>
            </Border>
            <Grid Grid.Row="6" Margin="4,0,4,0">
              <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}" Foreground="{StaticResource BrushNegative}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </Grid>
            <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Left" Margin="4,14,4,0">
              <Button Content="ترحيل وحفظ / طباعة (F5)" Command="{Binding SaveAndPrintCommand}" Style="{StaticResource PrimaryButton}" Width="170" Height="36" />
              <Button Content="حفظ فقط (Ctrl+S)" Command="{Binding SaveCommand}" Style="{StaticResource GhostButton}" Width="145" Height="36" Margin="8,0,0,0" />
              <Button Content="معاينة آخر إيصال" Command="{Binding PrintLastInvoiceCommand}" Style="{StaticResource GhostButton}" Width="145" Height="36" Margin="8,0,0,0" />
              <Button Content="طباعة مباشرة" Command="{Binding PrintDirectlyCommand}" Style="{StaticResource GhostButton}" Width="125" Height="36" Margin="8,0,0,0" />
              <Button Content="إرسال لواتساب" Command="{Binding SendWhatsAppCommand}" Style="{StaticResource GhostButton}" Width="135" Height="36" Margin="8,0,0,0" />
              <Button Content="تعليق (F6)" Command="{Binding HoldInvoiceCommand}" Style="{StaticResource GhostButton}" Width="110" Height="36" Margin="8,0,0,0" />
              <Button Content="استئناف معلقة" Command="{Binding ResumeHeldInvoiceCommand}" Style="{StaticResource GhostButton}" Width="130" Height="36" Margin="8,0,0,0" />
              <Button Content="تفريغ (Esc)" Command="{Binding ClearInvoiceCommand}" Style="{StaticResource GhostButton}" Width="110" Height="36" Margin="8,0,0,0" />
              <Button Content="إلغاء" Command="{Binding CloseDialogCommand}" Style="{StaticResource GhostButton}" Width="90" Height="36" Margin="8,0,0,0" />
            </StackPanel>
          </Grid></ScrollViewer></Border>
      </Grid>
      <Grid Style="{StaticResource DialogOverlay}" Visibility="{Binding IsQuickPersonDialogOpen,Converter={StaticResource BoolToVisibility}}"><Border Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource DialogShell}" Padding="22"><StackPanel behaviors:InputDialogBehavior.IsEnabled="True"><TextBlock Text="إنشاء حساب وربطه بالفاتورة" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" /><TextBlock Text="الاسم" Style="{StaticResource SectionLabel}" /><TextBox Style="{StaticResource Field}" Text="{Binding QuickPersonName,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" FlowDirection="LeftToRight" TextAlignment="Right" /><TextBlock Text="الهاتف (اختياري)" Style="{StaticResource SectionLabel}" /><TextBox Style="{StaticResource Field}" Text="{Binding QuickPersonPhone}" FlowDirection="LeftToRight" Margin="0,0,0,8" TextAlignment="Right" /><TextBlock Text="ملاحظة الحساب (اختياري)" Style="{StaticResource SectionLabel}" /><TextBox Style="{StaticResource Field}" Text="{Binding QuickPersonNote}" Margin="0,0,0,12" FlowDirection="LeftToRight" TextAlignment="Right" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Left"><Button Content="إنشاء واختيار الحساب" Command="{Binding SaveQuickPersonCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" /><Button Content="إلغاء" Command="{Binding CloseQuickPersonCommand}" Style="{StaticResource GhostButton}" /></StackPanel></StackPanel></Border></Grid>
      <Grid Style="{StaticResource DialogOverlay}" Visibility="{Binding IsQuickProductDialogOpen,Converter={StaticResource BoolToVisibility}}"><Border Width="520" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource DialogShell}" Padding="22"><StackPanel behaviors:InputDialogBehavior.IsEnabled="True"><TextBlock Text="إنشاء صنف وربطه بالفاتورة" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" /><TextBlock Text="{DynamicResource ColProductName}" Style="{StaticResource SectionLabel}" /><TextBox Style="{StaticResource Field}" Text="{Binding QuickProductName,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" FlowDirection="LeftToRight" TextAlignment="Right" /><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel Margin="0,0,4,8"><TextBlock Text="الوحدة الصغرى" Style="{StaticResource SectionLabel}" /><TextBox Style="{StaticResource Field}" Text="{Binding QuickProductSmallUnit}" /></StackPanel><StackPanel Grid.Column="1" Margin="4,0,0,8"><TextBlock Text="الوحدة الكبرى" Style="{StaticResource SectionLabel}" /><TextBox Style="{StaticResource Field}" Text="{Binding QuickProductLargeUnit}" /></StackPanel></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel Margin="0,0,4,8"><TextBlock Text="معامل التحويل" Style="{StaticResource SectionLabel}" /><TextBox Style="{StaticResource NumericField}" Text="{Binding QuickProductConversion}" /></StackPanel><StackPanel Grid.Column="1" Margin="4,0,0,8"><TextBlock Text="سعر الشراء المرجعي للوحدة الصغرى (اختياري)" Style="{StaticResource SectionLabel}" /><TextBox Style="{StaticResource NumericField}" Text="{Binding QuickProductPurchasePrice}" FlowDirection="LeftToRight" TextAlignment="Right" /></StackPanel></Grid><TextBlock Text="سعر البيع الافتراضي (اختياري)" Style="{StaticResource SectionLabel}" /><TextBox Style="{StaticResource NumericField}" Text="{Binding QuickProductSalePrice}" Margin="0,0,0,12" FlowDirection="LeftToRight" TextAlignment="Right" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Left"><Button Content="إنشاء واختيار الصنف" Command="{Binding SaveQuickProductCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" /><Button Content="إلغاء" Command="{Binding CloseQuickProductCommand}" Style="{StaticResource GhostButton}" /></StackPanel></StackPanel></Border></Grid>
    </Grid>
  </DataTemplate></ResourceDictionary>